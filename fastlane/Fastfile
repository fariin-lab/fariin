default_platform(:ios)

PROFILE_NAME = "Kulan Native AppStore"
BUNDLE_ID = "com.kulan.messenger.native"

platform :ios do
  desc "Build a signed Release and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )

    # Create/download an App Store provisioning profile for the native bundle,
    # reusing the distribution certificate already imported into the keychain.
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      provisioning_name: PROFILE_NAME,
      force: true
    )

    update_code_signing_settings(
      path: "Kulan.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV["ASC_TEAM_ID"],
      targets: ["Kulan"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: BUNDLE_ID,
      profile_name: PROFILE_NAME
    )

    build_app(
      project: "Kulan.xcodeproj",
      scheme: "Kulan",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV['BUILD_NUMBER']} -skipPackagePluginValidation -skipMacroValidation",
      # ⛔ THE EXPORT IS THE STEP THAT HANGS, NOT THE BUILD — run 34391087503, 2026-09-09.
      # "Archive Succeeded" at 19:02:15, `-exportArchive` started at 19:02:16, and the log has NOT
      # ONE LINE after it until the job's own 60 minute limit killed it at 19:47. The app had
      # compiled and linked in sixteen minutes, which is normal for this project.
      #
      # ⚠️ THAT RUN'S NETWORK TO APPLE WAS ALREADY SICK. Swift package resolution failed on attempts
      # one and two of the same job ("Could not resolve package dependencies") and only landed on
      # the third. So the export almost certainly stalled on a network call of its own rather than
      # on anything in our code, and a plain re-run may simply work.
      #
      # These two options remove the export's reasons to talk to anybody:
      #   • `uploadSymbols: false` — the archive step already made the dSYM, and letting export ship
      #     symbols to Apple is a large upload inside a step that gives no progress output. The
      #     symbols still go up with the build itself.
      #   • `compileBitcode: false` — bitcode has been dead since Xcode 14 and asking for it can
      #     still send export down a slower path.
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { BUNDLE_ID => PROFILE_NAME },
        uploadSymbols: false,
        compileBitcode: false
      }
    )

    upload_to_testflight(
      api_key: api_key,
      changelog: ENV["TF_CHANGELOG"] || "Bug fixes and improvements.",
      # Pass the app's numeric App Store Connect id so pilot does NOT call the `list-apps`
      # endpoint to resolve it. That lookup is what returned 500s during an Apple API blip and
      # failed the job even though altool had already delivered the binary. With apple_id given,
      # there's no app-resolution call to fail on.
      apple_id: "6782635793",
      skip_waiting_for_build_processing: true
    )
  end
end
