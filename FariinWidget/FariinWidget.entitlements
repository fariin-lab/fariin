<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App ID com.kulan.messenger.native.widget must have this group ticked in the developer
	     portal first, or its profile comes back without it and signing fails. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.kulan.messenger.native</string>
	</array>
</dict>
</plist>
