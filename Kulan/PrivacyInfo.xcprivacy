<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PRIVACY MANIFEST. Apple has required one since 1 May 2024 for any app that touches a
  "required reason" API, and an upload without it comes back as ITMS-91053 (Missing API
  declaration) — a warning that has been turning into a rejection. This app had none.

  ⚠️ EVERY ENTRY BELOW IS MEASURED AGAINST THE SOURCE, not copied from a template. If a
  declaration here stops matching what the code does, it is worse than missing: it is a
  false statement to Apple and to the person installing the app.

  WHAT WE DO NOT DO, and each of these is why a key is absent rather than forgotten:
    · No tracking of any kind. NSPrivacyTracking is false and there are no tracking domains,
      which is honest: the app ships FirebaseFirestore, Auth, Storage, Messaging and
      Functions, and NEITHER Analytics NOR Crashlytics. Nothing here follows anybody across
      other companies' apps or sites.
    · No contacts are collected. There is no NSContactsUsageDescription in the app at all —
      people are found by typing an exact username, never by uploading an address book.
    · No advertising identifier, no third-party ad SDK, no attribution SDK.

  ON THE MEDIA AND MESSAGES BELOW: chat media is end-to-end encrypted and the server holds
  only ciphertext, but Apple's question is whether data is COLLECTED (transmitted off the
  device), not whether we can read it. It is, so it is declared. Answering otherwise would be
  the kind of clever reading that gets an app pulled.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>

    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <!-- Account identity. Sign-in is Apple, Google or email; the profile carries a name. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeEmailAddress</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeName</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- The account id every document is keyed by, and the username people are found with. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeUserID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Pictures and clips sent in chats or posted as stories. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePhotosorVideos</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- Messages, captions, voice notes. End-to-end encrypted; still transmitted. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- ONLY when somebody chooses to share a place in a chat or tag one on a story.
             Never in the background, never for anything else. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePreciseLocation</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <!-- The per-install id behind Settings > Devices, and the push tokens a notification
             is delivered to. -->
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>

    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- UserDefaults, in 46 files: the appearance setting, the archive switch, the
             per-device registration marker, seen-story watermarks. All this app's own. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
        <!-- File timestamps, in DiskImageCache/AudioCache/VideoCache: last-access dates on
             cached media inside our OWN container, so the 250 MB budget can evict the least
             recently seen. Never a file belonging to anybody else. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
        <!-- CACurrentMediaTime, for elapsed time between events in the app (the story row's
             long-press quiet window, camera timing). Declared because it reads the same clock
             mach_absolute_time does, and an over-declaration costs nothing while a missing one
             costs an upload. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
