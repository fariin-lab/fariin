rules_version = '2';

// Kulan Firestore security rules.
// Only signed-in users; you can only read/write conversations you belong to.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── ANONYMOUS SIGN-IN IS CLOSED, EXCEPT FOR THE SEEDED TEST ACCOUNTS ──
    //
    // The Anonymous provider is still ENABLED in Firebase Auth, which means anybody can mint a
    // session straight against the REST API (`accounts:signUp?key=<API_KEY>`) without ever touching
    // the app, and then reach whatever these rules let a signed-in user reach. The app itself stopped
    // creating anonymous sessions long ago; the provider stayed on for one reason only, and this is
    // it: the seeded story accounts ARE anonymous accounts, so switching the provider off would lock
    // them out and empty the stories row.
    //
    // Measured before writing this rather than assumed (2026-08-06): 504 Auth accounts, 494 of them
    // anonymous, and only SIX of those have a profile — the four Test story accounts and DemoA/DemoB.
    // The other 488 are empty shells. No real person is riding an anonymous session, so denying the
    // provider costs nothing and closes the surface for every one of them plus any new one.
    //
    // This is the rules half. The console half (turning the provider off) is still worth doing, and
    // it needs the seeded accounts retired first. Until then this holds the door.
    function isAnonymous() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    // The seeded accounts, by uid, and nothing else. Named in comments so the next person can delete
    // the right ones: they are what `firebase auth:export` shows as anonymous WITH a profile.
    function isSeededTestAccount() {
      return request.auth.uid in [
        'TuAVsimc3KMU7rWsXwASRCzPjwl2',   // Test Amina
        'utU5NHXqRiUDCPMAP5sHyotp29C3',   // Test Omar
        'XV2jI60yVTbMJPPi5QLBs5RdpYW2',   // Test Ali
        'fgbSdG4hooQeSi6ILjPf8QX53Eg2',   // Test Zahra
        'CjBtLXJMRtfkuIB5eYWqCcvhGyn1',   // DemoB
        'fB55R4wHmThmcMFEYAutJImyDaO2'    // DemoA
      ];
    }
    // ⛔ TWO-STEP IS ENFORCED HERE, INSIDE `signedIn()`, AND THAT IS THE WHOLE FEATURE — owner,
    // 2026-09-16: "make sure the backend logic, security, authentication … are properly implemented".
    //
    // ⚠️ A PASSWORD PROMPT THE APP DRAWS IS A CURTAIN, NOT A LOCK. A device that finished the
    // ordinary Firebase sign-in already holds a token; anybody holding that token can talk to
    // Firestore with a client we did not write, and a screen in our app stops none of it. So the
    // additional password has to be a fact about the TOKEN, and the only place a token can be
    // refused is here.
    //
    // `setAdditionalPassword` mints the claim `twoStep: { required: true, ok: false }` and revokes
    // every refresh token, so each device comes back with a token that this function refuses;
    // `verifyAdditionalPassword` re-mints it as `ok: true`. Turning the feature off deletes the
    // claim entirely.
    //
    // ⚠️ ABSENT MEANS ALLOWED, DELIBERATELY. Every account that has never touched two-step carries
    // no claim at all, so `required` defaults false and nothing changes for them — which is what
    // makes this safe to deploy to a live app. Only a token that says it is required, and does not
    // say it passed, is turned away.
    // 2026-09-24 decision D1: PER SIGN-IN. `ok` alone was a fact about the account, so once any
    // device passed, every later sign-in was let in too. Now the claim lists the `auth_time` of each
    // session that entered the password (`authTimes`) and this token's own `auth_time` must be on it.
    // A refresh keeps `auth_time`; a fresh sign-in gets a new one and is refused until it answers.
    // `legacyAt` (or `at` on a claim with no list) keeps sessions let in before this change working
    // until their next sign-in. Mirrored by `twoStepSessionPassed` in functions-account.
    function twoStepSatisfied() {
      let t = request.auth.token.get('twoStep', {});
      let at = request.auth.token.get('auth_time', 0);
      return !t.get('required', false)
             || (t.get('ok', false) == true
                 && (at in t.get('authTimes', [])
                     || (!('authTimes' in t) && at * 1000 <= t.get('at', 0))
                     || at * 1000 <= t.get('legacyAt', 0)));
    }

    function signedIn() {
      return request.auth != null && (!isAnonymous() || isSeededTestAccount()) && twoStepSatisfied();
    }

    // ── OFFICIAL CHANNEL PERMISSIONS ──
    // Declared up here, above the first block that uses them (the per-person announcement copies
    // under /users/{uid}), so nothing depends on how the compiler orders declarations.
    //
    // Permission is a DOCUMENT, not a Cloud Function. `admins/{uid}` is the whole system and these
    // rules are the server-side check. See the /announcements block at the bottom for why the
    // official chat needs no account behind it.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }
    function adminIsOwner() {
      return isAdmin() && adminData().get('role', '') == 'owner';
    }
    // The owner is never limited. Everybody else holds exactly what they were given - an empty list
    // is a real state (an admin stood down but not removed), NOT a legacy "has everything". The group
    // admin model made that mistake and has had to carry it ever since.
    function adminCan(p) {
      return isAdmin() && (adminData().get('role', '') == 'owner' || p in adminData().get('perms', []));
    }
    // 2026-09-24 audit: the checks every announcement write shares, wherever its record lives.
    // Before, only /announcements applied them; a send to CHOSEN PEOPLE (announcementLog + the
    // per-person copies under users/{uid}/announcements) was gated on `targetChosen` alone, so that
    // one permission also let an admin send a security alert, schedule, edit, and skip every length
    // cap. And `schedule` was checked only in the app. Same caps as before, now in one place.
    function announcementWellFormed() {
      return request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 4000
        && request.resource.data.get('buttons', []).size() <= 3;
    }
    // Security alerts need `security`; a future `publishAt` needs `schedule`. The app calls
    // anything more than 60 s out "scheduled" (`Draft.isScheduled`); the rule allows 5 minutes so a
    // phone clock a little fast is not refused for a send-now.
    function announcementKindAndTimeAllowed() {
      return (request.resource.data.get('kind', '') != 'security' || adminCan('security'))
        && (request.resource.data.get('publishAt', request.time) <= request.time + duration.value(5, 'm')
            || adminCan('schedule'));
    }
    // 2026-09-24 decision D-admin-resurrect: what an EDIT of any announcement record (broadcast,
    // announcementLog, a person's copy) may not do. Replaces `announcementKindAndTimeAllowed()` on
    // the edit branches. (1) Touch a withdrawn one, or withdraw through the edit branch: an edit
    // carrying `deleted: false` used to undo a withdrawal. (2) Change the audience type. (3) Add or
    // strip the Security kind without `security`; KEEPING it is allowed, so an admin without that
    // permission can still fix a typo in one.
    function announcementEditAllowed() {
      return resource.data.get('deleted', false) != true
        && request.resource.data.get('deleted', false) != true
        && request.resource.data.get('audience', {}).get('scope', '')
             == resource.data.get('audience', {}).get('scope', '')
        && ((request.resource.data.get('kind', '') == 'security')
              == (resource.data.get('kind', '') == 'security')
            || adminCan('security'))
        && (request.resource.data.get('publishAt', request.time) <= request.time + duration.value(5, 'm')
            || adminCan('schedule'));
    }

    // Is the CALLER banned? Costs one document read, so it is used only where the thing being
    // created is public and permanent (a story), never on the message path where it would be a read
    // per message sent. A banned account can still write into its own end-to-end encrypted chats,
    // and that is a deliberate limit of this approach: the fix for that is disabling the account in
    // Firebase Auth, which needs a Cloud Function and is not built yet.
    function isBanned() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == true;
    }

    // ⛔ THE LIMITS ARE A DOCUMENT NOW, NOT A NUMBER IN THIS FILE (owner, 2026-08-21).
    //
    // Read from the reference app, which keeps every ceiling it enforces in one server-delivered
    // blob of named values rather than in the client or in a rule. Their client fetches it at
    // startup and again whenever the server says it changed, and their own documentation states the
    // rule for a key that is not there: "a default value must be used". That is the whole design,
    // and it is why they can widen a limit for everybody on a Tuesday without anybody installing
    // anything.
    //
    // Ours is `config/limits`, one document, owner-writable and readable by every signed-in phone.
    // The app listens to it (see AppLimits.swift) and this file reads it here, so ONE edit in the
    // console moves both halves at once. Nothing has to be built and nothing has to be shipped.
    //
    // ⚠️ EVERY CALLER PASSES ITS OWN FALLBACK AND THAT FALLBACK IS THE REAL LIMIT until the
    // document exists. A missing document, a missing key, or a key somebody typed as text instead
    // of a number all land on it — the last one matters, because a hand-edited console field is a
    // string by default, and `count < 'fifty'` does not evaluate to false, it ERRORS, which denies
    // the write and would look like an outage rather than a typo.
    //
    // ⚠️ THE FALLBACKS HERE AND THE ONES IN AppLimits.swift ARE THE SAME NUMBERS AND MUST STAY
    // THAT WAY. A rule cannot read Swift. If they drift, the app refuses at a different point than
    // the database does, which is the one failure this arrangement can produce.
    function limitsExist() {
      return exists(/databases/$(database)/documents/config/limits);
    }
    function limitsData() {
      return get(/databases/$(database)/documents/config/limits).data;
    }
    function appLimit(key, fallback) {
      return limitsExist() && limitsData().get(key, fallback) is int
        ? limitsData().get(key, fallback)
        : fallback;
    }

    // Does the CALLER carry an active badge? Costs nothing extra wherever `isBanned()` is already
    // in the same expression — both read the same user document and rule evaluation caches it.
    //
    // ⚠️ `verification` is in `serverOnlyUserFields()` above, which is the only reason this is safe
    // to hang a raised limit on: no client can write its own badge, so no client can grant itself
    // the larger allowance. If that entry is ever removed, this becomes a self-service upgrade.
    //
    // The stored `isVerified` flag is what is read, not the status string. It is written alongside
    // `status` precisely so a rule can ask this question without parsing anything, and it is false
    // for a suspended or revoked badge — see VerificationAdmin.swift.
    function isVerifiedCaller() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && 'verification' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.verification.get('isVerified', false) == true;
    }

    // ── 2026-09-24 decisions D7 + D8: BLOCKS AND CALL PRIVACY, CHECKED BY THE SERVER ──
    //
    // The 1:1 conversation id for the caller and `u`: the two uids sorted and joined by "_", the
    // same as `ChatService.convId`.
    function pairCid(u) {
      return request.auth.uid < u ? request.auth.uid + '_' + u : u + '_' + request.auth.uid;
    }
    // 2026-09-24 decision D8: `u` has blocked the caller. Either on `u`'s account-level block list
    // (users/{u}/blocked/{caller}, which works with no chat at all) or, for a block made before that
    // list existed, on the chat the two share. GUARDED BY exists() (a get on a missing doc errors).
    // Used by /calls create ONLY. Messages and new chats never refuse a blocked sender: blocking
    // is silent there (2026-09-24 decision D8 correction).
    function isBlockedByUser(u) {
      return exists(/databases/$(database)/documents/users/$(u)/blocked/$(request.auth.uid))
        || (exists(/databases/$(database)/documents/conversations/$(pairCid(u)))
            && get(/databases/$(database)/documents/conversations/$(pairCid(u)))
                 .data.get('blockedBy', {}).get(u, false) == true);
    }
    // 2026-09-24 decision D7: the caller is `u`'s friend, by the app's one meaning of the word
    // (`PrivacyPrefs.isContact`, `CallService.decideAllowed`): an accepted 1:1, or a chat from
    // before message requests (no `startedBy`) that carries a message.
    // 1:1 audit r3 F1, 2026-10-08: only a REAL 1:1 counts: not a group, and its members are the two
    // halves of its id. The create rule now enforces both; this is the second wall for any older doc.
    function isFriendOf(u) {
      let c = /databases/$(database)/documents/conversations/$(pairCid(u));
      return exists(c)
        && get(c).data.get('type', '') != 'group'
        && get(c).data.get('users', []).hasAll([request.auth.uid, u])
        && get(c).data.get('users', []).size() == 2
        && (get(c).data.get('startedBy', '') != ''
              ? get(c).data.get('accepted', false) == true
              : get(c).data.get('lastMessage', '') != '');
    }
    // 2026-09-24 decision D7: `u`'s Calls setting lets the caller ring. Only two choices (owner,
    // 2026-09-11): Everyone, or people in my chats; the old "nobody" value reads as the latter, and
    // an ABSENT value is My Chats too, the same default `PrivacyPrefs.defaultAudience` and
    // `CallPrivacyIndex` use. A callee with no profile document reads as Everyone, the direction
    // `acceptsFromStrangers` leans.
    // 1:1 audit r3 J2, 2026-10-08: the owner's switch for the silent call block (r2 G6), read by
    // the calls create rule. `config/calls` has no match block: only the server/console writes it.
    // Absent or false = a blocked caller's create is refused (builds 840-843 need that).
    function silentCallBlocks() {
      return exists(/databases/$(database)/documents/config/calls)
        && get(/databases/$(database)/documents/config/calls).data.get('silentBlocks', false) == true;
    }
    function callsAllowedBy(u) {
      return !exists(/databases/$(database)/documents/users/$(u))
        || get(/databases/$(database)/documents/users/$(u)).data.get('privacy', {}).get('calls', 'contacts') == 'everyone'
        || isFriendOf(u);
    }

    // Profiles: any signed-in user can look up a handle to start a chat,
    // but you can only create/edit your OWN profile.
    match /users/{uid} {
      // ✅ DONE, 2026-08-10. The four query sites are handled and the directory is CLOSED.
      //
      // `findByHandle` no longer queries this collection: it reads ONE `usernames/{name}` document
      // (get-only, see that block below) to turn an exact name into a uid, then fetches that profile
      // like any other. `searchUsers` no longer prefix-searches at all — it was returning twenty
      // accounts for two typed letters, which is a directory you can walk alphabetically, and it is
      // now an exact lookup returning at most one person. The two ADMIN screens
      // (AnnouncementAdmin.searchPeople, VerificationAdmin.search) genuinely need to sweep, so they
      // are served by the `list` branch below rather than by opening this to everybody.
      //
      // The owner's standard, from WhatsApp's policy: "strangers must type your exact, full username
      // to attempt to contact you", and spammers cannot "search random words or scrape a public
      // directory". `get` is exactly that sentence expressed as a rule.
      //
      // ⚠️ RESTORING THE PREFIX SEARCH MEANS RESTORING `list` FOR EVERYONE. They are one decision,
      // not two. rules-tests/user-directory.test.js proves this.
      allow get: if signedIn();
      // Moderation is the one job that cannot work name-by-name: finding who to verify or warn means
      // sweeping. Admins are a handful of accounts held in `admins/{uid}`, which only the owner can
      // write, so this is a named, revocable exception rather than a hole.
      allow list: if isAdmin();

      // FIELDS THE OWNER OF THE DOCUMENT MAY NOT WRITE. Only the server (the claimUsername
      // transaction, which runs with admin rights and bypasses these rules) or a moderator sets
      // these.
      //
      // The ban half was a REAL HOLE and it was mine, introduced the same day the ban was: rules are
      // cumulative, an OR, not a chain. The moderator rule below GRANTS a moderator the right to
      // write these fields; it takes nothing away from the rule above it. So the plain
      // "you may write your own document" rule still matched, and a banned account could simply set
      // `banned: false` on itself. The ban lasted exactly as long as the banned person left it
      // alone. Caught by Gemini reading these rules, not by me writing them.
      //
      // The username half was never exploited but is the same shape and worse: `claimUsername` is a
      // server transaction precisely so two people cannot take one name, and a client writing
      // `handleLower` straight onto its own document walked around the whole thing and could have
      // taken any name already in use. The client has never written these fields — every one comes
      // from the server — so refusing them costs nothing.
      // `verification` is here for the most important reason on the list: a badge somebody can give
      // themselves is not a badge. This is the whole security model — the client is never trusted to
      // write it, so spoofing it locally, editing an API response or replacing the app changes
      // nothing that anybody else can see. Only the rule below, gated on an admin capability, may
      // touch it.
      // `usernameChecks` is the throttle that stops somebody walking the namespace to learn which
      // handles exist, and until 2026-08-09 THE PERSON BEING THROTTLED COULD RESET IT.
      //
      // `checkUsername` allows 40 checks a minute and keeps the tally at `users/{uid}.usernameChecks`
      // — on the caller's own document. The field was not on this list, so the rules let its owner
      // write it: set the count back to zero between calls and the limit never trips. A lock with the
      // key taped to it. The comment in functions/index.js has described this hole for days as the
      // example of what NOT to do; this is the fix it was asking for.
      //
      // Every other throttle in the project is already safe for a different reason: `rateLimits`,
      // `alertSends`, `loginCodes` and `usernames` live in collections with NO match block at all,
      // and Firestore is default-deny, so no client can reach them. This counter was the only one
      // parked somewhere its subject could edit.
      //
      // Costs nothing to lock: the app never writes this field (checked across the whole iOS source),
      // and the function writes it with the admin SDK, which does not go through these rules.
      //
      // `fcmTokens`/`voipTokens`/`pushTokens` are NOT in this list on purpose: the current app still
      // strips its own token off them. 2026-09-24 audit (stage 4): they are guarded instead by
      // pushTokensNotAdded() below, which lets them shrink and never grow.
      function serverOnlyUserFields() {
        // glowerCount / glowingCount: the Glow feature's public numbers, maintained by the
        // onGlowWrite function off the /glows collection. Here so no phone can inflate its own —
        // the same reason `verification` is here, and the profile card renders whatever these say.
        return ['banned', 'bannedAt', 'bannedBy', 'banReason',
                'handle', 'handleLower', 'usernameHistory',
                'verification', 'usernameChecks',
                'glowerCount', 'glowingCount',
                // owner 2026-10-18: the admin panel's per-person Message Requests / Chat Key
                // override (adminApi msgPolicyUserSet). A phone that could write it could switch
                // its own requests off or another person's key requirement, so only the server does.
                'msgPolicy'];
      }

      // ⛔ THE PROFILE'S LINKS ARE CAPPED HERE, NOT ONLY IN THE APP — owner's Links feature,
      // 2026-09-11. Two per account is a rule of the ACCOUNT, and a rule only the client enforces
      // is a rule anybody with a modified client does not have. The profile draws whatever this
      // field holds, so an uncapped list is a profile page somebody else decides the height of.
      //
      // ⚠️ THE COUNT IS ALL THIS CAN CHECK. Rules have no loop, so the shape of each entry (a title
      // and a url, both short) cannot be validated here — the parser on the way IN drops anything
      // missing either and trims both, which is where that half lives.
      function linksOk() {
        return !('links' in request.resource.data)
            || (request.resource.data.links is list
                && request.resource.data.links.size() <= 2);
      }

      // 2026-09-24 audit: NAME AND BIO HAVE A CEILING HERE TOO. The editor stops the name at 40 + 40
      // (first + last, SettingsView) and the bio at Limits.bioChars = 140, but that is client code;
      // a modified client could write any size onto a document every chat partner reads. The swift
      // editor counts visible characters and a rule counts code points, and one emoji can be several
      // code points, so the ceilings are four times the editor's to never refuse a real edit.
      // Checked only when the field is written, so an older over-long value does not block other
      // edits to the same document.
      function profileTextOk(fields) {
        return (!('name' in fields) || (request.resource.data.name is string
                                         && request.resource.data.name.size() <= 324))
            && (!('about' in fields) || (request.resource.data.about is string
                                          && request.resource.data.about.size() <= 560));
      }

      // 2026-09-24 audit: STAGE 4 OF THE PUSH-TOKEN MOVE. Push tokens may no longer be ADDED to this
      // document, which every signed-in account can read. The app has written them only to
      // users/{uid}/push/tokens since build 511, and the servers now read only there. A write may
      // still SHRINK these fields (or empty them), because the current app strips its own token off
      // them at every save and sign-out, and refusing that would sink its whole sign-out batch.
      function tokenShrinkOnly(f) {
        return !(f in request.resource.data)
            || (request.resource.data[f] is list
                && (request.resource.data[f].size() == 0
                    || (f in resource.data && resource.data[f] is list
                        && request.resource.data[f].toSet()
                             .difference(resource.data[f].toSet()).size() == 0)));
      }
      function pushTokensNotAdded() {
        return tokenShrinkOnly('fcmTokens') && tokenShrinkOnly('voipTokens')
            && tokenShrinkOnly('pushTokens');
      }

      // 2026-09-24 decision D6: the deletion date is set by `scheduleAccountDeletion` (server now +
      // 30 days). The phone may only REMOVE it (Restore), never write a date from its own clock.
      allow create: if signedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(serverOnlyUserFields())
        && !request.resource.data.keys().hasAny(['fcmTokens', 'voipTokens', 'pushTokens'])
        && !('deletionScheduledFor' in request.resource.data)
        && linksOk()
        && profileTextOk(request.resource.data.keys());
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(serverOnlyUserFields())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletionScheduledFor'])
            || !('deletionScheduledFor' in request.resource.data))
        && pushTokensNotAdded()
        && linksOk()
        && profileTextOk(request.resource.data.diff(resource.data).affectedKeys());

      // ⛔ 2026-10-12: NO CLIENT SETS A BAN ANY MORE. Until today a moderator could write the four ban
      // fields straight from the browser, which never reached the admin audit log. Bans now go only
      // through the adminApi function (functions-admin), which checks the permission, requires a
      // reason and a fresh sign-in, and records the action in the hash-chained audit log. The Admin
      // SDK it uses does not pass through these rules, so nothing here needs to allow it.

      // VERIFICATION. A separate capability from `moderate` on purpose: banning somebody and marking
      // an account as genuine are different powers and should be grantable separately. `hasOnly` is
      // what stops this being a general "edit any profile" right — an admin with `verify` cannot
      // rename anyone, change a photo or touch a privacy setting, only this one map.
      //
      // Note this rule GRANTS and never revokes: rules are an OR, not a chain. That is exactly the
      // mistake that left the ban flag writable by the banned account, so the field is in
      // serverOnlyUserFields() above as well — the owner's own update rule refuses it there, and this
      // is the only path that allows it.
      // ⛔ 2026-10-13 AUDIT: NO CLIENT WRITES THE BADGE ANY MORE, ADMIN OR NOT. This used to let an
      // admin holding `verify` write `verification` straight from the app: any shape, their OWN badge,
      // and with no audit entry required, skipping everything the server path enforces (fresh sign-in,
      // Access, the hash-chained adminAudit, no self-badge, the reason list, the state machine). Badges
      // are granted, changed and removed only by adminApi `verifyApply` (admin.fariin.com), which writes
      // with the Admin SDK and is not subject to these rules. `verification` stays in
      // serverOnlyUserFields(), so nothing on this document can write it.
      // NO delete. (A copy of the message-request decline rule was pasted here by mistake; it read
      // conversation fields off a user document, so it could only ever error, and the real one lives
      // on /conversations/{cid} where it belongs. Removed 2026-08-04, no behaviour change.)

      // ONLINE / LAST SEEN. In its own document precisely so it can carry its own read rule.
      //
      // It used to live on the user document, which every signed-in account can read — it has to be,
      // so a stranger can look up a handle to start a chat. That meant "Last Seen: My Contacts" was
      // enforced only by the READING app: anybody querying Firestore directly got your last-seen time
      // whatever you had chosen. The client cannot be the thing enforcing a privacy setting, because
      // the client is the part an attacker replaces.
      //
      // "Contact" here means what it means everywhere else in the app: you two have a conversation.
      // A 1:1 conversation id is the two uids sorted and joined with an underscore, which the rule can
      // rebuild, so this needs no extra field and no list to maintain.
      //
      // 2026-09-24 audit: A BLOCK NOW ENDS IT. Before, the conversation branch was a bare
      // `exists()`, and blocking never deletes the conversation, so somebody you had blocked kept
      // seeing your last seen for as long as the chat existed. Now the branch also requires that
      // this person (`uid`) has not blocked the reader on that conversation. Still one read; `get`
      // on a missing document is guarded by the `exists()` before it. (A pending request still
      // counts as "a conversation" here, as the paragraph above defines it; that is unchanged.)
      function presencePair() {
        return /databases/$(database)/documents/conversations/$(
          request.auth.uid < uid ? request.auth.uid + '_' + uid : uid + '_' + request.auth.uid);
      }
      function presenceAudienceAllows() {
        return get(/databases/$(database)/documents/users/$(uid)).data
               .get('privacy', {}).get('lastSeen', 'everyone') == 'everyone'
          // 2026-09-24 audit: the conversation branch now applies ONLY to "My Chats" (`contacts`).
          // It used to fire for any stored value, so "No One" let every chat partner read exactly
          // what "My Chats" did. With `nobody` the owner is the only reader. (Same user document
          // as the line above, so it is still one billed read.)
          || (get(/databases/$(database)/documents/users/$(uid)).data
                .get('privacy', {}).get('lastSeen', 'everyone') == 'contacts'
              && exists(presencePair()));
      }
      match /presence/state {
        // 2026-09-26 block rebuild: A BLOCK HIDES LAST SEEN WHATEVER THE SETTING SAYS. The
        // "everyone" branch had no block check at all, and the "contacts" branch read only the
        // chat's copy of the block, so blocking someone you never chatted with hid nothing.
        // `isBlockedByUser` reads the owner's account list first, the chat's old copy second.
        allow read: if signedIn() && (
          request.auth.uid == uid
          || (!isBlockedByUser(uid) && presenceAudienceAllows())
        );
        allow write: if signedIn() && request.auth.uid == uid;
      }

      // THE PUBLIC FACE OF AN "EVERYONE" STORY, and the reason the story document itself is no
      // longer world-readable.
      //
      // A story doc carries `recipientUids`. Granting it to everybody so that strangers could watch
      // a public story handed them the author's whole contact list along with it. This mirror
      // carries the MEDIA and nothing else: no recipients, no audience, nothing about who else can
      // see it. Anyone signed in may read it — that is the point — and only the author may write it.
      //
      // Validated rather than trusted, because this is the one story surface a stranger can reach:
      // no field may appear here that is not on the list, so a future bug cannot quietly start
      // mirroring the audience into a world-readable document.
      match /publicStories/{storyId} {
        // ⛔ A PERSON THE AUTHOR BLOCKED CANNOT READ THE MIRROR, AND THE APP WAS THE ONLY THING
        // SAYING SO.
        //
        // `publicStoryGroup` checks `blockedBy` before it draws the ring — in Swift, on the reader's
        // own device. The rule said `signedIn()`, so the check was advice: a blocked person with the
        // document path, or any client that skips that branch, read the story anyway. It is the one
        // surface in this app built for reach, which makes it the one place a block has to be
        // enforced by the database.
        //
        // 2026-09-26 block rebuild: the ACCOUNT block list decides (`isBlockedByUser`), so a block
        // made with no chat hides the stories too. Before, only the chat's copy was read, and two
        // people who had never spoken had none, so blocking a stranger hid nothing here.
        // `uid` is the path, not the document, so the profile's list query still evaluates.
        allow read: if signedIn() && (
          request.auth.uid == uid
          || !isBlockedByUser(uid)
        );
        // HISTORY (superseded 2026-10-12, see below): a moderator could take the mirror down.
        //
        // `stories/{id}` already allows a moderator to delete a reported story. This document is a
        // SEPARATE copy in the author's own subcollection and its write rule named the author alone,
        // so a moderator could remove the story everywhere except the one place a stranger reads it:
        // the author's public profile. That is precisely the surface the story rules' own comment
        // calls the App Store risk — the takedown looked complete and was not.
        // ⛔ 2026-10-12: a moderator's takedown of this mirror now happens on the server: adminApi
        // storyRemove deletes it in the same transaction as the story (and onStoryDeleted does too).
        // The client-side moderator delete is gone so every takedown lands in the audit log.
        allow write: if signedIn() && request.auth.uid == uid
          && (request.method == 'delete'
              // ⚠️ `blurThumb` HAS TO BE ON THIS LIST OR NOTHING IS MIRRORED AT ALL. The list is a
              // `hasOnly`, so a field the app writes and the rule does not name fails the WHOLE
              // write, and `writePublicMirror` swallows the denial with `try?` — the story posts,
              // reaches contacts normally, and is simply absent from the author's public profile.
              // Safe to allow: it is a few hundred bytes of base64 JPEG derived from the media this
              // same document already publishes, so it discloses nothing the mirror did not.
              // ⚠️ `stickers` IS ON THIS LIST FOR THE SAME REASON `blurThumb` IS. A story posted with
              // a Link or a Location sticker carries the rectangle that sticker occupies and what it
              // opens; leave the key off a `hasOnly` and the WHOLE mirror write fails, silently, so
              // the story would simply stop appearing on its author's public profile. It discloses
              // nothing new — the sticker is already drawn into the picture this document publishes,
              // and the url is the one the author chose to show.
              // ⚠️ `captureProtected` IS ON THIS LIST FOR THE THIRD TIME FOR THE SAME REASON. It is
              // the author's "do not let this be copied" switch, and the mirror is what a stranger
              // reaching the profile actually reads — leave the key off and either the whole mirror
              // write fails silently, or (worse) the story publishes to strangers with the
              // protection stripped off it. It discloses nothing: it is a boolean about the
              // author's own wishes for the picture this document already publishes.
              || (request.resource.data.keys().hasOnly(
                    ['authorUid', 'createdAt', 'expiresAt', 'mediaUrl', 'thumbUrl',
                     'type', 'caption', 'duration', 'allowsReplies', 'blurThumb', 'stickers',
                     'captureProtected',
                     // The repost credit line. Without it here the whole mirror write is REFUSED
                     // and `try?` swallows the refusal, so a reposted public story would simply
                     // stop appearing on its author's profile — the exact failure `blurThumb` and
                     // `captureProtected` each cost once already.
                     'repostOf'])
                  && request.resource.data.authorUid == uid
                  && !isBanned()));
      }

      // ⛔ THE RATE-LIMIT COUNTER, AND ITS RULES ARE THE WHOLE OF WHY THE NUMBER MEANS ANYTHING.
      //
      // One document per limited action (`stories` today). It holds the window it is counting and
      // how many have been done inside it, and the story create rule reads it — see `storyBudget`.
      //
      // It is the OWNER'S OWN document, so the only thing standing between it and a client that
      // wants a bigger allowance is this rule. Three things are enforced and each closes one way of
      // cheating:
      //
      //   • A window may only be OPENED at `request.time`, and only once the previous one has
      //     actually expired. So the window cannot be moved forward to escape a full one.
      //   • Inside a window the count may only go UP, and only by one. So it cannot be reset,
      //     lowered, or held still while stories are posted.
      //   • Nothing else may be written. A field the rule does not name is a field the rule cannot
      //     reason about.
      //
      // Deleting is refused for the same reason a reset is: a deleted counter is an empty one, and
      // the create rule treats a missing counter as "no limit known".
      match /limits/{name} {
        // ⛔ THE WINDOW IS PER COUNTER NOW. `stories` counts an hour, to stop a runaway loop
        // inside one sitting; `storiesDaily` counts a day, because an account can also spend the
        // whole day just under the hourly ceiling and still post hundreds. One number cannot say
        // both, and a shared 1h length would have let the daily counter be reopened every hour —
        // which is not a daily limit at all.
        function windowLength() {
          // `requests` is the day's knocks on strangers (owner's spec, 2026-09-11 §25), read by
          // the message rule the way `storiesDaily` is read by the story rule.
          // 2026-09-24 fix-all: `reports` and `glows` are day counters too, read by those two rules.
          return (name == 'storiesDaily' || name == 'requests' || name == 'reports' || name == 'glows')
            ? duration.value(24, 'h') : duration.value(1, 'h');
        }
        // ⛔ `storiesActive` IS THE SERVER'S AND NO CLIENT MAY TOUCH IT. It is not a window counter
        // like the two below — it is how many of this account's stories are alive right now, kept by
        // `onStoryCreated` and `onStoryDeleted` with admin rights, and it has to go DOWN as well as
        // up. The shapes below can only ever count upward, which is right for a rate limit and
        // useless for this one, and a client that could write it could hold its own number at zero
        // and post for ever.
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && name != 'storiesActive'
          && request.resource.data.keys().hasOnly(['windowStart', 'count'])
          && request.resource.data.windowStart == request.time
          && request.resource.data.count == 1;
        allow update: if signedIn() && request.auth.uid == uid
          && name != 'storiesActive'
          && request.resource.data.keys().hasOnly(['windowStart', 'count'])
          && (
               // Same window, one more.
               (request.resource.data.windowStart == resource.data.windowStart
                && request.resource.data.count == resource.data.count + 1)
               // …or a fresh window, but only once the old one is genuinely spent.
               || (request.resource.data.windowStart == request.time
                   && request.resource.data.count == 1
                   && resource.data.windowStart < request.time - windowLength())
               // 2026-09-24 fix-all: a RETRIED window-opening write. When the first `setData` landed
               // but its answer was lost, the SDK sends it again and the database now judges it as an
               // update, which neither shape above accepts (the window is fresh, the count already 1).
               // Re-opening at a count of 1 over a count of 1 gains nothing: the count stays 1 and
               // the window only moves later, which is the stricter direction.
               || (request.resource.data.windowStart == request.time
                   && request.resource.data.count == 1
                   && resource.data.count == 1)
             );
        allow delete: if false;
      }

      // ⛔ THE INSIGHTS HISTORY IS THE SERVER'S TO WRITE AND THE OWNER'S ALONE TO READ (2026-09-30).
      // `insightsDaily/{day}` holds one account's counts for one UTC day (story views, reactions,
      // stories posted, glowers gained and lost); `insightsStories/{storyId}` is the record of one
      // story that outlives it. Both are written by the functions in `functions-insights` with
      // admin rights. A client that could write them could invent its own numbers, and anybody
      // else reading them would learn what the profile deliberately does not show: how many
      // people watch this person's stories. `insights/{doc}` is the server's own bookkeeping and
      // is closed to everyone, the owner included.
      match /insightsDaily/{day} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
      match /insightsStories/{storyId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
      match /insights/{doc} {
        allow read, write: if false;
      }

      // Story distribution lists ("My Status" + custom lists) and per-user seen state.
      // Both are private to the owner.
      match /storyLists/{listId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // Which custom list(s) one of my stories went to (2026-10-11, StoryAudienceLink). Mine alone:
      // the story itself is readable by its recipients, so the link lives here and never there.
      // The server deletes it with the story.
      match /storyAudiences/{storyId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['listIds', 'name', 'createdAt'])
          && request.resource.data.listIds is list
          && request.resource.data.listIds.size() <= 5
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 200;
      }
      match /storyContexts/{authorUid} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // Signed-in devices (Settings > Devices): one doc per phone, holding its model,
      // iOS version, app version, first/last seen and its push tokens. Private to the
      // owner in both directions - only you can see where you are signed in, and
      // deleting a doc here is how you sign that device out.
      // ⛔ A NEW SIGN-IN CANNOT SIGN OUT OLDER DEVICES — owner, 2026-10-14. "If device B can
      // immediately remove device A, the person who owns the account loses it." The reference
      // messenger's rule, from its own API docs: a session may not log out other sessions until 24
      // hours after it logged on (`FRESH_RESET_AUTHORISATION_FORBIDDEN`).
      //
      // Signing a device out IS deleting its record here, so the delete is the gate. The clock is
      // the token's `auth_time` — the moment THIS sign-in happened, signed by the auth server — and
      // `request.time` is the server's clock, so neither end is the phone's to set.
      //
      //   settled  ⇔  request.time ≥ auth_time + 24 h
      //   delete   ⇔  owner ∧ (settled ∨ record.authTime == auth_time)
      //
      // The second clause is a phone removing ITS OWN record when it signs out in its first day: the
      // record carries the `auth_time` of the sign-in that created it, which `create` proves equals
      // the token's, and which no update may change — otherwise a new sign-in could copy its own
      // value onto an older device's record and then delete it as "its own".
      //
      // `createdAt` is the server's time on create and fixed after, so the device limit (oldest five
      // stay, enforced by the server's `enforceDeviceLimit`) cannot be dodged by backdating.
      match /devices/{deviceId} {
        function sessionSettled() {
          return request.time >= timestamp.value(request.auth.token.auth_time * 1000) + duration.value(24, 'h');
        }
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.get('createdAt', null) == request.time
          && (!('authTime' in request.resource.data)
              || request.resource.data.authTime == request.auth.token.auth_time);
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && request.resource.data.get('authTime', null) == resource.data.get('authTime', null);
        allow delete: if signedIn() && request.auth.uid == uid
          && (sessionSettled() || resource.data.get('authTime', -1) == request.auth.token.auth_time);
      }

      // Written only by the server (`enforceDeviceLimit`) when it refused a new device because the
      // account was already on five; the refused phone reads it to say why it was signed out.
      match /deviceRefusals/{deviceId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      // 2026-10-13: the app's own connection log (DiagLog), sent after a "dead until relaunch"
      // episode. Write-once by the owner, small, and read only by the admin console (server side).
      match /diag/{id} {
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['text', 'build', 'ios', 'at'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 70000
          && request.resource.data.at == request.time;
        allow read, update, delete: if false;
      }

      // WHERE PUSH TOKENS ARE MOVING TO, and why they cannot stay on the profile.
      //
      // They live at users/{uid}.fcmTokens / .voipTokens today, on a document any signed-in account
      // can GET once it knows a uid — and uids are not secret, they sit in every group you share.
      // Firestore has no field-level read control, so as long as the tokens are ON that document
      // they are readable, full stop. The data has to move; no rule can save it in place.
      //
      // The attack that makes it urgent: read the victim's token, write it onto your OWN profile,
      // and `reconcilePushTokens` (which strips a token from every other account holding it) quietly
      // removes it from theirs. Their messages and CallKit rings then arrive on your phone and stop
      // arriving on theirs, with nothing anywhere explaining why.
      //
      // ⚠️ THIS BLOCK IS STAGE ONE OF FOUR AND CLOSES NOTHING BY ITSELF. The app and the server
      // deploy separately and old builds live on phones for weeks, so the moment the server reads
      // only from here, every phone still writing to the profile goes silent — no messages, no
      // ringing, no error. The order has to be: server reads here and FALLS BACK to the profile;
      // app writes here; that build reaches people; only then migrate the existing tokens and drop
      // the old fields. The hole is open until that third step.
      // ⛔ HIDE FROM — owner, 2026-09-25: people who never see my profile photo, whatever the
      // audience says. One empty document per hidden account, so storage.rules can answer with a
      // single `exists`. OWNER ONLY: who you hid is nobody else's business, and a hidden person must
      // not be able to find out (or take themselves off the list). Capped at an ID shape so it cannot
      // be used to store anything but a uid.
      match /photoHiddenFrom/{viewer} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && viewer != uid
          && viewer.matches('^[A-Za-z0-9]{10,64}$')
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at is timestamp;
      }

      match /push/{docId} {
        // 2026-09-24 audit: each token list is capped at 50. Uncapped, a modified client could grow
        // one past the 500 tokens a single multicast send accepts, and every push to the account
        // would then fail. A write that SHRINKS a list is always allowed, so an account already over
        // the cap can still sign out and prune.
        function tokenListOk(f) {
          return !(f in request.resource.data)
              || (request.resource.data[f] is list
                  && (request.resource.data[f].size() <= 50
                      || (resource != null && f in resource.data && resource.data[f] is list
                          && request.resource.data[f].size() <= resource.data[f].size())));
        }
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && tokenListOk('fcmTokens') && tokenListOk('voipTokens') && tokenListOk('pushTokens')
          // 2026-10-06 group rings: the VoIP token again, listed by builds that understand a
          // multi-person ring (the server rings only these). Same cap as the others.
          && tokenListOk('groupRingTokens')
          // audit 2026-10-07 (F10 handoff): `voipCancelTokens`, the VoIP token listed by builds that
          // understand a ring-end push. Same cap as the others.
          && tokenListOk('voipCancelTokens')
          // 1:1 audit r3 F6/J8, 2026-10-08: the VoIP token again, listed by builds that name the
          // caller themselves; the server leaves the name out of their ring push.
          && tokenListOk('voipNamelessTokens');
      }

      // Which sticker packs you have added, and the order you keep them in. A subcollection
      // rather than a field on the user doc precisely because any signed-in user can READ a
      // user doc (handle lookup) - what stickers you use is nobody else's business.
      match /stickers/{doc} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // 2026-10-04 calls: the call links I keep in my Calls list. `key` is the link's root key, so
      // this is owner only both ways: anyone who reads it can join the call.
      match /callLinks/{roomId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['key', 'name', 'createdAt', 'admin'])
          && request.resource.data.key is string && request.resource.data.key.size() <= 64
          && request.resource.data.name is string && request.resource.data.name.size() <= 64
          && request.resource.data.get('admin', false) is bool;
      }

      // 2026-09-24 decision D8: MY BLOCK LIST, one document per person I blocked, so blocking works
      // for anyone, chat or no chat. Owner only, both ways: the blocked person must never be able to
      // read that they are on it. The rules read it through `isBlockedByUser` (call create only;
      // messages and new chats stay silent, 2026-09-24 decision D8), which ignores these read rules. The document carries only
      // `at`, the server's time of the block.
      // 1:1 audit r3 F2, 2026-10-08: the server's verdict on a call ringing me, `{allowed: bool}`,
      // written by onCallCreated in the same commit as the call's `screenedAt`. On the CALLEE's
      // side so the caller cannot read it (the call doc only says "the server has looked").
      // Callee get only; no client writes, no listing.
      match /callScreens/{callId} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list, write: if false;
      }

      // 2026-10-16 GET NOTIFICATIONS for one person's stories (owner): one document per author
      // whose new stories push to me ({at, author}; `author` lets the server find it). Mine alone to read and change, so nobody can learn
      // who follows their stories; the server reads it with admin rights (onStoryCreated).
      match /storyNotify/{author} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && author != uid
          && request.resource.data.keys().hasOnly(['at', 'author'])
          && request.resource.data.author == author
          && request.resource.data.at == request.time;
      }

      // 2026-10-17 STORY VIEW RECEIPTS, PER ACCOUNT (owner). `receipts` is the switch; `offAt` is the
      // server time it was last turned off (null while on). It lives on the account so a second phone,
      // a reinstall and a restart all see the same answer. Owner only both ways; the server reads it
      // with admin rights (onStoryPrefsWritten promotes hidden views when it flips back on).
      match /private/storyPrefs {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['receipts', 'offAt'])
          && request.resource.data.receipts is bool
          && (request.resource.data.get('offAt', null) == null
              || (request.resource.data.offAt is timestamp
                  && request.resource.data.offAt <= request.time));
      }

      // 2026-10-17 A STORY I WATCHED WITH RECEIPTS OFF (owner): kept here, never on the author's
      // story, so they cannot see it. Turning receipts back on hands the live ones to the server,
      // which writes the real receipt (block and expiry checked there) and deletes this note.
      // Mine alone; nobody else can learn what I watched while hidden.
      match /hiddenStoryViews/{storyId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['storyId', 'authorUid', 'at', 'expiresAt'])
          && request.resource.data.storyId == storyId
          && request.resource.data.authorUid is string
          && request.resource.data.authorUid != uid
          && request.resource.data.at == request.time
          && request.resource.data.expiresAt is timestamp;
      }

      // 2026-10-20 (owner): groups I blocked (Block Group). Read by the server only, when someone
      // adds me back (onGroupMembersAdded); mine to write and remove.
      match /blockedGroups/{gid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time;
      }
      match /blocked/{other} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        // 2026-09-26: `at` may be EARLIER than now, never later. Moving a block that was recorded
        // on a chat (the old place) into this list has to keep its original time, or everything
        // they sent between then and now would appear. Only the owner's own hiding reads it.
        allow create, update: if signedIn() && request.auth.uid == uid
          && other != uid
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at is timestamp
          && request.resource.data.at <= request.time;
      }
      // 2026-09-26 block rebuild: MY PAST BLOCKS, one document per block that has ended
      // (`<uid>_<start ms>`). Whatever that person sent between `from` and `to` stays hidden for
      // good after the unblock, the way the reference apps never deliver what a block held back.
      // This used to live on the SHARED chat (`blockedAt`, `blockClearedAt`), where the person I
      // blocked could read it. Owner only, both ways; written once, never edited.
      match /blockHistory/{span} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['other', 'from', 'to'])
          && request.resource.data.other is string
          && request.resource.data.other != uid
          && span.matches(request.resource.data.other + '_[0-9]+')
          && request.resource.data.from is timestamp
          && request.resource.data.to is timestamp
          && request.resource.data.from <= request.resource.data.to
          && request.resource.data.to <= request.time;
      }

      // OFFICIAL CHANNEL, this person's half: muted, blocked, last read, delete-for-me. Private in
      // both directions - what you have read is nobody's business, and the read COUNTS the admin
      // screen shows come from anonymous shard counters, never from here.
      match /officialChannel/{doc} {
        // 2026-09-28, the channel's state machine (see OfficialChannelState in the app): the two
        // watermarks only move forward, and a switch changes only with a choice time at least as new
        // as the stored one. Firestore applies writes in the order they ARRIVE, so without these an
        // offline phone's queued, older write undid a newer one made on another phone. A write that
        // leaves a switch alone is not asked about it, and a build that writes no choice time still
        // passes (its time equals the stored one), so nothing that worked before is refused.
        function notBehind(f) {
          return request.resource.data.get(f, 0) >= resource.data.get(f, 0);
        }
        function notOlder(f) {
          return request.resource.data.get(f, null) == resource.data.get(f, null)
            || request.resource.data.get(f + 'At', 0) >= resource.data.get(f + 'At', 0);
        }
        allow read, create, delete: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid
          && notBehind('lastReadAt') && notBehind('clearedAt')
          && notOlder('muted') && notOlder('blocked') && notOlder('pinned') && notOlder('archived');
      }

      // Announcements sent to THIS PERSON by hand. A real copy, because a phone cannot filter itself
      // against a list of chosen people it is not allowed to see - which is the whole reason a
      // broadcast document must never carry that list.
      match /announcements/{id} {
        allow read: if signedIn() && request.auth.uid == uid;
        // 2026-09-24 audit: was `allow write: if adminCan('targetChosen')` and nothing else - no
        // length caps, no security/schedule/edit permission, and an admin holding `remove` without
        // `targetChosen` could not withdraw one. Now split by what the app actually writes
        // (AnnouncementAdmin.publish / .remove):
        //   · a new copy: send + targetChosen + the shared caps and kind/time permissions
        //   · an edit (merge onto the copy): edit + targetChosen + the same
        //   · a withdrawal: `remove` alone, and only `deleted: true` may change. A copy that never
        //     arrived (an earlier batch failed) is created as a bare tombstone, same permission.
        allow create: if adminCan('send') && adminCan('targetChosen')
          && announcementWellFormed() && announcementKindAndTimeAllowed();
        allow create: if adminCan('remove')
          && request.resource.data.keys().hasOnly(['deleted'])
          && request.resource.data.deleted == true;
        allow update: if adminCan('edit') && adminCan('targetChosen')
          && announcementWellFormed() && announcementEditAllowed();   // 2026-09-24 decision D-admin-resurrect
        allow update: if adminCan('remove')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt'])
          && request.resource.data.deleted == true;
        allow delete: if false;
      }
    }

    // ── THE NAME-TO-ACCOUNT MAP, AND THE ONLY WAY TO FIND SOMEBODY BY USERNAME ──
    //
    // `usernames/{lower}` is where uniqueness is decided (claimUsername writes it inside its
    // transaction). It had NO match block at all, which made it unreachable by every client — and
    // that was correct while the app found people by QUERYING profiles. Closing that query is what
    // makes this block necessary: something has to turn "@ayaan" into an account.
    //
    // ⚠️ GET, AND NEVER LIST. This is the whole point and the two words are not interchangeable.
    // `get` answers one question about one name you already typed in full. `list` would let somebody
    // page through every username in Fariin, which is precisely the directory just closed next door —
    // it would move the hole rather than fix it.
    //
    // What a `get` reveals: whether a name is taken, and which account holds it. Taken-ness is
    // already public through `checkUsername` (it has to be — the person choosing a name must be told
    // it is gone), and a uid is not a secret, it sits in every conversation you share. What it does
    // NOT reveal is any name you did not already know.
    //
    // ⚠️ It also bypasses `checkUsername`'s 40-a-minute throttle, so a determined script can test
    // names one read at a time. That is a real cost, accepted: it is dictionary GUESSING, which every
    // platform with usernames permits, and it is enormously harder than the alphabetical walk this
    // replaces. App Check is the proper answer to scripted clients and is still UNENFORCED.
    //
    // Writes stay closed. claimUsername runs with admin rights and does not pass through here; a
    // client writing this directly would be taking a name without the transaction that keeps two
    // people from taking the same one.
    // ── CHAT PIN — owner's spec, 2026-09-11 ──
    //
    // The hash lives in `chatPins/{uid}` and every attempt counter in `pinAttempts/{uid}`, and both
    // are the server's alone. Written and compared only by `setChatPin` / `verifyChatPin`
    // (functions-chatpin in the backend repo), which run as admin and never pass through here.
    //
    // ⛔ WRITTEN OUT AS A REFUSAL rather than left to default-deny, so nobody reading this file has
    // to know that an absent match denies. There is nothing a client may learn from these
    // documents, not even that one exists: who has a pin is private (§34), and a counter the person
    // being limited could read or reset is not a limit (the `usernameChecks` lesson).
    match /chatPins/{uid} {
      allow read, write: if false;
    }
    match /pinAttempts/{uid} {
      allow read, write: if false;
    }

    // ── ACCOUNT SECURITY — owner, 2026-09-16 (functions-account in the backend repo) ──
    //
    // The email-change code, the password-reset code and the two-step recovery code all live in
    // `accountCodes/{uid}_{purpose}`; the additional password's hash in `twoStep/{uid}`; its attempt
    // counter in `accountAttempts/{uid}_{purpose}`; and the website's one-time reset ticket in
    // `resetTickets/{ticket}`. Every one of them is the server's alone, for the reason the Chat PIN
    // records: a rule can only compare what a client hands it against a document the client can
    // read, and these hold the secret itself.
    //
    // ⛔ REFUSED EXPLICITLY, INCLUDING READ, AND THE READ HALF IS THE IMPORTANT ONE. A person who can
    // read their own `accountCodes` document can read the SALT and the HASH of a live six-digit code
    // and brute-force it offline in milliseconds — six digits is a million guesses — which would
    // turn "prove you hold that inbox" into "prove you are signed in", and the whole mechanism with
    // it. A counter the limited party can read or clear is not a limit, same as `usernameChecks`.
    match /accountCodes/{doc} {
      allow read, write: if false;
    }
    match /accountAttempts/{doc} {
      allow read, write: if false;
    }
    match /twoStep/{uid} {
      allow read, write: if false;
    }
    match /resetTickets/{ticket} {
      allow read, write: if false;
    }

    // ── A DECLINED REQUEST IS REMEMBERED — owner's spec, 2026-09-11 §10 ──
    //
    // "If the recipient declines the request, do not immediately allow the sender to create
    // unlimited new requests." The recipient writes one document here as they delete the request,
    // and the conversation `create` rule reads it back and refuses a new request from that person
    // until the cooldown has passed (`declinedRecently`, below).
    //
    // NESTED UNDER THE RECIPIENT, `requestDeclines/{me}/from/{them}`, so the create rule can address
    // it with two plain variables and no query. Readable by the recipient alone: the SENDER learning
    // they were declined rather than simply unanswered is exactly the information §13 says not to
    // hand out, and the rules read it server-side without anybody's client needing to.
    //
    // `at == request.time` — the server's clock, never the client's. A recipient could otherwise
    // write a date in the far future and hold someone off for ever, or the past and mean nothing.
    match /requestDeclines/{recipient}/from/{sender} {
      allow read: if signedIn() && request.auth.uid == recipient;
      allow create, update: if signedIn()
        && request.auth.uid == recipient
        && sender != recipient
        // 2026-09-24 fix-all #227: optional `sender`, and only ever the id's own sender, so the
        // account purge can query these by the declined person. Older builds still write `at` alone.
        && request.resource.data.keys().hasOnly(['at', 'sender'])
        && request.resource.data.get('sender', sender) == sender
        && request.resource.data.at == request.time;
      // Taking it back early is the recipient's to do: it only ever lets somebody knock sooner.
      allow delete: if signedIn() && request.auth.uid == recipient;
    }

    match /usernames/{name} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    // 2026-10-07 username contract section 8. Server-only collections, written by the username
    // functions with the admin SDK: the audit trail, the per-account limits (check/claim/lookup
    // counters, names on hold), and the lookalike-protection index for verified and reserved names.
    // No client may read or write any of them; the admin page reads the audit through
    // adminUsernameInfo. Default deny would refuse them anyway; stated so nobody opens one by accident.
    match /usernameAudit/{id} {
      allow read, write: if false;
    }
    match /usernameLimits/{uid} {
      allow read, write: if false;
    }
    match /verifiedSkeletons/{skeleton} {
      allow read, write: if false;
    }

    // Abuse reports (App Store Guideline 1.2 — users must be able to flag content
    // and report abusive users). Any signed-in user can FILE a report; the reporter
    // field must be themselves. No client can read, edit, or delete reports — the
    // operator reviews them in the Firebase console and acts within 24 hours.
    match /reports/{reportId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.reporterUid
        // 2026-09-24 fix-all: a day's reports, on the counter pattern `requests` uses
        // (`users/{me}/limits/reports`, bumped by the app after each report, 24h window). 50 a day,
        // or `reports_per_day_default` in `config/limits`. Fails open on a missing counter, the same
        // terms as every other limit here.
        && (
             !exists(/databases/$(database)/documents/users/$(request.auth.uid)/limits/reports)
             || get(/databases/$(database)/documents/users/$(request.auth.uid)/limits/reports).data
                  .get('windowStart', request.time) < request.time - duration.value(24, 'h')
             || get(/databases/$(database)/documents/users/$(request.auth.uid)/limits/reports).data
                  .get('count', 0) < appLimit('reports_per_day_default', 50)
           );
      // Readable by moderators, and by nobody else - a report names the person who filed it, and a
      // reported user being able to look up who reported them is how reporting stops being used.
      allow read: if adminCan('moderate');
      // ⛔ 2026-10-12: closing a report is the adminApi function's job (audited), not a client write.
      // No client may change a report once filed.
      allow update: if false;
      allow delete: if false;
    }

    // ── GLOW ─────────────────────────────────────────────────────────────────────────────────
    //
    // One document per glow: /glows/{from}_{to}, exactly {from, to, createdAt}. A glow is the
    // relationship behind Glow Stories — two people who are not friends and have never chatted
    // reaching each other's stories. It is REMOVABLE (an edge, not an event), and it is kept
    // strictly separate from conversations: nothing here reads that collection, and a person can
    // be friend, glower, glowing, or any combination.
    //
    // ⛔ THE ID IS CHECKED AGAINST THE PAYLOAD. Without that, anybody could write a document whose
    // id claims one edge while its fields claim another, and every reader that trusts one of the
    // two is lied to by the other. With it, one edge has one possible document.
    //
    // ⛔ LISTS ARE OWNER-SCOPED, AND THAT IS THE PRIVACY MODEL (his ruling, 2026-09-02: counts are
    // public, the name lists are yours alone). A list is only allowed when every returned document
    // provably has the caller on one end — which in rules terms means the query pins `from` or
    // `to` to the caller's own uid. Walking somebody ELSE's glower list is refused wholesale.
    // The same class of decision that closed the user directory on 2026-08-10: public counts must
    // not become a walkable graph.
    //
    // The public counts live on the user document as glowerCount / glowingCount, written only by
    // the onGlowWrite function — both names are in serverOnlyUserFields() above.
    match /glows/{edgeId} {
      allow get: if signedIn()
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow list: if signedIn()
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.from
        && request.resource.data.from != request.resource.data.to
        && edgeId == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt'])
        && request.resource.data.keys().hasAll(['from', 'to', 'createdAt'])
        && request.resource.data.to is string && request.resource.data.to.size() > 0
        // ⛔ THE STAMP IS THE SERVER'S, NOT THE CLIENT'S. `createdAt` was required to be PRESENT and
        // then never looked at again, and an edge cannot be updated — so whatever a client wrote at
        // create is that glow's time for ever. The receiver's notifications page is ordered by it
        // (`GlowService` asks for `to == me` by `createdAt` descending), so a back-dated glow never
        // surfaces as new and a forward-dated one holds the top of that list permanently.
        //
        // The app already sends `FieldValue.serverTimestamp()`, which IS `request.time` by the time
        // a rule sees it, so this pins the value the app was sending anyway. Same shape as
        // `windowStart == request.time` on the rate counter above, and the same reasoning: a field
        // the client chooses is a field the client can invent.
        && request.resource.data.createdAt == request.time
        && !isBanned()
        // 2026-09-24 fix-all: a day's glows, on the counter pattern `requests` uses
        // (`users/{me}/limits/glows`, bumped by the app after each glow, 24h window). 200 a day, or
        // `glows_per_day_default` in `config/limits`. A person does not start following hundreds of
        // people a day; a script does. Fails open on a missing counter, like every limit here.
        && (
             !exists(/databases/$(database)/documents/users/$(request.auth.uid)/limits/glows)
             || get(/databases/$(database)/documents/users/$(request.auth.uid)/limits/glows).data
                  .get('windowStart', request.time) < request.time - duration.value(24, 'h')
             || get(/databases/$(database)/documents/users/$(request.auth.uid)/limits/glows).data
                  .get('count', 0) < appLimit('glows_per_day_default', 200)
           );
      // No update: a glow has nothing to edit. Give again after a remove is a fresh create.
      // 2026-09-24 fix-all: ...except the SAME glow sent twice. A create whose answer was lost is
      // retried by the SDK and judged as an update once the first copy exists, and `if false` refused
      // a glow that had in fact landed. The retry may only restate the same edge with a fresh server
      // stamp, and only within ten minutes of the first, so it cannot be used to keep a glow at the
      // top of somebody's notifications.
      allow update: if signedIn()
        && request.auth.uid == resource.data.from
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to
        && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && resource.data.createdAt > request.time - duration.value(10, 'm');
      // EITHER END may sever the edge: the giver taking it back, or the receiver removing a glower
      // from their own list — his requirement that a relationship change is handleable from both
      // sides.
      allow delete: if signedIn()
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    // Official sticker packs. Published by us and readable by everyone signed in; no client
    // may ever write one. There is no in-app pack creator and there is not meant to be - that
    // is exactly what keeps stickers free of moderation, reporting and takedowns. Packs are
    // put here by the publisher script over the admin REST API, which bypasses these rules.
    match /stickerPacks/{packId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ── THE OFFICIAL CHANNEL ──────────────────────────────────────────────────────────────────
    //
    // There is no @fariin account and there is not meant to be. The official chat is built by the
    // app itself around a fixed id, exactly the way Signal's release channel is, which is what makes
    // it impossible to impersonate: there is no account to steal and no username to copy. What lives
    // here is only the WORDS - one document per announcement, read by every phone on earth, with who
    // it is for decided on the phone out of the fields it carries.
    //
    // Permission is a document, not a Cloud Function: `admins/{uid}` is the whole permission system,
    // and the four helpers at the top of this file are the server-side check.

    // Where "Update Now" sends people. Not hardcoded, because the app has no App Store id yet and a
    // button that opens nothing is a fake feature. Owner sets it once; everybody reads it.
    match /config/official {
      allow read: if signedIn();
      // 2026-10-13 audit: the Fariin badge (`badge`) is one of three values and says who set it
      // (`badgeBy`), which the adminOfficialBadgeAudit trigger copies into the hash-chained adminAudit.
      allow write: if adminIsOwner()
        && (!request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasAny(['badge'])
            || (request.resource.data.badge in ['blue', 'gold', 'none']
                && request.resource.data.get('badgeBy', '') == request.auth.uid));
    }

    // ⛔ EVERY CEILING THE APP ENFORCES, IN ONE DOCUMENT THE OWNER CAN EDIT WITHOUT A RELEASE.
    // See `appLimit()` at the top of this file for the whole reasoning. Read by every signed-in
    // phone and by the rules themselves; written by the owner alone, from the console or from the
    // admin screen, and by nobody else — a limit anyone could raise is not a limit.
    //
    // Keys are `<thing>_default` and `<thing>_verified`, the same pairing the reference app uses
    // for its own two tiers, so a new limit is a new pair and never a new mechanism:
    //   stories_per_day_default    50    stories_per_day_verified    100
    //   stories_per_hour_default   40    stories_per_hour_verified    40
    //
    // ⚠️ WRITE THEM AS NUMBERS. The console types a new field as a string unless it is told
    // otherwise, and a string here is ignored — `appLimit()` falls back rather than erroring, so a
    // limit typed as text looks like an edit that did nothing.
    // 2026-10-17: Fariin's stories changed; phones re-ask `officialStoriesFeed`. Server-written only.
    match /config/officialStoriesStamp {
      allow read: if signedIn();
      allow write: if false;
    }

    match /config/limits {
      allow read: if signedIn();
      allow write: if adminIsOwner();
    }

    // FEATURE SWITCHES (2026-10-12). Read by every signed-in phone (RemoteFeatures.swift), written by
    // NOBODY from a client: only the adminApi function changes it, which checks the owner, refuses ON
    // for an unfinished feature, and records every flip in the audit log.
    match /config/features {
      allow read: if signedIn();
      allow write: if false;
    }

    // ⛔ MESSAGE POLICY (owner 2026-10-18): Message Requests and the Chat Key, switched globally from
    // the admin panel. Read by every phone with a LIVE listener (MsgPolicy.swift) and by the
    // conversation rules (`requestsOnFor`, `chatKeyRequiredFor`); written only by adminApi
    // (msgPolicySet), which checks the owner and a fresh sign-in and records old → new in the
    // audit chain. Absent = today's behaviour.
    match /config/msgPolicy {
      allow read: if signedIn();
      allow write: if false;
    }

    // The admin team. You may read your OWN row, which is how the app knows whether to show the admin
    // screens at all; the owner may read the whole team.
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || adminIsOwner());
      // Only the owner appoints, and only ever an 'admin' - nobody can mint a second owner, so the
      // owner's own row cannot be created, edited or deleted by any client. It is seeded once,
      // out of band, and after that it is untouchable from the app.
      allow create: if adminIsOwner() && request.resource.data.get('role', '') == 'admin';
      allow update: if adminIsOwner()
        && resource.data.get('role', '') == 'admin'
        && request.resource.data.get('role', '') == 'admin';
      allow delete: if adminIsOwner() && resource.data.get('role', '') == 'admin';
    }

    // VERIFICATION CASE FILES. The private half of a verification, keyed by the same peer key the
    // mark uses — "user:abc123" today, "group:xyz789" when groups arrive.
    //
    // WHY THE RECORD IS SPLIT IN TWO. The verdict lives on the peer document, because every client
    // needs it to draw a name and it must cost nothing to read. Everything AROUND the verdict — what
    // documents we saw, what the reviewer thought, which admin approved it — lives here, where no
    // user can read it. Storing them together would mean either publishing the case file or paying
    // for a second read on every name drawn, and both are the wrong trade.
    //
    // Not even the verified person may read their own. Reviewer notes describe a judgement about
    // somebody, and are for the people making the next judgement.
    match /verifications/{peerKey} {
      allow read: if adminCan('verify');
      // Server only since 2026-10-13 (see the users rule above): the case file is written by
      // adminApi in the same transaction as the badge.
      allow create, update: if false;
      // NO delete. Withdrawing a verification is a status change, never an erasure — a peer that was
      // verified and no longer is has a history, and that history is the useful part.
      allow delete: if false;
    }

    // VERIFICATION AUDIT. Every grant, change, suspension and removal, with who did it, when, what it
    // was before, what it became, and why.
    //
    // APPEND ONLY, AND THAT IS THE POINT: no update, no delete, for anybody, including the owner. An
    // audit trail an administrator can edit answers no question worth asking. A record written here
    // is permanent, and if one is wrong the correction is another record.
    //
    // Readable only by admins. It carries internal reasons about real people and is nobody else's
    // business — least of all the person it is about, who would learn exactly what was noticed.
    match /verificationAudit/{entryId} {
      allow read: if adminCan('verify');
      // Pinned to the caller: an admin cannot write an entry attributed to somebody else, so the
      // trail cannot be used to blame a colleague for your own decision.
      // Server only since 2026-10-13: a client could write an entry with a made-up reason, or a badge
      // with no entry at all. Entries now come only from adminApi, beside its hash-chained adminAudit.
      allow create, update, delete: if false;
    }

    // A send to CHOSEN PEOPLE never touches /announcements. The words would be readable by anybody
    // who queries that collection, which is the opposite of what picking three people by name means -
    // and marking it "chosen" and filtering on the phone would hide it from the app and from nobody
    // else. Its record lives here instead, admin-only, and this is also the ONLY place the recipient
    // list is stored. It has to be stored somewhere: withdrawing one of these has to reach every
    // private copy, and without the list there is nothing to reach.
    match /announcementLog/{id} {
      allow read: if isAdmin();
      // 2026-09-24 audit: was `allow create, update: if adminCan('targetChosen')`. Same split and
      // same reason as the per-person copies under users/{uid}/announcements: send/edit/remove are
      // now checked here as they are on /announcements, with the same caps, and a withdrawal needs
      // `remove`, not `targetChosen`. Only a chosen send may live here.
      allow create: if adminCan('send') && adminCan('targetChosen')
        && announcementWellFormed() && announcementKindAndTimeAllowed()
        && request.resource.data.audience.get('scope', '') == 'chosen';
      // 2026-09-24 decision D-admin-resurrect: edits go through `announcementEditAllowed()`.
      // 2026-09-24 decision D-admin-fanout: the sender counts delivered copies onto the record in
      // the same batch as the copies (`deliveredCount` only, never onto a withdrawn record).
      allow update: if (adminCan('edit') && adminCan('targetChosen')
          && announcementWellFormed() && announcementEditAllowed()
          && request.resource.data.audience.get('scope', '') == 'chosen')
        || (adminCan('remove')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt'])
          && request.resource.data.deleted == true)
        || ((adminCan('send') || adminCan('edit')) && adminCan('targetChosen')
          && resource.data.get('deleted', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredCount'])
          && request.resource.data.deliveredCount is int
          && request.resource.data.deliveredCount <= request.resource.data.get('recipients', []).size());
      allow delete: if false;
    }

    // owner 2026-10-21: APP HEALTH. What phones report about crashes, errors and slowness goes in
    // through the telemetryIngest callable only (it cleans every event and writes with the admin SDK,
    // which skips these rules). telemetryRate is that callable's per-account counter. Phones read and
    // write none of it, not even their own. Admins may read (the panel reads through adminApi).
    match /telemetry/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /opsIssues/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /opsAlerts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /telemetryRate/{uid} {
      allow read, write: if false;
    }

    // ⛔ 2026-10-16 Official Stories: written ONLY by the admin panel's server (adminApi ostorySave /
    // ostoryRemove, admin SDK, bypasses these rules) and handed to phones ONLY by the
    // officialStoriesFeed callable, which filters by country, build and iOS. So no phone reads this
    // collection: a story aimed at one country must not be on every phone in the world. Admins who
    // can post may look (the panel lists through the op, but may read directly). No client writes.
    match /officialStories/{id} {
      allow read: if adminCan('send');
      allow write: if false;

      // ⛔ VIEWS OF AN OFFICIAL STORY — owner 2026-10-18: "official stories need view counts, and
      // admins must see who viewed". Every viewer is counted once; a viewer is NAMED only if their
      // own story view receipts are on. Two shapes, both written once by the phone and never again:
      //   named:   id == my uid, {at, named: true}
      //   unnamed: id == sha256('fariin-oview-v1:' + uid) in lowercase hex, {at, named: false}.
      //            No uid is stored; the hash only keeps one phone from counting twice. These rules
      //            cannot check that the hash is really mine, so the shape is all they hold it to.
      // Only for a story that exists. No phone reads, changes or removes one; the panel and the
      // admins' callable read through the admin SDK, and admins who can post may read directly.
      match /views/{viewId} {
        allow read: if adminCan('send');
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/officialStories/$(id))
          && request.resource.data.keys().hasOnly(['at', 'named'])
          && request.resource.data.at == request.time
          && ((viewId == request.auth.uid && request.resource.data.named == true)
            || (viewId.matches('^[0-9a-f]{64}$') && request.resource.data.named == false));
        allow update, delete: if false;
      }
    }

    // 2026-10-18 sticker packs: the catalog every phone's sticker keyboard reads (overrides of the
    // built-in packs, and packs that live only on the server). Written ONLY by the admin panel's server
    // (adminApi spackSave / spackRemove). Nothing in it is private.
    match /stickerPacks/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /announcements/{id} {
      // Everything here is a public broadcast, so every signed-in phone may read it. That also means
      // a SCHEDULED announcement is on the server, readable, from the moment it is written - the same
      // exposure Signal's release-notes file has the moment it is uploaded to their CDN. Scheduling
      // is a convenience, not a secret.
      allow read: if signedIn();

      // Caps, because every phone in the world downloads this. A compromised admin account should not
      // be able to push a megabyte of body text to a million people.
      function wellFormed() {
        return request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000
          && request.resource.data.get('buttons', []).size() <= 3;
      }
      // The permissions that are not just "may send at all" are checked HERE too, not only in the
      // app. An admin limited to plain sends cannot reach for a country list or a security alert by
      // driving Firestore directly.
      // 2026-09-24 audit: `announcementKindAndTimeAllowed()` adds the `schedule` check, which before
      // this lived only in the app (an admin without it could write a future `publishAt` directly).
      function withinPermissions() {
        return announcementKindAndTimeAllowed()
          && (request.resource.data.audience.get('scope', '') != 'countries' || adminCan('targetCountry'))
          // A chosen send is REFUSED here outright, by anybody, including the owner. This collection
          // is world-readable, so putting one here would publish it - the privacy boundary is
          // enforced by this line rather than by the app remembering to use the other collection.
          && request.resource.data.audience.get('scope', '') != 'chosen';
      }
      // 2026-09-24 decision D-admin-security: the same audience checks for an edit, minus the kind
      // and time test, which `announcementEditAllowed()` makes for edits.
      function withinEditPermissions() {
        return (request.resource.data.audience.get('scope', '') != 'countries' || adminCan('targetCountry'))
          && request.resource.data.audience.get('scope', '') != 'chosen';
      }
      // Taking one back is a TOMBSTONE, never a real delete: a phone that is offline right now holds
      // the old copy and can only learn the announcement is gone from a document that still exists to
      // say so. Which is also why delete is closed to everybody, forever.
      function onlyWithdrawing() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt'])
          && request.resource.data.deleted == true;
      }

      allow create: if adminCan('send') && wellFormed() && withinPermissions();
      // 2026-09-24 decision D-admin-resurrect: an edit also passes `announcementEditAllowed()`.
      // `withinPermissions()` still applies its country/chosen checks; its security check is the
      // strict one, so a kept Security kind is let through here only by the edit rule's own test.
      allow update: if (adminCan('edit') && wellFormed() && withinEditPermissions()
          && announcementEditAllowed())
        || (adminCan('remove') && onlyWithdrawing());
      allow delete: if false;

      // HOW MANY people read it, never WHO. A hundred counter documents rather than one, because a
      // single counter would put every reader on earth in a queue behind one lock (Firestore holds a
      // document to roughly one write a second). Each phone may only ever add exactly one.
      //
      // 2026-09-24 audit: `{shard}` must be one of the app's hundred ("0" to "99",
      // `OfficialChannel.shardCount`). Before, any id was accepted, so one account could create
      // an unbounded number of counter documents under an announcement. What this does NOT stop:
      // repeated +1s on a real shard. The count is anonymous by design (no uid is stored), so
      // "once per person" cannot be checked here; it stays a phone-side promise.
      match /readShards/{shard} {
        allow read: if isAdmin();
        allow create: if signedIn()
          && shard.matches('^[0-9]{1,2}$')
          && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count == 1;
        allow update: if signedIn()
          && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count == resource.data.count + 1;
        allow delete: if false;
      }
    }

    // ⛔ GROUP MODERATION — 2026-10-18. Fariin's moderators (the admin panel, functions-admin
    // groupModSet / groupDisable) put a group on a ladder kept in its server-only `mod` map:
    //   limited   = nobody new joins (no member add here; the join callables refuse too);
    //   suspended = nobody sends, adds, invites or changes the group, while `mod.until` is in the
    //               future (null = until lifted by hand);
    //   disabled  = the same, for good.
    // Members keep reading, keep their own private state, and may still leave. An expired
    // suspension reads as lifted here before the hourly sweep writes it back. No get(): both take
    // the conversation's data, which every caller already has.
    function groupModBlocked(d) {
      let m = d.get('mod', {});
      // 2026-10-20 (owner): a group its owner ENDED (`endedAt`, endGroup) is closed the same way:
      // no sending, no calls, no changes; leaving still works.
      return d.get('type', '') == 'group'
        && (d.get('endedAt', null) != null
            || m.get('state', 'ok') == 'disabled'
            || (m.get('state', 'ok') == 'suspended'
                && (m.get('until', null) == null || m.get('until', null) > request.time)));
    }
    function groupModClosed(d) {
      return groupModBlocked(d)
        || (d.get('type', '') == 'group' && d.get('mod', {}).get('state', 'ok') == 'limited');
    }

    // A conversation belongs to exactly two users.
    match /conversations/{cid} {
      // 2026-09-24 fix-all: GUARDED BY exists(), the file's own idiom. A bare `get` of a conversation
      // deleted mid-flight (a declined request while a queued send or an open listener is still on
      // its messages) ERRORED instead of answering. A missing conversation now reads as one with no
      // members, so every message rule under it is a clean `false`.
      function convData() {
        return exists(/databases/$(database)/documents/conversations/$(cid))
          ? get(/databases/$(database)/documents/conversations/$(cid)).data
          : {'users': []};
      }
      // MESSAGE REQUESTS (owner spec, 2026-08-04). Two fields carry the whole thing: `startedBy`
      // marks a conversation as belonging to the request era at all, and `accepted` says whether the
      // other person has answered. A document with NO `startedBy` predates this and is fully open —
      // without that, every chat anybody already had would become a pending request the moment these
      // rules went live.
      //
      // THE CLIENT IS NOT THE ENFORCEMENT. It decides what the screen offers; these rules decide what
      // the database accepts, and they hold against a patched client, which is the only version of a
      // limit that means anything.
      function isRequestPending() {
        return resource.data.get('startedBy', '') != '' && resource.data.get('accepted', false) == false;
      }

      // A PER-USER MAP MAY ONLY CHANGE THE CALLER'S OWN KEY.
      //
      // The conversation document is shared, but several of its fields are maps keyed by uid holding
      // each member's PRIVATE state: who they blocked, what they muted, what they cleared, when they
      // last read. The 1:1 branch below allowed "any field", which meant the other member could
      // rewrite all of it. The sharpest case: somebody you BLOCKED could set `blockedBy[you] = false`
      // and unblock themselves, because blocking is enforced by the reader's client reading that map.
      // They could also wipe your copy of the chat (`clearedAt`), forge your read receipt
      // (`lastRead`), or un-mute themselves in your notifications.
      //
      // `unreadCount` is deliberately NOT on this list: the sender increments the RECIPIENT'S badge,
      // so it is the one map that legitimately crosses. Every other one is written by its owner only
      // — checked against every call site in ChatService before this rule was written.
      //
      // `.get(f, {})` on both sides so an absent map is an empty map rather than an error, and an
      // untouched field diffs to nothing, which `hasOnly` accepts.
      function ownKeyOnly(f) {
        return request.resource.data.get(f, {}).diff(resource.data.get(f, {}))
                 .affectedKeys().hasOnly([request.auth.uid]);
      }
      function privateMapsUntouched() {
        return ownKeyOnly('blockedBy') && ownKeyOnly('blockedAt') && ownKeyOnly('blockClearedAt')
            && ownKeyOnly('clearedAt') && ownKeyOnly('mutedBy') && ownKeyOnly('pinnedBy')
            && ownKeyOnly('archivedBy') && ownKeyOnly('pinOrder') && ownKeyOnly('lastRead')
            // Voice-note played receipts. On this list for the same reason `lastRead` is: it is MY
            // statement about what I have heard, and without the pin the other member could forge it
            // — writing themselves a "you played my note" mark you never gave, or wiping yours to
            // hide that they heard you. It is also how somebody with read receipts switched off
            // would have leaked one anyway.
            && ownKeyOnly('lastPlayedVoice')
            // 2026-09-24 decision D13: Mark as Unread is its own per-user flag; only my own key.
            && ownKeyOnly('markedUnread')
            // 2026-09-25 delivered ticks: "it reached my phone" is MY statement, like `lastRead`.
            // Written by my app while it runs; the server writes it for a closed app (ackDelivered).
            && ownKeyOnly('delivered');
      }
      // The other party of a 1:1 being created.
      function otherMember() {
        return request.resource.data.users[0] == request.auth.uid
          ? request.resource.data.users[1] : request.resource.data.users[0];
      }
      // "My Friends" means an accepted conversation already exists. At CREATE time none can, so a
      // friends-only account simply cannot be opened by a stranger. Everyone is the default, and an
      // unreadable or absent setting reads as Everyone rather than as a refusal.
      // GUARDED BY exists(). A `get` on a document that is not there does not evaluate to null in
      // rules, it ERRORS, and an error is not a `false` that the next `||` branch can recover from —
      // it fails the whole expression. An account with no profile document reads as Everyone, which
      // is the same direction every other unknown in this file leans.
      function acceptsFromStrangers(u) {
        return !exists(/databases/$(database)/documents/users/$(u))
          || get(/databases/$(database)/documents/users/$(u)).data.get('privacy', {}).get('messages', 'everyone') != 'contacts';
      }
      // ⛔ MESSAGE POLICY FROM THE ADMIN PANEL — owner 2026-10-18: Message Requests and the Chat Key
      // switched on or off for everybody, or for one person, at any time and with no app release.
      //   config/msgPolicy        {requests, chatKeyRequired, chatKeyVisible}   the global switches
      //   users/{u}.msgPolicy     {requests?, chatKeyRequired?}                 one person's override
      // Both are written only by adminApi (config has no client write; `msgPolicy` is in
      // serverOnlyUserFields). The person override wins over the global, the global over the
      // shipped default, and the shipped default is TODAY'S behaviour: requests on, Chat Key
      // required, Chat Key shown. A missing document, a missing key, or anything but `false`
      // reads as on, so nothing changes until the owner flips a switch.
      //
      // THE RECIPIENT'S SETTING DECIDES. `u` is always the person being written to.
      //
      // The override lives on the user document, not in a collection of its own, because every
      // check that needs it already reads `users/{u}` (`acceptsFromStrangers`) and rule evaluation
      // caches that document: one extra read per request (the config), not three.
      //
      // ⚠️ EVERY CALLER PUTS TODAY'S CHECK FIRST AND THESE AFTER AN `||`. So an ordinary chat that
      // passes today's rules never reads the config at all, and only a write today's rules would
      // refuse asks whether the owner has switched that refusal off.
      function msgPolicyGlobal() {
        return exists(/databases/$(database)/documents/config/msgPolicy)
          ? get(/databases/$(database)/documents/config/msgPolicy).data : {};
      }
      function msgPolicyOverride(u) {
        return exists(/databases/$(database)/documents/users/$(u))
          ? get(/databases/$(database)/documents/users/$(u)).data.get('msgPolicy', {}) : {};
      }
      // Requests off for `u` and `u` takes me; one read each (2026-10-20: over 1,000 expressions).
      function reqOffMayWrite(u) {
        let ud = exists(/databases/$(database)/documents/users/$(u))
          ? get(/databases/$(database)/documents/users/$(u)).data : {};
        let g = msgPolicyGlobal();
        let o = ud.get('msgPolicy', {});
        return o.get('requests', g.get('requests', true)) == false
          && (ud.get('privacy', {}).get('messages', 'everyone') != 'contacts'
              || g.get('chatKeyVisible', true) == false
              || o.get('chatKeyRequired', g.get('chatKeyRequired', true)) == false);
      }
      // owner 2026-10-21: a 1:1 started while requests were off for the other (`reqOff`) stays
      // open, still under their Chat Key. `accepted` is untouched.
      function reqOffChatMayWrite(u) {
        return convData().get('reqOff', false) == true && strangersMayWrite(u);
      }
      // `reqOff`: absent -> true before anyone wrote, while off for the other; cleared by unfriend.
      function reqOffStampOk() {
        return !('reqOff' in request.resource.data.diff(resource.data).affectedKeys())
          || isUnfriend()
          || (!('reqOff' in resource.data)
              && request.resource.data.get('reqOff', false) == true
              && isRequestPending()
              && resource.data.get('lastSender', '') == ''
              && !requestsOnFor(otherExistingMember()));
      }
      // Does a stranger's first message to `u` arrive as a request (one short text, then wait)?
      function requestsOnFor(u) {
        return msgPolicyOverride(u).get('requests', msgPolicyGlobal().get('requests', true)) != false;
      }
      // Is `u`'s "People Who Know My Chat Key" setting enforced? HIDING THE CHAT KEY (the global
      // `chatKeyVisible: false`) TURNS THE REQUIREMENT OFF TOO: a key nobody can see or type must
      // never be the reason somebody cannot be reached. The panel says so next to the switch.
      function chatKeyRequiredFor(u) {
        return msgPolicyGlobal().get('chatKeyVisible', true) != false
          && msgPolicyOverride(u).get('chatKeyRequired', msgPolicyGlobal().get('chatKeyRequired', true)) != false;
      }
      // A stranger may write to `u`: `u` takes messages from everyone, or the key is not required.
      function strangersMayWrite(u) {
        return acceptsFromStrangers(u) || !chatKeyRequiredFor(u);
      }
      // THE DECLINE COOLDOWN — owner's spec, 2026-09-11 §10. `u` deleted my last request less than
      // seven days ago, so I may not open another. Read from `requestDeclines/{u}/from/{me}`, which
      // only `u` can write (see that match); an absent document is simply "never declined".
      //
      // Seven days is the whole configuration: it is here, in the rules, which are the server, and
      // nowhere a client can reach. GUARDED BY exists() for the reason `acceptsFromStrangers` is.
      function declinedRecently(u) {
        return exists(/databases/$(database)/documents/requestDeclines/$(u)/from/$(request.auth.uid))
          && get(/databases/$(database)/documents/requestDeclines/$(u)/from/$(request.auth.uid))
               .data.at.toMillis() + 7 * 24 * 60 * 60 * 1000 > request.time.toMillis();
      }
      // A pending request whose one message has not been sent yet — the state every new 1:1 is born
      // in, and the state "Remove Friend" puts an old one back into. It is the ONLY state in which
      // a message may be written into a pending conversation, so it is where the request rules
      // (text only, short, and the other person's privacy) are enforced; see the message rule.
      function isPendingFirstMessage() {
        return convData().get('startedBy', '') != ''
          && convData().get('accepted', false) == false
          && convData().get('lastSender', '') == '';
      }
      // A DAY'S KNOCKS — owner's spec, 2026-09-11 §25 ("request creation limits"). The counter is
      // `users/{me}/limits/requests`, written by the app on every first message to a stranger and
      // guarded by the `limits` rule (a window only reopens once spent, a count only goes up by
      // one). Read here, on the knock itself, the way the story rules read theirs.
      function requestBudget() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)/limits/requests).data;
      }
      // The other half of a 1:1 id, for the message rule, where `request.resource.data.users` does
      // not exist. THE ID IS THE MEMBERSHIP (see the read rule below).
      function otherHalf() {
        return cid.split('_')[0] == request.auth.uid ? cid.split('_')[1] : cid.split('_')[0];
      }
      // The other member of an EXISTING conversation, for update rules.
      function otherExistingMember() {
        return resource.data.users[0] == request.auth.uid ? resource.data.users[1] : resource.data.users[0];
      }
      // 2026-09-24 fix-all: TWO STRANGERS OPENING THE SAME 1:1 AT ONCE. The id is the two uids, so
      // both phones write the same document; one create lands and the other arrives as an update
      // carrying `startedBy` = its own sender, which the `startedBy` pin refused. Decision: the second
      // opener's create-shaped write is accepted as if it had won the race, on exactly the terms a
      // create would have met (the other person's privacy, the decline cooldown), and only while the
      // request is still unspent on both sides (no message yet). Both people reached for each other;
      // who is on record as asking first is not worth a refused chat.
      function isCrossedOpen() {
        return resource.data.get('type', '') != 'group'
          && isRequestPending()
          && resource.data.get('startedBy', '') == otherExistingMember()
          && resource.data.get('lastSender', '') == ''
          && request.resource.data.get('startedBy', '') == request.auth.uid
          && request.resource.data.get('accepted', true) == false
          && request.resource.data.get('lastSender', '') == ''
          && strangersMayWrite(otherExistingMember())   // owner 2026-10-18: or the Chat Key is switched off
          && !declinedRecently(otherExistingMember());
      }
      // 2026-09-24 fix-all: IS THE CALLER UNDER A LIVE RESTRICTION `flag` in the conversation data
      // `d`. The client's model (`Conversation.Restrict`, `activeRestrictions`): admins and the owner
      // are never restricted, and a restriction ends when `restrictedUntil` passes.
      function restrictedIn(d, flag) {
        return !(request.auth.uid in d.get('admins', []))
          && request.auth.uid != d.get('createdBy', '')
          && flag in d.get('restrictedFlags', {}).get(request.auth.uid, [])
          && d.get('restrictedUntil', {}).get(request.auth.uid, 0) > request.time.toMillis();
      }
      // 2026-09-24 fix-all: WHAT A WRITE MAY DO TO `unreadCount`. It is the one per-member map the
      // sender legitimately writes on OTHER people's keys, so it could not join the own-key pin, and
      // it had no check at all: any member could set anyone's badge to any number. Every client write
      // was checked: another member's key only ever goes up by exactly one (a send's increment), or
      // is seeded at 0 for someone who was not a member before (create, add members); my own key may
      // be anything numeric (read resets it, Mark as Unread's old -1). A key may be removed only by
      // its owner, or with its member leaving the list.
      //
      // ⚠️ EXACT FOR A 1:1, STRUCTURAL FOR A GROUP. Rules have no loops, and walking a 30-member list
      // key by key was measured against the rules test service: it runs out of the engine's 1,000
      // evaluated expressions per request at 15 members, which would have refused every send in a
      // bigger group. So a group gets what is affordable: another member's badge moves only in a
      // write that is a send by me (`lastSender` = me, `updatedAt` stamped) or grows the member
      // list. That closes "set somebody's badge without sending anything"; the size of the number
      // inside a send in a group stays unchecked. At CREATE every badge is 0 or 1, exactly, cheaply.
      // Cheapest test first: a send's +1 is by far the most common write.
      function unreadKeyOk(n, o, oldUsers, k) {
        return (k in n)
          ? (n[k] == o.get(k, 0) + 1
             || (k in o && n[k] == o[k])
             || (k == request.auth.uid && n[k] is int)
             || (n[k] == 0 && (!(k in o) || !(k in oldUsers))))
          : (!(k in o) || k == request.auth.uid);
      }
      function unreadUpdateOk() {
        let n = request.resource.data.get('unreadCount', {});
        let o = resource.data.get('unreadCount', {});
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        return !('unreadCount' in keys)
          || (resource.data.get('type', '') != 'group' && resource.data.users.size() == 2
              ? (unreadKeyOk(n, o, resource.data.users, resource.data.users[0])
                 && unreadKeyOk(n, o, resource.data.users, resource.data.users[1]))
              : (n.diff(o).affectedKeys().hasOnly([request.auth.uid])
                 || (request.resource.data.get('lastSender', '') == request.auth.uid && 'updatedAt' in keys)
                 || request.resource.data.users.size() > resource.data.users.size()));
      }
      function unreadCreateOk() {
        return !('unreadCount' in request.resource.data)
          || request.resource.data.unreadCount.values().hasOnly([0, 1]);
      }
      // REMOVE FRIEND — owner's spec, 2026-09-11 §23. Direct access is taken back by putting the
      // conversation back where it started: pending, with the OTHER person as the one who has to
      // ask, and their one message unspent. The history stays; nothing is deleted. They are then
      // subject to my privacy like any stranger: Everyone lets them knock once, My Friends does not
      // (the message rule checks it), and my Chat PIN still opens the door.
      //
      // ⚠️ THE ONLY WAY BACK THROUGH THE ONE-WAY DOOR, and it is checked to the key: `accepted` may
      // go true → false only from a conversation that is currently OPEN, only when `startedBy`
      // becomes the other member and `lastSender` is cleared in the SAME write, and only when that
      // write touches nothing else. A requester whose one message is spent cannot use it to buy a
      // second (their chat is not open), and a member of an open chat who uses it is trading
      // unlimited messages for one — there is no privilege to gain.
      function isUnfriend() {
        return resource.data.get('type', '') != 'group'
          && resource.data.users.size() == 2
          && (resource.data.get('startedBy', '') == '' || resource.data.get('accepted', false) == true)
          && request.resource.data.get('accepted', true) == false
          && request.resource.data.get('startedBy', '') == otherExistingMember()
          && request.resource.data.get('lastSender', '') == ''
          // owner 2026-10-21: and clears `reqOff`.
          && request.resource.data.get('reqOff', false) == false
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['accepted', 'startedBy', 'lastSender', 'unfriendedBy', 'unfriendedAt', 'reqOff']);
      }
      // ⚠️ A CHAT THAT DOES NOT EXIST YET MUST READ AS EMPTY, OR NO NEW CHAT CAN EVER BE STARTED.
      //
      // This was the single `uid in resource.data.users` line, and on a document that is not there
      // `resource` is null, so that test ERRORS and the read is refused. It silently broke starting
      // a conversation for FIVE DAYS (2026-08-04 to 08-09, found from the owner's "Not delivered"
      // screenshots; the live database had not gained a single new 1:1 in that window).
      //
      // The deadlock, with the message-request rules below:
      //   1. `create` demands the chat be born stamped `startedBy` + `accepted:false`.
      //   2. `openConversation` only stamps those when its pre-read ANSWERS, because it must not
      //      stamp a chat that already exists and is merely unreachable (that would drop a real
      //      friendship back to a pending request days later, when the queued write landed).
      //   3. That pre-read is exactly the refused read. So it never answered, the stamp was never
      //      written, and `create` refused the chat. Proving a chat was new required reading the
      //      very thing you were not allowed to read.
      // Every call site wraps `openConversation` in `try?`, so the refusal was thrown away and the
      // chat screen opened as normal — the failure only surfaced later as a message that would not
      // send, pointing at the wrong thing entirely.
      //
      // THE ID IS THE MEMBERSHIP, for a 1:1: the cid IS the two uids sorted and joined by "_", so
      // "your uid is one of the two halves of this id" and "you are a member" say the same thing —
      // and unlike the members list, the id is readable when the document is not there yet.
      //
      // ⚠️ DO NOT rewrite this as `resource == null && ...`. That form reads more precisely and does
      // NOT work: measured against the live rules test service, a get on a missing document does not
      // satisfy `resource == null`, so the branch never fires and new chats stay broken. This form
      // was proven with 8 cases against the live ruleset (both members ALLOWED on a not-yet-existing
      // chat, an outsider DENIED on the same, members/outsiders unchanged on existing 1:1s AND
      // groups), with the previous rules as the control, where the two fix cases FAIL.
      allow read: if signedIn() && (
        request.auth.uid in cid.split('_')
        || request.auth.uid in resource.data.get('users', [])
      );
      // 1:1 must be exactly 2; a group ("type":"group") may have 1 to group_members_max members and the
      // creator must be in its admins list.
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.users
        && unreadCreateOk()   // 2026-09-24 fix-all: others' badges are born at 0 (or 1 with a first send)
        && !('deletedUsers' in request.resource.data)   // 2026-10-18: the purge's marker, server-only
        && !request.resource.data.keys().hasAny(['mod', 'verified'])   // 2026-10-18 group moderation: server-only
        // 2026-10-19 groups v2: the group type and its public @name are written only by
        // functions-username setGroupUsername, which claims the name in `usernames` in the same step.
        // `joinApproval` (a public group files join requests instead of adding) is server-only too.
        && !request.resource.data.keys().hasAny(['isPublic', 'username', 'usernameLower', 'joinApproval'])
        // 2026-10-19 groups v2 (owner): groups are not end-to-end encrypted. A new group may say so
        // itself (`e2ee: false`, written by the app's createGroup), and nothing else: `e2ee` is
        // false-only and groups-only, and the switch time `e2eeOffAt` is the server's alone.
        && (!('e2ee' in request.resource.data)
            || (request.resource.data.get('type', '') == 'group' && request.resource.data.e2ee == false))
        && !('e2eeOffAt' in request.resource.data)
        && !('wallpaper' in request.resource.data)      // owner 2026-10-18: set later, by update only
        // owner 2026-10-21: `reqOff` only true, 1:1, while requests are off for the other.
        && (!('reqOff' in request.resource.data)
            || (request.resource.data.reqOff == true
                && request.resource.data.get('type', '') != 'group'
                && request.resource.data.users.size() == 2
                && !requestsOnFor(otherMember())))
        && (
          // THE GROUP BRANCH GOES FIRST, on purpose. A two-member group also satisfies `size() == 2`,
          // and evaluating the 1:1 branch would send it through a privacy lookup it has no business
          // doing — and, when that lookup errors, deny a group that was perfectly legal.
          (
            request.resource.data.get('type', '') == 'group'
            // ⛔ ONE IS ENOUGH — owner 2026-10-18: a group may start with only its creator (New
            // Group's Skip); members are added later. Was >= 2. The creator is still required in
            // `users` and `admins` (above and below), so it is never anyone else's group.
            && request.resource.data.users.size() >= 1
            // 2026-10-19: the cap is config/limits.group_members_max (admin panel, 2..500), not 30.
            && request.resource.data.users.size() <= appLimit('group_members_max', 30)
            && request.auth.uid in request.resource.data.admins
            // 2026-10-19 group fix round S8: the owner is the creator. `createdBy` holds every right
            // (the admin rules, the owner hand-off), so a create naming somebody else made them the
            // owner of a group they never made. ChatService.createGroup has written `uid` since June.
            && request.resource.data.get('createdBy', '') == request.auth.uid
            // 1:1 audit r3 F1, 2026-10-08: a group is never born at a 1:1 id. Every call and
            // friend check reads `conversations/{a_b}`; a group there (members of the creator's
            // choosing, a `lastMessage`, no `startedBy`) read as an old accepted chat. The app
            // mints group ids with `document()` (letters and digits, never "_").
            && !cid.matches('.*_.*')
            // ⛔ "CREATE NEW GROUPS" OFF — owner 2026-10-18, from the admin panel (config/features,
            // `groupCreate`). Only a NEW group is refused; every existing group keeps working, as
            // this is the create rule alone. Absent, or the doc missing, means on, as today.
            && !(exists(/databases/$(database)/documents/config/features)
                 && get(/databases/$(database)/documents/config/features).data.get('groupCreate', true) == false)
          )
          || (
            // 1:1 audit r3 F1, 2026-10-08: THE ID IS THE MEMBERSHIP, enforced here too. The two
            // members are exactly the two halves of the id (sorted, as `ChatService.convId`), so
            // nobody can create my pair id with a second account of theirs as "the other member"
            // and accept it themselves. And it is not a group in disguise.
            request.resource.data.get('type', '') != 'group'
            && request.resource.data.users.size() == 2
            && cid == (request.resource.data.users[0] < request.resource.data.users[1]
                         ? request.resource.data.users[0] + '_' + request.resource.data.users[1]
                         : request.resource.data.users[1] + '_' + request.resource.data.users[0])
            // owner 2026-10-18: `chatKeyRequiredFor` after today's check, so a "People Who Know My
            // Chat Key" account takes new chats from anyone while the panel has the requirement off.
            && (request.auth.uid == otherMember() || acceptsFromStrangers(otherMember())
                || !chatKeyRequiredFor(otherMember()))
            // ...and not somebody who deleted my last request this week (§10). Same guard shape
            // as the privacy read above; the document is theirs and this is the only reader.
            && (request.auth.uid == otherMember() || !declinedRecently(otherMember()))
            // 2026-09-24 decision D8: NO block check here, on purpose. Blocking is SILENT: a refused
            // create would tell the blocked person they are blocked. The blocker's app hides the
            // chat (`BlockList`) and `onNewMessage` skips the push instead.
            // EVERY NEW 1:1 IS BORN AS A REQUEST, and the database is what says so.
            //
            // Without this there was a way around the whole feature: the media send paths touch the
            // conversation with a merge write carrying only `users` and `updatedAt`, which CREATES
            // the document when it is missing — and a document with no `startedBy` reads as one from
            // before requests existed, so it was exempt from the one-message limit. The real app
            // cannot reach that (every route into a chat runs openConversation first), but "the
            // client would never do that" is not enforcement.
            //
            // COST, accepted deliberately by the owner 2026-08-04: a client that does not write
            // these two fields cannot start a NEW chat. Build 455 and earlier are such clients.
            // Their existing conversations are untouched.
            && request.resource.data.get('startedBy', '') == request.auth.uid
            && request.resource.data.get('accepted', true) == false
          )
        );
      // 2026-09-24 audit: THE ADMIN RIGHTS ARE ENFORCED HERE, NOT ONLY BY WHICH BUTTONS SHOW.
      //
      // `Conversation.Right` / `adminCan` (Models.swift) is the model: the owner (`createdBy`) can do
      // everything; an admin with NO `adminRights` entry is a legacy full admin; an admin WITH an
      // entry holds only the slugs listed in it. Managing the admin TEAM (promote, demote, set
      // rights) is owner-only. Before this, any uid in `admins` could write any field: promote
      // anyone, demote the owner's appointees, grant itself every right.
      function adminHasRight(right) {
        return !(request.auth.uid in resource.data.get('adminRights', {}))
               || right in resource.data.get('adminRights', {})[request.auth.uid];
      }
      // What a NON-owner admin's write may change. Each key is matched to the client write that
      // uses it and the right its button is gated on in GroupInfoView / ThreadView:
      //   title, avatarUrl, desc, disappearSeconds, onlyAdminsSend, membersCan* → changeInfo
      //   users grow (addGroupMembers), inviteCode (Invite via Link)             → inviteUsers
      //   users shrink by others, restrictions, bans (removeGroupMember, mute)   → banUsers
      //     (a ban may be LIFTED by an inviteUsers admin: re-adding clears it)
      //   pinnedMessageIds grows (pin)                                            → pinMessages
      //   admins / adminRights: never added to; an admin may only drop out of `admins` in the same
      //     write that takes them out of `users` (removed from the group, or leaving).
      //     owner 2026-10-18: except through delegatedAdminEditOK (the `addAdmins` right).
      // Everything else (sends, previews, own private state) is untouched by this check.
      // owner 2026-10-18: THE GROUP WALLPAPER ("only the owner or an admin can change it; everyone
      // sees it"). A group's `wallpaper` is `ChatWallpaper.stored` (none, g:/c:/b: + an id) or
      // "u:" + a Firebase Storage download link for a photo. Never on a 1:1. WHO may write it is
      // the change-info test below, like the name and photo.
      function groupWallpaperOK() {
        let w = request.resource.data.get('wallpaper', null);
        return resource.data.get('type', '') == 'group'
          && w is string && w.size() <= 1024
          && (w == 'none' || w.matches('[gcb]:[A-Za-z0-9_-]{1,64}')
              || w.matches('u:https://firebasestorage[.]googleapis[.]com/.*'));
      }
      // ⛔ ROLE — owner 2026-10-18: a member's tag in the group (`roles.{uid}` = {text, emoji?}),
      // given ONLY by an admin. The owner may set anyone's, their own and the admins' included; an
      // admin needs Change group info and never sets the owner's. Members never set their own.
      // One person per write, named in `roleEdit.uid` (with `roleEdit.by` = the writer), the same
      // trick as `adminEdit`: the rules cannot pick the one changed key out of the map, so the write
      // says who it is about. Text 1-24, emoji optional and short (the app sends one). A role may be
      // cleared for someone who has left; it is only given to a member. Groups only.
      function roleWriteOK() {
        let o = resource.data;
        let n = request.resource.data;
        let e = n.get('roleEdit', {});
        let t = e.get('uid', '');
        let r = n.get('roles', {}).get(t, null);
        let owner = o.get('createdBy', '');
        return o.get('type', '') == 'group'
          && request.auth.uid in o.get('admins', [])
          && (request.auth.uid == owner || (adminHasRight('changeInfo') && t != owner))
          && e.get('by', '') == request.auth.uid
          && n.get('roles', {}).diff(o.get('roles', {})).affectedKeys().hasOnly([t])
          && (r == null
              || (t in n.users
                  // 'color' (2026-10-20): the tag's colour name. Its value is not checked here: any
                  // check on it pushed a busy admin write past the 1,000-expression ceiling, and the
                  // app draws only its own eight names (an unknown one is plain grey).
                  && r is map && r.keys().hasOnly(['text', 'emoji', 'color'])
                  && r.get('text', null) is string
                  && r.text.size() >= 1 && r.text.size() <= 24
                  && (!('emoji' in r) || (r.emoji is string && r.emoji.size() >= 1 && r.emoji.size() <= 16))));
      }
      // owner 2026-10-18: AN ADMIN THE OWNER TRUSTED WITH "Add new admins" (`addAdmins`, never held
      // by a legacy admin with no entry) may run a small part of the team, the reference app's way:
      //   · promote a member, with at most the rights they hold themselves;
      //   · change the rights of, or demote, only an admin THEY promoted (`adminBy.{uid}` = promoter).
      // Never the owner, never themselves. One person per write, named in `adminEdit.uid` (with
      // `adminEdit.by` = the writer): the rules language cannot pick the one key out of a changed
      // set, so the write says who it is about and the checks below hold it to exactly that person.
      function delegatedAdminEditOK(touched) {
        let o = resource.data;
        let n = request.resource.data;
        let e = n.get('adminEdit', {});
        let t = e.get('uid', '');
        let mine = o.get('adminRights', {}).get(request.auth.uid, []);
        return mine is list && 'addAdmins' in mine
          && e.get('by', '') == request.auth.uid
          && touched.hasOnly([t])
          && t != o.get('createdBy', '') && t != request.auth.uid
          && t in o.users && t in n.users
          && (!(t in o.get('admins', [])) || o.get('adminBy', {}).get(t, '') == request.auth.uid)
          && ((t in n.get('admins', [])
               && n.get('adminRights', {}).get(t, null) is list
               && n.get('adminRights', {}).get(t, []).hasOnly(mine)
               && n.get('adminBy', {}).get(t, '') == request.auth.uid)
              || (!(t in n.get('admins', []))
                  && !(t in n.get('adminRights', {}))
                  && !(t in n.get('adminBy', {}))));
      }
      function nonOwnerAdminWriteOK() {
        let o = resource.data;
        let n = request.resource.data;
        let keys = n.diff(o).affectedKeys();
        let gone = o.users.toSet().difference(n.users.toSet());
        let added = n.users.toSet().difference(o.users.toSet());
        // owner 2026-10-18: the admin team as this write changes it, leavers aside.
        let promoted = n.get('admins', []).toSet().difference(o.get('admins', []).toSet());
        let demoted = o.get('admins', []).toSet().difference(n.get('admins', []).toSet()).difference(gone);
        let rightsKeys = n.get('adminRights', {}).diff(o.get('adminRights', {})).affectedKeys().difference(gone);
        let byKeys = n.get('adminBy', {}).diff(o.get('adminBy', {})).affectedKeys().difference(gone);
        let touched = promoted.union(demoted).union(rightsKeys).union(byKeys);
        // adminsPostStories (owner 2026-10-23): the owner's switch, never an admin's.
        return !keys.hasAny(['createdBy', 'type', 'adminsPostStories'])
          && ((touched.size() == 0 && !('adminEdit' in keys)) || delegatedAdminEditOK(touched))
          // owner 2026-10-18: removing ANOTHER admin from the group is a demotion as well, so the
          // remove-members right covers members only. The owner removes admins; anyone may leave.
          && gone.intersection(o.get('admins', []).toSet()).difference([request.auth.uid].toSet()).size() == 0
          // 2026-10-18 Group Settings: who may start a call (`onlyAdminsCall`) and Restricted Group
          // (`restrictedBy` and the three older restriction fields) are group rules like the rest.
          && (!keys.hasAny(['title', 'avatarUrl', 'desc', 'disappearSeconds', 'onlyAdminsSend',
                            'membersCanAdd', 'membersCanEditInfo', 'onlyAdminsCall', 'wallpaper',
                            'membersCanShareLink', 'restrictedBy', 'restrictRequest', 'noScreenshots', 'noForwarding', 'noSaving',
                            'memberSend', 'slowMode', 'hideHistoryAt'])
              || adminHasRight('changeInfo'))
          // owner 2026-10-18: the self-set Member Label (`memberLabels`, never shipped) gave way to
          // Role (`roles`, roleWriteOK). Nothing writes the old field; only change-info could.
          && (!('memberLabels' in keys) || adminHasRight('changeInfo'))
          && (added.size() == 0 || adminHasRight('inviteUsers'))
          && (!('inviteCode' in keys) || adminHasRight('inviteUsers'))
          && (gone.size() == 0 || gone.hasOnly([request.auth.uid]) || adminHasRight('banUsers'))
          && (!keys.hasAny(['restrictedFlags', 'restrictedUntil']) || adminHasRight('banUsers'))
          // owner 2026-10-18 (admin delete sheet): a restriction is for a plain member. A non-owner
          // admin never writes one for the owner or for another admin (they are exempt anyway, see
          // `restrictedIn`; this keeps the map honest so a later demotion does not wake one up).
          && n.get('restrictedFlags', {}).diff(o.get('restrictedFlags', {})).affectedKeys()
               .union(n.get('restrictedUntil', {}).diff(o.get('restrictedUntil', {})).affectedKeys())
               .intersection(o.get('admins', []).toSet().union([o.get('createdBy', '')].toSet())).size() == 0
          && (!('bannedUids' in keys) || adminHasRight('banUsers')
              || (adminHasRight('inviteUsers') && o.get('bannedUids', []).hasAll(n.get('bannedUids', []))))
          // 2026-10-19 group fix round S7: without Pin messages, only the clean-up unpin (memberUnpinOK).
          && (!('pinnedMessageIds' in keys) || adminHasRight('pinMessages') || memberUnpinOK());
      }
      // 2026-09-24 audit: two floors every group write keeps, whichever branch lets it through.
      // The member cap (config/limits.group_members_max since 2026-10-19, was 30): the create rule
      // and the membersCanAdd branch capped it, the admin branch did not
      // (addGroupMembers' own check reads a cached count, so two admins adding at once overshot).
      // Only a write that GROWS the list is held to it, so a group already over 30 from before the
      // cap can still be edited. And a group with admins never ends with none: two admins leaving at
      // the same moment each saw the other still listed and both removed themselves. The last member
      // leaving (users empty) and a group that already had no admins are exempt.
      function groupFloorsKept() {
        return (request.resource.data.users.size() <= resource.data.users.size()
                || request.resource.data.users.size() <= appLimit('group_members_max', 30))
          && (resource.data.get('admins', []).size() == 0
              || request.resource.data.get('admins', []).size() > 0
              || request.resource.data.users.size() == 0);
      }
      // 2026-09-24 decision D23: ownership moves only as the owner's own leave hands it on.
      // `createdBy` may change in exactly one write: the owner leaving (out of `users`) names a
      // member who stays, and that member is an admin after the write (ChatService.leaveGroup picks
      // the longest-serving admin, else the longest-serving member and makes them admin too).
      // Non-owners were already refused any `createdBy` change by nonOwnerAdminWriteOK.
      // owner 2026-10-18: TRANSFER OWNERSHIP. The owner may also hand the group on while staying in
      // it (ChatService.transferGroupOwnership), to someone already a member who is an admin after
      // the write. Still only the owner: nobody else can ever write `createdBy`.
      function ownerHandOffOK() {
        let o = resource.data;
        let n = request.resource.data;
        return n.get('createdBy', '') == o.get('createdBy', '')
          || (request.auth.uid == o.get('createdBy', '')
              && n.get('createdBy', '') in o.users
              && n.get('createdBy', '') in n.users
              && n.get('createdBy', '') in n.get('admins', []));
      }
      // 2026-10-18 group moderation (see groupModBlocked above). Limited or worse: nobody is added.
      // Suspended or disabled: no info, settings, roles or invite-code change, no new preview line
      // (no message can be sent), and ownership moves only as the owner leaves. Still allowed: each
      // member's own state, profile mirrors, leaving, an admin removing or muting members, unpins.
      // A group the panel never touched has no `mod` at all, so it costs one lookup: the rules stop
      // evaluating at 1,000 expressions, and the heaviest admin writes are close to that already.
      function groupModWriteOK() {
        return !('mod' in resource.data) || groupModRestrictedWriteOK();
      }
      // ...and one in good standing (a label only, or restored) only the state test: the set
      // arithmetic below runs for a limited, suspended or disabled group alone.
      function groupModRestrictedWriteOK() {
        return !groupModClosed(resource.data) || groupModClosedWriteOK();
      }
      function groupModClosedWriteOK() {
        let o = resource.data;
        let n = request.resource.data;
        let keys = n.diff(o).affectedKeys();
        let gone = o.get('users', []).toSet().difference(n.get('users', []).toSet());
        let added = n.get('users', []).toSet().difference(o.get('users', []).toSet());
        return (added.size() == 0
              && (!groupModBlocked(o)
                  || (!keys.hasAny(['title', 'avatarUrl', 'desc', 'wallpaper', 'disappearSeconds', 'onlyAdminsSend',
                                    'membersCanAdd', 'membersCanEditInfo', 'onlyAdminsCall', 'restrictedBy',
                                    'membersCanShareLink', 'restrictRequest', 'noScreenshots', 'noForwarding', 'noSaving',
                                    'memberLabels', 'roles', 'inviteCode', 'memberSend', 'slowMode', 'hideHistoryAt'])
                      && (!keys.hasAny(['lastMessage', 'lastSender', 'lastImageUrl', 'lastImageEnc', 'lastImages'])
                          || gone.size() > 0)
                      && (!('createdBy' in keys) || !(o.get('createdBy', '') in n.get('users', [])))
                      // no pinning (an unpin, a smaller list, still works)
                      && (!('pinnedMessageIds' in keys)
                          || o.get('pinnedMessageIds', []).hasAll(n.get('pinnedMessageIds', []))))));
      }
      // 2026-10-19 group fix round S7: WHO MAY TAKE A PIN DOWN. Unpinning in a group is an admin's
      // (Pin messages, or the owner); the pin bar's Unpin shows for nobody else. A plain member's
      // only unpin is the app's automatic clean-up after a message is deleted (ChatService
      // deleteMessage -> removePinnedMessage, in every build since 2026-08-11), so that is what this
      // allows: the list may only shrink, and every id it loses is a message that is gone or a
      // tombstone. The rules cannot loop, so the old list is walked by index; the app keeps 3 pins
      // (Limits.pinnedMessagesPerChat, 5 in older builds), and a longer list is never shrunk here.
      function pinGoneOK(id) {
        return !exists(/databases/$(database)/documents/conversations/$(cid)/messages/$(id))
          || get(/databases/$(database)/documents/conversations/$(cid)/messages/$(id)).data.get('deleted', false) == true;
      }
      function memberUnpinOK() {
        let o = resource.data.get('pinnedMessageIds', []);
        let n = request.resource.data.get('pinnedMessageIds', []);
        return o is list && n is list && o.hasAll(n)
          && (n.hasAll(o)
              || (o.size() <= 6
                  && (o.size() < 1 || o[0] in n || pinGoneOK(o[0]))
                  && (o.size() < 2 || o[1] in n || pinGoneOK(o[1]))
                  && (o.size() < 3 || o[2] in n || pinGoneOK(o[2]))
                  && (o.size() < 4 || o[3] in n || pinGoneOK(o[3]))
                  && (o.size() < 5 || o[4] in n || pinGoneOK(o[4]))
                  && (o.size() < 6 || o[5] in n || pinGoneOK(o[5]))));
      }
      // 2026-10-19 group fix round S4: A PLAIN MEMBER'S PREVIEW LINE IS THEIR OWN SEND. Every send path
      // writes `lastMessage`/`lastSender` = me together with a fresh `updatedAt` (sendText, media,
      // stickers, GIFs, files, the group call row). So a write shaped like that must name the writer
      // and come from someone who may send at all (not an announcement-only group's member, not a
      // member muted from sending). The summary rewrite after a delete or an edit
      // (ChatService.rewriteSummaryGuarded) leaves `updatedAt` alone on purpose, and it may name the
      // author of the message before (somebody else, or nobody), so it is not held to this.
      function memberPreviewOK() {
        let o = resource.data;
        let n = request.resource.data;
        let keys = n.diff(o).affectedKeys();
        return !('updatedAt' in keys) || !keys.hasAny(['lastMessage', 'lastSender'])
          || (n.get('lastSender', '') == request.auth.uid
              && (o.get('onlyAdminsSend', false) == false || request.auth.uid in o.get('admins', []))
              && !restrictedIn(o, 'sendText'));
      }
      // 2026-10-19 group fix round S2/S3: WHAT "Members can add" LETS A MEMBER WRITE. Nobody the group
      // removed (`bannedUids`; lifting a ban is an admin's, the admin branch), and the mirrors and
      // badges of the people added only: `names`/`photos`/`unreadCount` keys of nobody else may move
      // (ChatService.addGroupMembers writes `names.<new>`, `photos.<new>`, `unreadCount.<new>` = 0).
      // A new badge is 0. The rules cannot read one key out of a changed set, so the values test is
      // "every number this write brings that the old map did not have is 0".
      function memberAddOK() {
        let o = resource.data;
        let n = request.resource.data;
        let added = n.users.toSet().difference(o.users.toSet());
        let ou = o.get('unreadCount', {});
        let nu = n.get('unreadCount', {});
        return added.intersection(o.get('bannedUids', []).toSet()).size() == 0
          && n.get('names', {}).diff(o.get('names', {})).affectedKeys().difference(added).size() == 0
          && n.get('photos', {}).diff(o.get('photos', {})).affectedKeys().difference(added).size() == 0
          && nu.diff(ou).affectedKeys().difference(added).size() == 0
          && nu.values().toSet().difference(ou.values().toSet()).difference([0].toSet()).size() == 0;
      }
      // A member may update the conversation. Membership (`users`) can change ONLY when:
      //   • it's unchanged as a SET (normal sends — the client rewrites order each send), OR
      //   • a group ADMIN is making the change (add/remove/promote), OR
      //   • a member is removing ONLY THEMSELVES (leaving the group).
      // The set-equal branch preserves the original 1:1 behaviour exactly.
      allow update: if signedIn() && request.auth.uid in resource.data.users
        && unreadUpdateOk()   // 2026-09-24 fix-all: badge values checked on every branch (see unreadKeyOk)
        // 2026-10-18: `deletedUsers` is written only by the account purge (admin SDK). Without this a
        // member of a 1:1 (which may write any field) could mark the other person "Deleted Account".
        && !('deletedUsers' in request.resource.data.diff(resource.data).affectedKeys())
        // 2026-10-18 group moderation: `mod` and `verified` belong to the admin panel; no branch,
        // the owner's included, writes them. And what a restricted group still allows (groupModWriteOK).
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['mod', 'verified'])
        // 2026-10-19 groups v2: Public/Private and the group's @name are server-only (setGroupUsername),
        // on every branch, the owner's included: the name and the `usernames` record must move together.
        // 2026-10-19 groups v2 step 2B: and whether a group is end-to-end encrypted (`e2ee`,
        // `e2eeOffAt`) is the server's to change (the groupsE2eeOff migration). In the same list, not
        // a line of its own: a second diff here pushed a busy admin write past the rules engine's
        // 1,000-expression ceiling (rules-tests/role-1018).
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPublic', 'username', 'usernameLower', 'joinApproval', 'e2ee', 'e2eeOffAt', 'memberSince', 'endedAt'])
        && groupModWriteOK()
        // owner 2026-10-18: the group wallpaper, groups only and a known shape (groupWallpaperOK).
        && (!('wallpaper' in request.resource.data.diff(resource.data).affectedKeys()) || groupWallpaperOK())
        // owner 2026-10-18: a member's Role, admins only and a known shape (roleWriteOK). Checked
        // here, above the branches, so no branch (the 1:1 "any field" one included) lets it by.
        && (!('roles' in request.resource.data.diff(resource.data).affectedKeys()) || roleWriteOK())
        && (
          // 1:1 ONLY (not a 2-member group): members unchanged as a SET, any field.
          (
            resource.data.get('type', '') != 'group'
            // 2026-09-24 audit: and it must STAY a 1:1. "Any field" included `type`, so one member
            // could write `type: 'group', admins: [me]` and walk into the group-admin branch below
            // (add strangers, ban the other person). `rules-tests/conversation-escalation.test.js`
            // has had this attack row since 2026-08-09 and it was still ALLOWED. No client write
            // changes a 1:1's type: a group is always a new document.
            && request.resource.data.get('type', '') != 'group'
            && resource.data.users.size() == 2
            && request.resource.data.users.hasAll(resource.data.users)
            && resource.data.users.hasAll(request.resource.data.users)
            && request.resource.data.users.size() == 2
            // ⛔ RESTRICTED CHAT: EACH PERSON'S SWITCH IS THEIR OWN (2026-10-03, the reference app's
            // private-chat rule). `restrictedBy` may change only at the writer's own key, so nobody
            // can turn off the other person's protection; they can only ask (`restrictRequest`),
            // which they may file only in their own name. The three older shared fields may only
            // be switched OFF, which the newer app does on its first write, so they cannot be used
            // to switch protection on behind the per-person keys either.
            && (!('restrictedBy' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.get('restrictedBy', {}).diff(resource.data.get('restrictedBy', {}))
                     .affectedKeys().hasOnly([request.auth.uid]))
            && (!('restrictRequest' in request.resource.data)
                || !('restrictRequest' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.restrictRequest.get('by', '') == request.auth.uid)
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['noScreenshots', 'noForwarding', 'noSaving'])
                || (request.resource.data.get('noScreenshots', false) == false
                    && request.resource.data.get('noForwarding', false) == false
                    && request.resource.data.get('noSaving', false) == false))
            // ONE MESSAGE, AND ONLY ONE. While a request is unanswered, the person who sent it may
            // not touch the fields that would let them take a second turn: `lastSender` (which the
            // message rule below reads to decide), `lastMessage`, and `accepted` (nobody accepts
            // their own request).
            //
            // NAMED AS A DENY-LIST, not an allow-list. An allow-list was here first and it refused
            // the requester's own `openConversation`, which rewrites `users`/`names`/`photos` on
            // every single open — so re-opening a chat you had sent a request into failed, silently,
            // and stopped refreshing the other person's name and face. Everything that is not on
            // this list still works: opening, blocking, muting, archiving, clearing.
            // 2026-09-27: "the person who sent it" is the one who STARTED it. Keyed on `lastSender`
            // alone, this also caught a recipient who had already replied (older builds let them
            // type into a request), so their phone could never write the `accepted` their reply
            // stood for, and the chat stayed a request forever (see `healAnsweredRequests`).
            && (
              !isRequestPending()
              || request.auth.uid != resource.data.get('startedBy', '')
              || request.auth.uid != resource.data.get('lastSender', '')
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                   'lastMessage', 'lastSender', 'lastImageUrl', 'lastImageEnc', 'lastImages',
                   'accepted', 'startedBy'
                 ])
              // owner 2026-10-18: MESSAGE REQUESTS OFF for the person asked (`requestsOnFor`), so the
              // one who started keeps writing: `lastMessage`/`lastSender` move with every send.
              // `accepted` and `startedBy` stay theirs to never write: the G1 clause below and the
              // `startedBy` pin hold whatever this says.
              || !requestsOnFor(otherExistingMember())
              || resource.data.get('reqOff', false) == true   // owner 2026-10-21
            )
            && reqOffStampOk()   // owner 2026-10-21
            // 1:1 audit r2 G1, 2026-10-08: the clause above lets the starter through while
            // `lastSender` is still empty (a fresh request), so a stranger could accept their own
            // request before sending anything and pass every call gate as a friend. Whatever
            // `lastSender` says, the person who started a pending request never writes `accepted`.
            && (
              !isRequestPending()
              || request.auth.uid != resource.data.get('startedBy', '')
              || request.resource.data.get('accepted', false) == false
              // owner 2026-10-21: unless the other member spoke first (the starter was asked).
              || resource.data.get('lastSender', '') == otherExistingMember()
            )
            // ACCEPTED IS A ONE-WAY DOOR, and `startedBy` never changes once written.
            //
            // `openConversation` decides whether a conversation is new by reading it first, and on a
            // fresh install with no cache and no network that read comes back empty for a chat that
            // exists perfectly well on the server. It would then seed `accepted: false` over an
            // accepted conversation and turn a real friendship back into a pending request, days
            // later, when the queued write finally landed. Cheap to prevent here, and impossible to
            // notice in testing.
            // ...except for Remove Friend, which is the one transition allowed back through it and
            // is checked to the key in `isUnfriend()`.
            && (
                 !(resource.data.get('accepted', false) == true
                   && request.resource.data.get('accepted', true) == false)
                 || isUnfriend()
               )
            && (resource.data.get('startedBy', '') == ''
                || request.resource.data.get('startedBy', '') == resource.data.startedBy
                || isUnfriend()
                || isCrossedOpen())   // 2026-09-24 fix-all: the second of two simultaneous openers
            // The other member cannot rewrite YOUR block, mute, clear or read state. See above.
            && privateMapsUntouched()
          )
          // Group ADMIN may change anything (membership, title, admins) — but a NON-owner admin
          // must keep the owner (createdBy) in BOTH admins and users. Only the owner can remove
          // themselves, and that goes through the self-leave branch below.
          // 2026-09-24 audit: plus the per-right check (nonOwnerAdminWriteOK) and the two floors.
          // 2026-09-24 decision D23: the owner's leave may hand `createdBy` on (ownerHandOffOK), and
          // the keep-the-owner check applies only while the owner is still a member. A group whose
          // owner left before the hand-off existed failed that check on EVERY admin write, so
          // nobody could manage it at all.
          // 2026-09-24 decision D24: admins, the owner included, are held to the same private-map
          // pin as members: no client admin write touches another member's block/mute/read state.
          || (resource.data.get('type', '') == 'group' && request.auth.uid in resource.data.admins
              && request.resource.data.get('type', '') == 'group'   // 1:1 audit r3 F1: a group stays a group
              && groupFloorsKept()
              && ownerHandOffOK()
              && privateMapsUntouched()
              && (request.auth.uid == resource.data.get('createdBy', '')
                  || ((!(resource.data.get('createdBy', '') in resource.data.users)
                       || (resource.data.get('createdBy', '') in request.resource.data.admins
                           && resource.data.get('createdBy', '') in request.resource.data.users))
                      && nonOwnerAdminWriteOK())))
          // Group NON-admin member: members unchanged AND only send/per-user fields touched
          // (cannot self-promote, rename, change type/createdBy, etc.).
          || (
            resource.data.get('type', '') == 'group'
            && request.resource.data.users.hasAll(resource.data.users)
            && resource.data.users.hasAll(request.resource.data.users)
            && request.resource.data.users.size() == resource.data.users.size()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'lastMessage', 'lastSender', 'lastImageUrl', 'lastImageEnc', 'lastImages', 'updatedAt',
                 'unreadCount', 'typing', 'lastRead', 'pinnedBy', 'mutedBy', 'archivedBy',
                 'clearedAt', 'pinOrder', 'blockedBy', 'blockedAt', 'lastPlayedVoice',
                 'lastReactionEnc', 'lastReactionBy', 'lastReactionToAuthor', 'lastReactionAt',
                 'lastReactionToEnc',
                 // 2026-10-19 groups v2: the list's "a member's words" tag (Conversation.lastPlainTag).
                 'lastPlainTag',
                 'names', 'photos', 'posters', 'pinnedMessageIds',
                 // 2026-09-24 decision D13: Mark as Unread flag, pinned to my key by privateMapsUntouched.
                 'markedUnread'
               ])
            // owner 2026-10-18: no Member Label here any more. A member's tag is now a Role, which
            // only an admin gives (roleWriteOK), so a plain member writes neither `memberLabels`
            // nor `roles`.
            // names/photos/posters are the per-member profile mirrors every chat list reads.
            // A member may refresh THEIR OWN entry only — the map diff is pinned to their uid,
            // so nobody can rewrite another member's name or face. Without this branch a plain
            // member's profile-photo save was refused here, and because the app fanned it out in
            // one atomic batch, one group refusal failed the save for every conversation.
            && (!('names' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.get('names', {}).diff(resource.data.get('names', {})).affectedKeys().hasOnly([request.auth.uid]))
            && (!('photos' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.get('photos', {}).diff(resource.data.get('photos', {})).affectedKeys().hasOnly([request.auth.uid]))
            && (!('posters' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.get('posters', {}).diff(resource.data.get('posters', {})).affectedKeys().hasOnly([request.auth.uid]))
            // A member may only ever say what THEY have heard. Pinned here, on the same shape as the
            // three above, rather than by adding `lastPlayedVoice` to `privateMapsUntouched()` — this
            // branch does not call that function at all.
            //
            // 2026-09-24 audit, the group copies of the private maps: Before this line a plain group member could write
            // another member's `lastRead`, `mutedBy`, `pinnedBy`, `archivedBy`, `clearedAt`,
            // `pinOrder` or `blockedBy`/`blockedAt` (forge their read receipt, mute them, wipe their
            // copy). Every client write to those maps was checked (ChatService markRead, setPinned,
            // setPinOrder, setArchived, setMuted, setMute, setBlocked, deleteForMe,
            // flushVoicePlayed): each writes `[uid: ...]`,
            // the caller's own key, and nothing else. So the 1:1 pin applies here unchanged.
            && privateMapsUntouched()
            && (!('lastPlayedVoice' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.get('lastPlayedVoice', {}).diff(resource.data.get('lastPlayedVoice', {})).affectedKeys().hasOnly([request.auth.uid]))
            // A member may REMOVE pins, never add. The one honest need is the client's automatic
            // unpin when a member's own pinned message is deleted for everyone — without this the
            // arrayRemove was refused and a ghost pin pointed at the tombstone in everyone's bar
            // (found 2026-08-11). The rules cannot see WHICH id left a list diff, so authorship of
            // the unpinned message is not checkable here; the boundary is subset-and-smaller
            // instead: the new list must be contained in the old and strictly shorter, so nothing
            // can ever be pinned through this branch. Pinning stays admin-only, as the UI promises.
            // 2026-09-24 fix-all: SUBSET ONLY, no longer "and strictly shorter". Two devices unpinning
            // at once, or an unpin on a chat whose list was never written (the `arrayRemove` then
            // creates it empty), changed nothing, and the strict test refused that no-op. A subset
            // still can never pin anything.
            // 2026-10-19 group fix round S7: and only the clean-up unpin after a delete (memberUnpinOK).
            && (!('pinnedMessageIds' in request.resource.data.diff(resource.data).affectedKeys())
                || memberUnpinOK())
            && memberPreviewOK()   // 2026-10-19 group fix round S4: a send's preview is the writer's own
          )
          // Group NON-admin may EDIT INFO only when the admin enabled membersCanEditInfo.
          || (
            resource.data.get('type', '') == 'group'
            && resource.data.get('membersCanEditInfo', false) == true
            && request.resource.data.users.hasAll(resource.data.users)
            && resource.data.users.hasAll(request.resource.data.users)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'avatarUrl', 'desc', 'wallpaper', 'updatedAt'])
            && !restrictedIn(resource.data, 'changeInfo')   // 2026-09-24 fix-all: the per-member flag
          )
          // Group NON-admin may ADD members (only additions, max group_members_max) when membersCanAdd is on.
          || (
            resource.data.get('type', '') == 'group'
            && resource.data.get('membersCanAdd', false) == true
            && request.resource.data.users.hasAll(resource.data.users)
            && request.resource.data.users.size() > resource.data.users.size()
            && request.resource.data.users.size() <= appLimit('group_members_max', 30)
            // 2026-09-24 fix-all: plus the "X added Y" preview (`lastMessage`, `lastSender` = me), which
            // `addGroupMembers` now writes in the same batch as the add, so the two cannot disagree.
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['users', 'names', 'photos', 'unreadCount', 'updatedAt',
                 'lastMessage', 'lastSender'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage', 'lastSender'])
                || request.resource.data.get('lastSender', '') == request.auth.uid)
            && !restrictedIn(resource.data, 'addMembers')   // 2026-09-24 fix-all: the per-member flag
            && memberAddOK()   // 2026-10-19 group fix round S2/S3: no banned uid, only the new people's keys
          )
          // Any group member may remove ONLY themselves (leave).
          //
          // ⚠️ 2026-09-24 audit: THIS BRANCH HAD NO FIELD LIST. It checked the `users` array and
          // nothing else, so the same write that took a plain member out of the group could also
          // rename it, rewrite `admins`, change `type`/`createdBy`, or set restrictions on the
          // members who stayed. Now it may touch only what `ChatService.leaveGroup` writes: `users`,
          // `admins`, `updatedAt`, and the "X left" preview (`lastMessage`, `lastSender` = me).
          // `admins` may only lose the leaver, with ONE exception the client relies on: the LAST
          // admin leaving hands the group to exactly one remaining member (`admins = [heir]`).
          // (Every other admin leave already passes the admin branch above.)
          || (
            resource.data.get('type', '') == 'group'
            && resource.data.users.hasAll(request.resource.data.users)
            && !(request.auth.uid in request.resource.data.users)
            && resource.data.users.size() == request.resource.data.users.size() + 1
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['users', 'admins', 'updatedAt', 'lastMessage', 'lastSender'])
            && request.resource.data.get('lastSender', '') in [request.auth.uid, resource.data.get('lastSender', '')]
            && (request.resource.data.get('admins', []).toSet()
                  == resource.data.get('admins', []).toSet().difference([request.auth.uid].toSet())
                || (resource.data.get('admins', []).hasOnly([request.auth.uid])
                    && request.resource.data.get('admins', []).size() == 1
                    && request.resource.data.get('admins', [])[0] in request.resource.data.users))
            // 2026-09-24 audit: the plain removal above also matched the LAST admin removing
            // themselves with no heir, leaving the group with nobody to run it.
            && groupFloorsKept()
          )
        );
      // DELETE exists only for declining a request. An accepted conversation still cannot be deleted
      // by anyone (that is what "delete for me" and `clearedAt` are for) — so this can remove an
      // unwanted request and nothing else.
      allow delete: if signedIn()
        && request.auth.uid in resource.data.users
        && resource.data.get('type', '') != 'group'
        && resource.data.get('startedBy', '') != ''
        && resource.data.get('accepted', false) == false
        // ⛔ AND ONLY BY THE PERSON WHO WAS ASKED — owner's spec, 2026-09-11 §14 and §28. Declining
        // is the recipient's answer, and the app has never offered the requester a delete. The
        // hole this closes: the requester could delete their own unanswered request and open a
        // fresh one at the same id — a second message by another name — and, since the block
        // lives on this document, delete a block along with it and knock on the person who had
        // blocked them. `startedBy` is the one who has to ask (Remove Friend sets it too).
        && request.auth.uid != resource.data.get('startedBy', '');

      // 2026-09-24 decision D8: the paragraph below STANDS for the account block list too
      // (users/{blocker}/blocked/{sender}): the write lands, the blocker's app hides it and the push
      // function skips it. Only /calls create refuses (see `isBlockedByUser`).
      // Messages: only the two members. Blocking is SILENT — a blocked person's
      // message still writes (it looks "sent" to them), but the blocker's client
      // hides it and the push function skips their notification. You may delete
      // only your own message.
      match /messages/{mid} {
        // 2026-09-24 feature-audit: THE GROUP ADMIN'S "Delete messages" RIGHT. The owner could switch
        // it on for an admin and nothing honoured it. Same test as `adminCan` on the client: the
        // owner always; an admin with no `adminRights` entry always (legacy full admin); an admin
        // with an entry only when it lists 'deleteMessages'. Only in a group, and a limited admin
        // may not remove the OWNER's messages. Grants the tombstone only, never the hard delete.
        function adminDeletesMessage() {
          let c = convData();
          return c.get('type', '') == 'group'
            && (request.auth.uid == c.get('createdBy', '')
                || (request.auth.uid in c.get('admins', [])
                    && resource.data.get('authorId', '') != c.get('createdBy', '')
                    && (!(request.auth.uid in c.get('adminRights', {}))
                        || 'deleteMessages' in c.get('adminRights', {})[request.auth.uid])));
        }
        // 2026-09-24 audit: the CALLEE's fallback call record. `ChatService.recordCall` always
        // writes `authorId` = the caller (one deterministic author for the row both phones merge
        // into), so when the caller's phone never wrote the live row and the callee's phone is the
        // first writer, the plain author check refused it and the call left no record at all. A
        // call record at its own `call_<callId>` id, carrying only the call-record keys, may be
        // created by either member provided it names a member as the caller and the author.
        function isCallRecordForMember() {
          return request.resource.data.get('type', '') == 'call'
            && mid.matches('call_.+')
            && request.resource.data.get('callerUid', '') in convData().users
            && request.resource.data.authorId == request.resource.data.callerUid
            && request.resource.data.get('text', '') == ''
            && request.resource.data.keys().hasOnly([
                 'type', 'authorId', 'callerUid', 'callOutcome', 'callVideo', 'text', 'createdAt'
               ]);
        }
        // 2026-09-24 decision D-composer-3: a ceiling on `text` for EVERY message, not only a
        // request's first one. The app stops at 65,536 UTF-16 units (Limits.messageMaxChars), at
        // most 196,608 UTF-8 bytes; sealed for a full 1,024-member group (every member's key wrap
        // rides inside the same string) that is about 534,000 characters, and a 1:1 seal about
        // 262,000. 700,000 clears the largest legitimate message with room and still refuses
        // anything near the 1 MiB document ceiling.
        function textWithinCap() {
          return !('text' in request.resource.data)
            || (request.resource.data.text is string
                && request.resource.data.text.size() <= 700000);
        }
        // 2026-10-19 groups v2 (owner): GROUPS STOP END-TO-END ENCRYPTION for new messages. A group
        // whose document says `e2ee == false` (server-written, see the conversation rules) takes text
        // in the clear, held to the app's own ceiling (Limits.messageMaxChars, 65,536) instead of the
        // sealed one. Sealed envelopes ("encg1:", "enc1:") stay allowed there: older builds keep
        // sealing and every phone still opens them. A group that has NOT switched still takes only a
        // sealed text on an ordinary message (no `type`), so no phone puts plain words into a chat
        // that still promises end-to-end encryption. Notices and other typed messages are as before.
        // 1:1 chats are untouched.
        // ⛔ WHAT MEMBERS MAY SEND — owner 2026-10-19/20: a switch for each kind. `memberSend` on
        // the group: {photos, videos, voice, files, stickers, gifs, links, polls, location}, a
        // missing key or true = allowed. Admins are never limited; notices always pass. Types:
        // image = photos, video = videos, album = both, audio = voice, file, sticker, gif. Polls:
        // `pollMulti` is in the clear on every poll. Links and locations: a link card, or a
        // plain-text group message (an end-to-end encrypted group's text cannot be read here, so
        // there the app alone holds links, polls and locations back).
        function groupSendRestrictOk() {
          let c = convData();
          let d = request.resource.data;
          let t = d.get('type', '');
          return !(request.auth.uid in c.get('restrictedFlags', {}))
            || ((!restrictedIn(c, 'sendText') || leaveNotice())
            && (!(t in ['image', 'album', 'video', 'file'] || 'linkPreview' in d) || !restrictedIn(c, 'sendMedia'))
            && (!(t in ['image', 'album', 'video']) || !restrictedIn(c, 'sendPhotos'))
            && (t != 'file' || !restrictedIn(c, 'sendFiles'))
            && (!('linkPreview' in d) || !restrictedIn(c, 'sendLinks'))
            && (t != 'audio' || !restrictedIn(c, 'sendVoice'))
            && (!(t in ['gif', 'sticker']) || !restrictedIn(c, 'sendStickers')));
        }
        function memberSendOk() {
          let d = request.resource.data;
          let ms = convData().get('memberSend', {});
          let t = d.get('type', '');
          let txt = d.get('text', '');
          let plain = txt is string;
          return convData().get('type', '') != 'group'
            || request.auth.uid in convData().get('admins', [])
            || t == 'system' || leaveNotice()
            || ((!(t in ['image', 'album']) || ms.get('photos', ms.get('media', true)) != false)
                && (!(t in ['video', 'album']) || ms.get('videos', ms.get('media', true)) != false)
                && (t != 'audio' || ms.get('voice', true) != false)
                && (t != 'file' || ms.get('files', true) != false)
                && (t != 'sticker' || ms.get('stickers', true) != false)
                && (t != 'gif' || ms.get('gifs', true) != false)
                && (!('pollMulti' in d) || ms.get('polls', true) != false)
                && (ms.get('location', true) != false || !(plain && txt.matches('fariin-location:.*')))
                && (ms.get('links', true) != false
                    || (!('linkPreview' in d)
                        && !(plain && txt.matches('(?si).*(https?://|www[.]).*')))));
        }
        function groupTextOk() {
          let d = request.resource.data;
          let t = d.get('text', '');
          return convData().get('type', '') != 'group'
            || !(t is string) || t.size() == 0
            || t.matches('encg?1:.*')
            || (convData().get('e2ee', true) == false && t.size() <= 65536)
            || (convData().get('e2ee', true) != false && 'type' in d);
        }
        // 2026-09-24 decision D-composer-3: a media address is a string, https (or the app's own
        // `sticker://` for a built-in sticker, see BuiltInStickers.scheme), and a sane length. Storage
        // download addresses run to a few hundred characters; GIF-service addresses less.
        function mediaUrlOk(k) {
          return !(k in request.resource.data)
            || (request.resource.data[k] is string
                && request.resource.data[k].size() <= 2048
                && request.resource.data[k].matches('(https|sticker)://.+'));
        }
        function mediaUrlsOk() {
          return mediaUrlOk('imageUrl') && mediaUrlOk('videoUrl') && mediaUrlOk('audioUrl')
            && mediaUrlOk('fileUrl') && mediaUrlOk('thumbUrl');
        }
        // 2026-09-24 feature-audit: the link card gets the same limits as its siblings. It is a map
        // (ChatService.sealLinkPreview): `url` sealed and required, `title`/`desc` sealed and
        // optional, each under the ceiling `text` has; `imageUrl` an https address like every other
        // media field; `imageEnc` the image's key map. Nothing else rides inside it.
        function sealedOk(lp, k) {
          return !(k in lp) || (lp[k] is string && lp[k].size() <= 700000);
        }
        function linkPreviewOk() {
          let lp = request.resource.data.get('linkPreview', {});
          return !('linkPreview' in request.resource.data)
            || (request.resource.data.linkPreview is map
                && lp.keys().hasOnly(['url', 'title', 'desc', 'imageUrl', 'imageEnc'])
                && lp.get('url', null) is string
                && sealedOk(lp, 'url') && sealedOk(lp, 'title') && sealedOk(lp, 'desc')
                && (!('imageUrl' in lp)
                    || (lp.imageUrl is string && lp.imageUrl.size() <= 2048
                        && lp.imageUrl.matches('https://.+')))
                && (!('imageEnc' in lp) || lp.imageEnc is map));
        }
        // 2026-10-17 (owner, chat stickers): the four plain sticker fields. A built-in sticker is
        // drawn by every phone from its own copy of the pack, so the message carries only which one
        // (`stickerPack` + `stickerId`), the emoji it stands for and whether it moves. Public art,
        // not a secret, so not sealed; a sticker I made rides `imageUrl` + `enc` like a photo.
        // Each field only on a `sticker`, each a short string (or a bool), nothing else.
        function stickerShapeOk() {
          let d = request.resource.data;
          let isSticker = d.get('type', '') == 'sticker';
          return (isSticker
              ? (d.get('stickerPack', null) is string && d.stickerPack.size() > 0 && d.stickerPack.size() <= 64
                 && d.get('stickerId', null) is string && d.stickerId.size() > 0 && d.stickerId.size() <= 128
                 && (!('emoji' in d) || (d.emoji is string && d.emoji.size() <= 32))
                 && (!('animated' in d) || d.animated is bool))
              : !d.keys().hasAny(['stickerPack', 'stickerId', 'emoji', 'animated']));
        }
        // 2026-09-24 feature-audit: A VOICE NOTE'S SHAPE. `duration` and `waveform` were the two
        // attachment fields with no check at all. The recorder stops at 30 minutes (1,800s), so a
        // voice note's duration is a number from 0 to 1,900 (margin); other kinds (video) keep
        // theirs unchecked here. The waveform is a list of at most 256 bars (the app sends 64 at
        // most); the rules language cannot loop, so each bar's type is not checked. A one-time voice
        // note carries NO waveform (absent or empty), the invariant `sendAudio` states and keeps.
        function voiceShapeOk() {
          let d = request.resource.data;
          return (!('waveform' in d) || (d.waveform is list && d.waveform.size() <= 256))
            && (d.get('type', '') != 'audio'
                || ((!('duration' in d)
                     || (d.duration is number && d.duration >= 0 && d.duration <= 1900))
                    && (d.get('viewOnce', false) != true || d.get('waveform', []).size() == 0)));
        }
        // 2026-09-24 feature-audit: WHEN AN EDIT MAY LAND. The client's 15-minute window
        // (`Limits.editWindowSeconds`) was only ever a menu condition, so any authored message could
        // be rewritten at any age by a client that skipped the menu. Now the server asks the same
        // three questions: not a tombstone (an edit queued before a Delete for Everyone would put
        // live text back into the scrubbed document), still inside the window measured from the
        // message's own server `createdAt` (900s + 120s clock margin; keep in sync with Limits.swift),
        // and the author not restricted from sending text (a muted member cannot rewrite what they
        // already said either).
        function editAllowedNow() {
          return resource.data.get('deleted', false) == false
            // 2026-09-29, owner: a forwarded message is never edited (its words are not mine).
            && resource.data.get('forwarded', false) == false
            && resource.data.get('createdAt', null) is timestamp
            && request.time < resource.data.createdAt + duration.value(1020, 's')
            && request.resource.data.get('edited', false) == true
            && !restrictedIn(convData(), 'sendText');
        }
        // 2026-09-24 feature-audit: EDIT HISTORY, like the reference app. `edits` holds the previous
        // sealed texts, oldest first, at most 10, each {t: the sealed text it replaced, at: when that
        // version was written}. An edit may only APPEND the text being replaced, keeping a tail of
        // the old list (the client drops the oldest when the cap or the document size needs it);
        // nothing already in the history can be rewritten. `editedAt` is the server time of the edit.
        // An edit that leaves `edits` untouched (builds before this one) is still accepted.
        function editHistoryOk() {
          let old = resource.data.get('edits', []);
          let neu = request.resource.data.get('edits', []);
          let k = neu.size() - 1;
          return (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['edits'])
                  || (neu is list && old is list
                      && neu.size() >= 1 && neu.size() <= 10 && k <= old.size()
                      && neu[k] is map
                      && neu[k].keys().hasOnly(['t', 'at'])
                      && neu[k].get('t', null) == resource.data.get('text', '')
                      && neu[k].get('at', null) is timestamp
                      && neu[k].at < request.time + duration.value(5, 'm')   // a phone clock may run ahead
                      // (an empty slice errors in the rules engine, so k == 0 is its own case)
                      && (k == 0 || neu[0:k] == old[old.size() - k:old.size()])))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['editedAt'])
                || request.resource.data.editedAt == request.time);
        }
        // 2026-10-19 group fix round S1/M1: GROUP NOTICES (`type: "system"`, the grey centred lines).
        // Every notice is signed by its writer (`authorId` = me, the create rule's first test; the call
        // record exemption is `type: "call"` only), and the app names the author on the line. In a
        // group a notice also needs a reason to exist, one per client path that writes one
        // (ChatService): an admin or the owner (rename, photo, admins, restrictions, settings,
        // remove, transfer, "created the group"); "Members can edit info" on (rename and wallpaper by
        // a member, a separate write before its notice); a member's add in the same batch
        // (addGroupMembers, the list grows); or my own leave in the same transaction (leaveGroup,
        // "X left" plus "now an admin / the owner"). `getAfter` sees that batch's result; it is read
        // only for a notice, so a plain send costs nothing more.
        function isNotice() {
          return request.resource.data.get('type', '') == 'system';
        }
        function convAfter() {
          return getAfter(/databases/$(database)/documents/conversations/$(cid)).data;
        }
        // A notice written in the same transaction as the writer's own leave.
        function leaveNotice() {
          return isNotice() && convData().get('type', '') == 'group'
            && !(request.auth.uid in convAfter().get('users', []));
        }
        // An admin's notice written in the same batch as a removal (removeGroupMember).
        function removeNotice() {
          return isNotice() && convData().get('type', '') == 'group'
            && request.auth.uid in convData().get('admins', [])
            && convAfter().get('users', []).size() < convData().users.size();
        }
        function groupNoticeOK() {
          let c = convData();
          return !isNotice() || c.get('type', '') != 'group'
            || request.auth.uid in c.get('admins', []) || request.auth.uid == c.get('createdBy', '')
            || c.get('membersCanEditInfo', false) == true
            || convAfter().get('users', []).size() > c.users.size()
            || !(request.auth.uid in convAfter().get('users', []));
        }
        // ⛔ A PUBLIC GROUP'S MESSAGES, READ FROM OUTSIDE — owner 2026-10-21 (messages before
        // joining): tapping a public group I am not in opens its real chat with Join at the bottom.
        // Only when every one of these holds: a group, public (`isPublic`, server-written), sent in
        // the clear (`e2ee == false`; an old end-to-end group's text means nothing to an outsider
        // anyway), history not hidden from newcomers (`hideHistoryAt` absent or 0: hidden history
        // means no preview), not ended by its owner (`endedAt` absent or 0), not suspended or
        // disabled by Fariin, and the reader not banned from it. READ ONLY, and only the messages:
        // the conversation document stays members-only (invite codes, unread maps, names), so the
        // app takes the header from `publicGroupPreview`. Votes under a message stay members-only.
        function publicPreviewRead() {
          let c = convData();
          let gm = c.get('mod', {});
          return c.get('type', '') == 'group'
            && c.get('isPublic', false) == true
            && c.get('e2ee', true) == false
            && !(request.auth.uid in c.get('bannedUids', []))
            && (c.get('hideHistoryAt', 0) == 0 || c.get('hideHistoryAt', 0) == null)
            && (c.get('endedAt', 0) == 0 || c.get('endedAt', 0) == null)
            && gm.get('state', 'ok') != 'disabled'
            && !(gm.get('state', 'ok') == 'suspended'
                 && (gm.get('until', null) == null || gm.get('until', null) > request.time));
        }
        allow read: if signedIn() && (request.auth.uid in convData().users || publicPreviewRead());
        allow create: if signedIn()
          && (request.auth.uid == request.resource.data.authorId || isCallRecordForMember())
          && request.auth.uid in convData().users
          // 2026-09-24 decision D8: no block check at write time, on purpose (silent block, see the
          // note above this match).
          // ⛔ `expiresAt` BELONGS TO THE SERVER. It is the disappearing-message timer, written by
          // `onNewMessage` out of the conversation's own `disappearSeconds` the moment a message
          // lands, and swept by `cleanupExpiringMessages`. A client that could set it could send a
          // message into a chat with a timer on and give it any lifetime it liked — including one
          // in the year 3000, which is a message that never disappears in a chat that promises it
          // will. Refusing it at create is what makes the field's presence proof the server put it
          // there. Every UPDATE branch below is an affectedKeys whitelist and none of them names
          // it, so it cannot be changed afterwards either.
          && !('expiresAt' in request.resource.data)
          // 2026-09-24 feature-audit: a message is born with no edit history, and with a `createdAt`
          // that is not in the future. The edit window is measured from `createdAt`, so a forged
          // far-future time would have been an edit window that never closed.
          && !request.resource.data.keys().hasAny(['edits', 'editedAt'])
          // ⛔ A STORY MENTION ONLY INTO A CHAT THAT ALREADY EXISTS — owner 2026-10-16: "mentioning
          // someone in my story must not message people I have never chatted with, and must not
          // create a chat". `exists`/`get` read the state BEFORE this write (and before the batch
          // that would create the conversation), so a mention can neither open a chat nor knock on
          // a request. Existing means `isFriendOf`'s rule: an accepted 1:1, or an older chat that
          // carries a message, between exactly these two people, not a group.
          && (!('storyMention' in request.resource.data)
              || (cid.matches('.+_.+')
                  && exists(/databases/$(database)/documents/conversations/$(cid))
                  && get(/databases/$(database)/documents/conversations/$(cid)).data.get('type', '') != 'group'
                  && get(/databases/$(database)/documents/conversations/$(cid)).data.get('users', []).size() == 2
                  && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.get('users', [])
                  && (get(/databases/$(database)/documents/conversations/$(cid)).data.get('startedBy', '') != ''
                        ? get(/databases/$(database)/documents/conversations/$(cid)).data.get('accepted', false) == true
                        : get(/databases/$(database)/documents/conversations/$(cid)).data.get('lastMessage', '') != '')))
          && (!('createdAt' in request.resource.data)
              || !(request.resource.data.createdAt is timestamp)
              || request.resource.data.createdAt < request.time + duration.value(2, 'm'))
          // ⛔ "Allow replies" OFF NOW STOPS A REPLY, AND IT ONLY EVER HID OUR OWN BUTTON.
          //
          // A story reply is an ordinary 1:1 message carrying `replyTo.isStatus == true` and the
          // story's id. `allowsReplies` was read in exactly one place — whether to draw the reply
          // bar — so the author's switch was advice to our own UI and nothing else: any client could
          // send the reply anyway, and it arrived quoting the story as though it had been invited.
          // The reaction path was closed for the same reason months ago; this is the other half.
          //
          // ⚠️ AN EXPIRED STORY IS NOT A REFUSAL. The document is gone within 24 hours while a
          // failed message can be retried after it, so a missing story reads as "no rule to apply"
          // rather than as no. The quote already draws itself as expired in that case.
          && (
               request.resource.data.get('replyTo', {}).get('isStatus', false) != true
               || !(request.resource.data.replyTo.id is string)
               || !exists(/databases/$(database)/documents/stories/$(request.resource.data.replyTo.id))
               || get(/databases/$(database)/documents/stories/$(request.resource.data.replyTo.id))
                    .data.get('allowsReplies', true) == true
             )
          // 2026-09-24 decision D-composer-3: text size and media-address shape, on every message.
          && textWithinCap()
          && groupTextOk()     // 2026-10-19 groups v2: plain text only in a group that switched
          && mediaUrlsOk()
          && linkPreviewOk()   // 2026-09-24 feature-audit: the card's own fields
          && voiceShapeOk()    // 2026-09-24 feature-audit: duration, waveform, one-time = no waveform
          && groupNoticeOK()   // 2026-10-19 group fix round S1: a group notice needs its reason
          && memberSendOk()    // 2026-10-19 what members may send (photos, voice, files, stickers, links)
          // Announcement mode: when onlyAdminsSend is set, only admins may create messages.
          // 2026-10-19 group fix round M1: LEAVING ALWAYS WORKS. The leave transaction's own notices
          // ("X left", the heir lines) are refused by the three send gates below for a member of an
          // announcement-only group, a muted member and anyone in a suspended group, and with them
          // the whole leave, in every build. A notice in the same transaction as my own leave passes
          // them; so does an admin's removal notice in a suspended group (removeGroupMember).
          && (convData().get('onlyAdminsSend', false) == false
              || request.auth.uid in convData().get('admins', [])
              || leaveNotice())
          // 2026-10-18 group moderation: nobody sends into a suspended or disabled group.
          && (!groupModBlocked(convData()) || leaveNotice() || removeNotice())
          // A pending request carries ONE message. `lastSender` is empty until the request is sent,
          // so the first message passes; after that only the RECIPIENT may write, and their reply is
          // itself the acceptance. The requester's second attempt is refused here, by the database.
          && (
               convData().get('startedBy', '') == ''
               || convData().get('accepted', false) == true
               || convData().get('lastSender', '') == ''
               || convData().get('lastSender', '') != request.auth.uid
               // owner 2026-10-18: MESSAGE REQUESTS OFF for the other person: no one-message wait.
               // Their Chat Key setting still holds, for a chat that is not open yet.
               || reqOffMayWrite(otherHalf())
               || reqOffChatMayWrite(otherHalf())   // owner 2026-10-21
             )
          // A REQUEST IS ONE SHORT TEXT — owner's spec, 2026-09-11 §9, and the database says so.
          //
          // The one message a pending conversation accepts may carry no media of any kind: none of
          // the keys a photo, album, voice note, video, file, sticker, GIF, call record or link card
          // is written with. `type` is absent on a text message and present on every other, so its
          // absence is required outright rather than compared.
          //
          // THE LENGTH IS A BYTE CAP ON THE CIPHER, NOT A CHARACTER COUNT. The text is end-to-end
          // encrypted and the server cannot see a single character of it. What it CAN measure is
          // the sealed string: "enc1:" + a 24-byte nonce + a 16-byte MAC + the UTF-8 of the
          // message, base64'd. 150 characters of the widest UTF-8 (4 bytes each) seals to 862
          // characters, so 880 lets every legitimate 150-character message through — including
          // 150 emoji — and refuses a patched client's essay. The app counts the 150 itself.
          //
          // The other person's privacy is checked again here: Remove Friend reopens a chat without a create.
          && (
               !isPendingFirstMessage()
               || (
                    // owner 2026-10-18: the short-text shape is a REQUEST's; with Message Requests
                    // off for the other person the first message may be anything a chat carries.
                    (reqOffMayWrite(otherHalf())
                    || reqOffChatMayWrite(otherHalf())   // owner 2026-10-21
                    || (
                      request.resource.data.text is string
                      && request.resource.data.text.size() <= 880
                      && !request.resource.data.keys().hasAny([
                           'type', 'imageUrl', 'audioUrl', 'videoUrl', 'fileUrl', 'fileName',
                           'fileSize', 'album', 'albumSizes', 'thumb', 'thumbUrl', 'thumbEnc',
                           'blurhash', 'width', 'height', 'duration', 'waveform', 'viewOnce',
                           'callerUid', 'callOutcome', 'linkPreview', 'sticker', 'gif', 'location',
                           'poll', 'contact'
                         ])
                    // ...their privacy, unless the panel has the Chat Key requirement off. The
                    // day's knock budget below holds in every mode.
                      && strangersMayWrite(otherHalf())
                    ))
                    // ...and not more knocks today than `requests_per_day_default` (20, or the
                    // number in `config/limits`). FAILS OPEN when the counter was never written,
                    // as the story limits do.
                    && (
                         !exists(/databases/$(database)/documents/users/$(request.auth.uid)/limits/requests)
                         || requestBudget().get('windowStart', request.time) < request.time - duration.value(24, 'h')
                         || requestBudget().get('count', 0) < appLimit('requests_per_day_default', 20)
                       )
                  )
             )
          // Restricted member (the reference app's timed mute): a member whose restrictedFlags contains
          // 'sendText' with restrictedUntil still in the future cannot create ANY message. Admins and
          // the owner are ALWAYS exempt in-rule (so a rogue admin can't grief a co-admin/owner by
          // writing a restriction for them). Auto-lifts when the timeout passes.
          // A muted member's send flags (Conversation.Restrict): photo/album/video/file/link card →
          // sendMedia (and sendPhotos/sendFiles/sendLinks), voice → sendVoice, gif/sticker →
          // sendStickers, all else sendText. Groups only: a 1:1 has no restrictions (2026-10-20,
          // under the 1,000-expression limit).
          && (convData().get('type', '') != 'group' || groupSendRestrictOk())
          && stickerShapeOk();
        // Participants may edit reactions; the AUTHOR may also edit their own text, and rewrite their
        // own album array (deleting ONE album item for everyone = removing it from the album; the
        // client deletes the whole message when the last item goes).
        // 2026-09-24 audit: a reaction edit may change ONLY THE CALLER'S OWN KEY in `reactions`.
        // Before, the check stopped at "only the `reactions` field changed", so any member could
        // rewrite the whole map on anyone's message: invent a reaction in somebody else's name, or
        // wipe everyone else's. `ChatService.setReaction` only ever writes `reactions.<my uid>`
        // (set or delete); the author's delete-for-everyone clears the map through its own branch
        // below, not this one.
        allow update: if signedIn()
          && request.auth.uid in convData().users
          // 2026-10-18 group moderation: in a suspended or disabled group nobody edits or reacts.
          // Delete for Everyone (the tombstone, `deleted: true`) and the call-row and upload
          // branches still pass: none of them adds anything new to read.
          && (!groupModBlocked(convData())
              || !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['reactions', 'text', 'edited', 'edits', 'editedAt'])
              || request.resource.data.get('deleted', false) == true)
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
             && ownKeyOnly('reactions')
             // 2026-09-24 fix-all: `sendReactions` restricts ADDING or changing a reaction; taking my
             // own back stays allowed.
             && (!(request.auth.uid in request.resource.data.get('reactions', {}))
                 || !restrictedIn(convData(), 'sendReactions'))
             // 2026-09-24 feature-audit: my key is absent or a STRING of bounded size. Not "16
             // characters": the value is the SEALED emoji (`setReaction` writes enc1:/encg1:), and a
             // group seal carries one key wrap per member (Crypto.encryptForGroup, about 175
             // characters each, 303 at the worst base64 escaping), so the cap scales with the
             // member count: 600 + 320 per member. A 1:1 seal is about 110.
             && (!(request.auth.uid in request.resource.data.get('reactions', {}))
                 || (request.resource.data.reactions[request.auth.uid] is string
                     && request.resource.data.reactions[request.auth.uid].size()
                          <= 600 + 320 * convData().users.size())))
            || (request.auth.uid == resource.data.authorId
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['text', 'edited', 'edits', 'editedAt'])   // 2026-09-24 feature-audit: + history
                && textWithinCap()   // 2026-09-24 decision D-composer-3: an edit has the same ceiling
                && groupTextOk()     // 2026-10-19 groups v2: and plain words only where a send may
                && editAllowedNow()  // 2026-09-24 feature-audit: tombstone, window, restriction
                && editHistoryOk())  // 2026-09-24 feature-audit: append-only history
            || (request.auth.uid == resource.data.authorId
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['album']))
            // 2026-10-19 polls: the poll's creator stops it (`pollClosed`, once, never reopened).
            || (request.auth.uid == resource.data.authorId
                && 'pollMulti' in resource.data
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pollClosed'])
                && request.resource.data.pollClosed == true)
            // FINISHING AN UPLOAD. A photo message is now written the moment Send is tapped,
            // carrying its blurhash and size but no media yet, so the recipient sees a real bubble
            // immediately instead of nothing until the whole upload lands. This branch is how the
            // author attaches the media afterwards.
            //
            // It is deliberately a ONE-WAY DOOR and cannot be used to edit a delivered message:
            //   - only the author
            //   - only while the stored doc still says uploading == true
            //   - and the update must CLEAR that flag
            // So it is usable exactly once, on a message that has been waiting for its media since
            // the instant it was created. Swapping the picture on an old message is not reachable:
            // that message's `uploading` is already gone, and nothing may set it back.
            || (request.auth.uid == resource.data.authorId
                && resource.data.get('uploading', false) == true
                && request.resource.data.get('uploading', false) == false
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['imageUrl', 'enc', 'album', 'uploading',
                               'audioUrl', 'fileUrl', 'videoUrl', 'thumbUrl', 'thumbEnc'])
                && mediaUrlsOk())   // 2026-09-24 decision D-composer-3: the attached address too
            // "Delete for Everyone": the AUTHOR may turn their own message into a tombstone -
            // deleted:true, text emptied, type back to 'text', every content field REMOVED.
            // The end state is pinned (no content key may remain and text/type are fixed), so
            // this branch cannot be used to edit a message into anything except the marker.
            // Without it the app's tombstone write was refused and fell back to a hard delete,
            // so "deleted" messages vanished instead of leaving the placeholder.
            // 2026-09-24 feature-audit: OR a group admin holding "Delete messages", on the same
            // pinned end state (see `adminDeletesMessage`). Never a call row. The admin signs it
            // (`deletedBy` = the caller) so the author is not shown "You deleted this message"; the
            // author's own tombstone carries no `deletedBy`.
            || (((request.auth.uid == resource.data.authorId
                  && !('deletedBy' in request.resource.data))
                 || (adminDeletesMessage() && resource.data.get('type', '') != 'call'
                     && request.resource.data.get('deletedBy', '') == request.auth.uid))
                && request.resource.data.get('deleted', false) == true
                && request.resource.data.get('text', '-') == ''
                && request.resource.data.get('type', '-') == 'text'
                && !request.resource.data.keys().hasAny(
                     ['enc', 'imageUrl', 'videoUrl', 'thumbUrl', 'audioUrl', 'fileUrl', 'album',
                      'fileName', 'fileSize', 'waveform', 'duration', 'blurhash', 'thumb',
                      'linkPreview', 'poll', 'locationCard', 'contactCard', 'replyTo', 'reactions',
                      'videoEnc', 'thumbEnc', 'viewOnce', 'mentions', 'forwarded',
                      'edits'])   // 2026-09-24 feature-audit: the edit history is content too
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                     ['deleted', 'text', 'type', 'enc', 'imageUrl', 'videoUrl', 'thumbUrl',
                      'audioUrl', 'fileUrl', 'album', 'fileName', 'fileSize', 'waveform',
                      'duration', 'blurhash', 'thumb', 'linkPreview', 'poll', 'locationCard',
                      'contactCard', 'replyTo', 'reactions', 'videoEnc', 'thumbEnc',
                      'viewOnce', 'mentions', 'forwarded', 'edits', 'editedAt',
                      'deletedBy']))   // 2026-09-24 feature-audit: the admin's signature
            // LIVE CALL ROW (2026-08-12): a call record is created at ring time ("Ringing") and the
            // SAME doc is finalised later (ongoing / answered / missed, duration, voice→video
            // upgrade). Either participant may update ONLY these call fields — the callee must be
            // able to finalise a ringing row whose caller died mid-call. createdAt is deliberately
            // NOT in the list: the row keeps the time the call started ringing, forever.
            || (request.auth.uid in convData().users
                && resource.data.get('type', '') == 'call'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                     ['callOutcome', 'callDuration', 'callVideo']))
          );
        allow delete: if signedIn() && request.auth.uid == resource.data.authorId;

        // Poll votes: one doc per voter (messages/{mid}/votes/{uid}). Any member may READ (to tally),
        // but a voter may only write their OWN vote doc — no one can forge or overwrite another's vote.
        // The poll's question/options stay E2EE in the message text; a vote is just option indices.
        match /votes/{voter} {
          allow read: if signedIn() && request.auth.uid in convData().users;
          // 2026-09-24 decision D-composer-3: a vote has a shape. Only `options` (1 to 10 indices,
          // the composer's own ceiling) and `at`; and when the poll says it takes one answer
          // (`pollMulti == false`, written in the clear by the app from today) exactly one option.
          // A poll from before today carries no flag and keeps accepting any count. The vote doc is
          // already the voter's own (`voter == auth.uid`); a vote on a message that does not exist
          // is refused by the read of it.
          allow delete: if signedIn() && request.auth.uid == voter && request.auth.uid in convData().users;
          allow create, update: if signedIn() && request.auth.uid == voter
            && !groupModBlocked(convData())   // 2026-10-18 group moderation: no votes while restricted
            && request.auth.uid in convData().users
            && request.resource.data.keys().hasOnly(['options', 'at'])
            && request.resource.data.options is list
            && request.resource.data.options.size() >= 1
            && request.resource.data.options.size() <= 10
            && (get(/databases/$(database)/documents/conversations/$(cid)/messages/$(mid)).data
                  .get('pollMulti', true) != false
                || request.resource.data.options.size() == 1)
            // 2026-10-19 polls: no vote once the creator stopped the poll or its end time passed
            // (`pollEndsAt`, ms, written in the clear at send). Taking a vote back stays open.
            && get(/databases/$(database)/documents/conversations/$(cid)/messages/$(mid)).data
                  .get('pollClosed', false) != true
            && (!(get(/databases/$(database)/documents/conversations/$(cid)/messages/$(mid)).data
                    .get('pollEndsAt', 0) is int)
                || get(/databases/$(database)/documents/conversations/$(cid)/messages/$(mid)).data
                    .get('pollEndsAt', 0) == 0
                || request.time.toMillis() < get(/databases/$(database)/documents/conversations/$(cid)/messages/$(mid)).data
                    .get('pollEndsAt', 0));
        }
      }

      // Pending join requests from invite links. Created + resolved by the join/approve/deny Cloud
      // Functions (admin SDK, which bypasses these rules); group members may READ to show the pending
      // list. No direct client writes.
      // 2026-10-19 group fix round S10: a request names who asked to join, so it is read by the
      // people who answer it (the owner, an admin with Add members, the same test as `adminCan`
      // .inviteUsers) and by the person who asked. The app only listens with that right
      // (GroupSettingsView); an older build's listener without it now comes back empty.
      match /joinRequests/{ruid} {
        allow read: if signedIn() && (ruid == request.auth.uid
          || (request.auth.uid in convData().users
              && (request.auth.uid == convData().get('createdBy', '')
                  || (request.auth.uid in convData().get('admins', [])
                      && (!(request.auth.uid in convData().get('adminRights', {}))
                          || 'inviteUsers' in convData().get('adminRights', {})[request.auth.uid])))));
        allow write: if false;
      }

      // 2026-10-19 groups v2 step 4: each invite link's record (name, time and usage limits, who
      // made it, the faces of the first people in). Server-only: the functions-groups link callables
      // (createGroupLink, editGroupLink, revokeGroupLink, deleteGroupLink, listGroupLinks,
      // getShareLink) read and write it with the admin SDK and hand the app what it may see.
      match /links/{code} {
        allow read, write: if false;
      }
    }

    // Group invite links (code → group). 2026-10-19 groups v2 step 4: THE SERVER OWNS THEM. This
    // doc is the lookup a code is resolved by, and only the functions-groups callables touch it:
    // joinGroupViaInvite and groupLinkPreview read it, the link callables (createGroupLink and the
    // rest, see conversations/{cid}/links) write it. The app used to read it to show the link page
    // and write it in three loose steps; a stranger holding a code learned the group's link options
    // from it. Builds from before this change lose their own link page (it read and wrote here);
    // joining, the link card and the join sheet go through the functions and keep working.
    match /invites/{code} {
      allow read, write: if false;
    }

    // Group calls: a single coordination doc per group (active flag + who started). Any member
    // of the conversation may read it (to show a "Join call" bar) and write it (start/end).
    //
    // 2026-09-24 audit: WHO STARTED IT IS NO LONGER SPOOFABLE. `write` was open to every member, so
    // one member could set `startedBy` to another and `onGroupCallStarted` pushed "<that person>
    // started a call" to the whole group in a name they never used. The two writes the app makes
    // (GroupCallService) are all that is allowed now:
    //  - START: the full doc, `active: true`, `startedBy` = me. On an
    //    existing doc only when no call is live, when the live one is mine, or when it is a stale
    //    one past the same 4h the Join bar ignores. A member JOINING a live call makes this same
    //    write and is refused, harmlessly (`try?`, the doc is already right).
    //  - END: `active: false` and nothing else, by any member (the last one out clears it).
    // No delete: nothing in the app deletes it.
    match /groupCalls/{cid} {
      // audit M-077 (2026-10-07): a GROUP chat only. A one-to-one chat's id passed too, so a stranger
      // could start a "group call" on it and ring somebody past their Calls setting and the 1:1 ring
      // limit. The app opens group calls only from a chat whose type is 'group' (Conversation.isGroup).
      function isGroupMember() {
        let conv = get(/databases/$(database)/documents/conversations/$(cid)).data;
        return conv.get('type', '') == 'group' && request.auth.uid in conv.users;
      }
      // audit M-133 (2026-10-07): `startedAt` is the server's clock, never the writer's. The app writes
      // serverTimestamp(), which is exactly request.time. A doc may also carry the start time it
      // already has (the starter's merge {active:true} confirm keeps it), but never a made-up one.
      // Missing stays allowed, as before, for any build that never wrote it.
      function startStampNew() {
        return !('startedAt' in request.resource.data) || request.resource.data.startedAt == request.time;
      }
      function startStampNewOrKept() {
        return startStampNew() || request.resource.data.startedAt == resource.data.get('startedAt', null);
      }
      // owner 2026-10-06 call roles: `recordId` is the chat record the app's start write has carried
      // since 2026-09-24 (GroupCallService.join); the old key list refused that write outright.
      // `removedUids` is written ONLY by callAdmin (people removed from this call) and cleared only by
      // the join-token mint once the media room is empty. A phone may carry it through a write
      // unchanged and nothing else (groupRemovedKept), so a removed member cannot wipe it by ending
      // and restarting the call.
      function isStartWrite() {
        return request.resource.data.keys().hasOnly(['active', 'startedBy', 'video', 'title', 'startedAt',
                                                     'recordId', 'removedUids'])
          && request.resource.data.active == true
          && request.resource.data.startedBy == request.auth.uid;
      }
      function groupRemovedKept() {
        return request.resource.data.get('removedUids', null) == resource.data.get('removedUids', null);
      }
      // 2026-10-04 calls: ids starting "adhoc_" are multi-person calls grown from a 1:1. They have no
      // conversation behind them; the doc's own `members` list is who may see and change it. Every
      // other id keeps the group rules below exactly as before.
      function isAdhoc() {
        return cid.matches('adhoc_.*');
      }
      function adhocMembersOk() {
        return request.resource.data.members is list
          && request.resource.data.members.size() <= 32
          && request.auth.uid in request.resource.data.members;
      }
      // owner audit 2026-10-06 #25: `names` and `photos` became the names other members see and
      // the push text, and any member could rewrite anybody's entry. Now an entry is only ever
      // ADDED, and only for somebody on the list; one already there cannot be changed or removed
      // from a phone. onAdhocCallWritten (functions-groups) puts every entry back to the person's
      // own profile, so a new entry cannot carry a made-up name for long either.
      function adhocMapOk(f) {
        return request.resource.data.get(f, {}) is map
          && request.resource.data.get(f, {}).keys().hasOnly(request.resource.data.members);
      }
      function adhocMapGrowsOnly(f) {
        return adhocMapOk(f)
          && request.resource.data.get(f, {}).diff(resource.data.get(f, {})).changedKeys().size() == 0
          && request.resource.data.get(f, {}).diff(resource.data.get(f, {})).removedKeys().size() == 0;
      }
      // 2026-10-18 Group Settings "Start group call: Admins only" (`onlyAdminsCall`). The token
      // (groupCallToken) is the real gate; this keeps a member from marking a call live and ringing
      // the group without one.
      function mayStartCall() {
        let conv = get(/databases/$(database)/documents/conversations/$(cid)).data;
        return conv.get('onlyAdminsCall', false) != true || request.auth.uid in conv.get('admins', []);
      }
      allow read: if signedIn() && !isAdhoc() && isGroupMember();
      // 2026-10-18 group moderation: no call starts in a suspended or disabled group (groupCallToken
      // refuses the media token as well). Ending one stays open.
      function callModOK() {
        return !groupModBlocked(get(/databases/$(database)/documents/conversations/$(cid)).data);
      }
      allow create: if signedIn() && !isAdhoc() && isGroupMember() && isStartWrite()
        && !('removedUids' in request.resource.data)
        && startStampNew()
        && mayStartCall()
        && callModOK();
      // audit M-034 (2026-10-07): somebody the owner removed from this call (still in `removedUids`)
      // may not switch it off for everyone on the way out.
      allow update: if signedIn() && !isAdhoc() && isGroupMember() && groupRemovedKept() && (
           (isStartWrite() && startStampNewOrKept()
             && mayStartCall()   // a start write is a START: joiners never write one
             && callModOK()
             && (resource.data.get('active', false) != true
                 || resource.data.get('startedBy', '') == request.auth.uid
                 || (resource.data.get('startedAt', null) is timestamp
                     && resource.data.startedAt < request.time - duration.value(4, 'h'))))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
            && request.resource.data.active == false
            && !(request.auth.uid in resource.data.get('removedUids', []))
            // 2026-10-20: starter or admin; others via groupCallClose
            && (resource.data.get('startedBy', '') == request.auth.uid
                || request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.get('admins', [])))
      );

      // Keyed on the doc's own `members`, NOT on isAdhoc(): the Calls tab and the invite listener
      // QUERY this collection (members array-contains me), and a list query cannot be proven
      // against the document id. Group docs never carry `members` (their create allows only the
      // five start keys), so this can only ever open an ad-hoc call to someone on its list.
      // audit M-066 (2026-10-07): `joined` ends a member's ring on every phone (GroupCallRinging), and
      // any member could rewrite it to silence somebody else. Now it only grows, and only by the
      // writer's own uid (GroupCallService.markJoined writes arrayUnion([me])). The server's removal
      // of a person (callAdmin) does not pass through the rules.
      function adhocJoinedGrowsByMe() {
        return request.resource.data.get('joined', []) is list
          && request.resource.data.get('joined', []).hasAll(resource.data.get('joined', []))
          && request.resource.data.get('joined', []).toSet()
               .difference(resource.data.get('joined', []).toSet()).hasOnly([request.auth.uid]);
      }
      // audit M-065 (2026-10-07): `invitedAt` is a per-person ring clock ({uid: time}), written by the
      // adder in the same update that adds the person, so a late add rings for its own full window and
      // the others' clocks stay where they were. Only entries for people THIS write adds may be set.
      // Not tied to the current member list on later writes: an entry for somebody the server later
      // took off the list must not make every following app write fail.
      function adhocInvitedAtOk() {
        let added = request.resource.data.members.toSet().difference(resource.data.members.toSet());
        return request.resource.data.get('invitedAt', {}) is map
          && request.resource.data.get('invitedAt', {}).diff(resource.data.get('invitedAt', {}))
               .affectedKeys().difference(added).size() == 0;
      }
      allow read: if signedIn() && request.auth.uid in resource.data.get('members', []);
      allow create: if signedIn() && isAdhoc()
        && request.resource.data.keys().hasOnly(['kind', 'active', 'startedBy', 'video', 'title', 'members',
                                                 'names', 'photos', 'joined', 'startedAt', 'endedAt',
                                                 'invitedAt'])
        && request.resource.data.kind == 'adhoc'
        && request.resource.data.startedBy == request.auth.uid
        && adhocMembersOk()
        && adhocMapOk('names') && adhocMapOk('photos') && adhocMapOk('invitedAt')
        && request.resource.data.get('joined', []) is list
        && request.resource.data.get('joined', []).hasOnly([request.auth.uid])
        && startStampNew();
      // Members only ever grow: nobody can take a person off an invite list they did not write.
      // owner 2026-10-06 call roles: `startedBy` (the call's owner) and `removedUids` (people the owner
      // removed, written by callAdmin) stay outside the keys a phone may touch. Nobody may put a removed
      // person back on the list. And an ended call stays ended: `active` may go false (the app's last
      // one out, and a start that was abandoned), never back to true, so a member cannot re-ring
      // everyone after the owner ended it. Ending by the last one out is still a phone write; the rules
      // cannot see whether the media room is empty. It only clears the ringing, and the owner's End
      // (callAdmin) is the one that closes the room.
      allow update: if signedIn() && isAdhoc()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['active', 'members', 'names', 'photos', 'joined', 'endedAt', 'title', 'invitedAt'])
        && adhocMembersOk()
        && request.resource.data.members.hasAll(resource.data.members)
        && !request.resource.data.members.hasAny(resource.data.get('removedUids', []))
        && (request.resource.data.active == false || resource.data.active == true)
        && adhocMapGrowsOnly('names') && adhocMapGrowsOnly('photos')
        && adhocJoinedGrowsByMe()
        && adhocInvitedAtOk();
    }

    // 2026-10-04 calls: call links. Written by the Cloud Functions only (createCallLink and friends);
    // a phone may GET one by its id, which it can only know from the link's key. No listing: the ids
    // must not be enumerable.
    match /callLinks/{roomId} {
      allow get: if signedIn();
      allow list, write: if false;
      // Join requests for a link that needs the creator's approval. The requester can see their own
      // (to learn approved / denied); the creator can see and list them all.
      match /requests/{uid} {
        function isLinkCreator() {
          return request.auth.uid == get(/databases/$(database)/documents/callLinks/$(roomId)).data.creatorUid;
        }
        allow get: if signedIn() && (request.auth.uid == uid || isLinkCreator());
        allow list: if signedIn() && isLinkCreator();
        // Giving up while still waiting withdraws the request. Only a PENDING one: an answer the
        // creator already gave (denied) must not be erasable by the person it was given to.
        allow delete: if signedIn() && request.auth.uid == uid && resource.data.status == 'pending';
        allow create, update: if false;
      }
    }

    // Calls: ephemeral WebRTC signaling (offer/answer + ICE candidates). Scoped to the
    // TWO participants only — otherwise any signed-in user could read SDP/ICE (eavesdrop),
    // inject candidates, force-end strangers' calls, or spoof caller-ID via the VoIP push.
    // HOW LONG A CALL TOOK TO CONNECT, and nothing else. Milliseconds between milestones on each
    // side, written once when the media path comes up, so "Connecting… takes a bit" can be answered
    // with a number instead of a guess.
    //
    // A SEPARATE COLLECTION, not a field on the call. Both phones hold a live listener on the call
    // document and an extra field there would push a snapshot to both of them mid-call for nothing.
    //
    // WRITE-ONLY FROM A PHONE, AND NEVER READABLE BY ONE. There is nothing here a client needs, and
    // a call id is guessable enough that a readable timing document would tell a stranger when two
    // people spoke. It is read from the console with an admin credential and nowhere else.
    // No delete either: nothing on a phone should be able to erase a measurement.
    match /callTiming/{callId} {
      allow read, delete: if false;
      allow create, update: if signedIn()
        && exists(/databases/$(database)/documents/calls/$(callId))
        && (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.caller
            || request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callee);
    }

    match /calls/{callId} {
      function parties() {
        return get(/databases/$(database)/documents/calls/$(callId)).data;
      }
      allow read: if signedIn()
        && (request.auth.uid == resource.data.caller || request.auth.uid == resource.data.callee);
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.caller
        && request.resource.data.callee is string
        && request.resource.data.callee != request.auth.uid
        // 2026-09-24 decision D7: the callee's Calls setting and blocks are the server's to enforce,
        // not only the callee's phone (which a patched caller never reaches past the push). The
        // app's own gates (`CallPrivacyIndex` before dialling, `decideAllowed` on the callee) stay.
        // 1:1 audit r2 G6, 2026-10-08: a BLOCK is no longer refused here. A refused create was a
        // one-call block test (with Calls on Everyone nothing else refuses). The create goes
        // through and onCallCreated sends no push and writes no `screenedAt`, so the callee never
        // rings and the caller hears an ordinary no answer, as in the reference app.
        && callsAllowedBy(request.resource.data.callee)
        // 1:1 audit r3 J2, 2026-10-08: the block refusal is BACK while builds 840-843 are in use.
        // An open 840-841 app settles a ringing doc before its block gate: it writes "busy" (the
        // blocked caller learns I am on another call) and a "Missed call" row from them into my
        // chat. A refused create tells the caller only "blocked", once, as before r2; it does not
        // let them watch me. When 840-843 are gone, the owner sets `config/calls.silentBlocks =
        // true` (admin write, no rules deploy) and G6's silent block is live again.
        && (!isBlockedByUser(request.resource.data.callee) || silentCallBlocks())
        // 1:1 audit r2 G8, 2026-10-08: `screenedAt` is the server's "checks passed, ring now"
        // (onCallCreated). No client writes it, here or on update.
        && !('screenedAt' in request.resource.data)
        // 1:1 audit r3 F3, 2026-10-08: the answer fields are the callee's, never written at create.
        && !request.resource.data.keys().hasAny(['acceptedAt', 'answeredTokenHash', 'answeredDevice'])
        // owner audit 2026-10-06 #26: the server's clock, never the caller's. A call created with
        // `createdAt` missing or in the future was never timed out by sweepCalls and slipped past
        // the phone's 60s stale-ring guard, so it rang on every app launch. The app writes
        // serverTimestamp(), which is exactly this.
        && request.resource.data.createdAt == request.time;
      // Either party may update the call, but neither can change who's on it.
      allow update: if signedIn()
        && (request.auth.uid == resource.data.caller || request.auth.uid == resource.data.callee)
        && request.resource.data.caller == resource.data.caller
        && request.resource.data.callee == resource.data.callee
        // owner audit 2026-10-06 (call audit 15, low): an ended call stays ended. Without this either
        // party could flip an old call back to ringing; nothing in the app writes any status after
        // 'ended' except 'ended' again.
        && (resource.data.get('status', '') != 'ended' || request.resource.data.get('status', '') == 'ended')
        // owner audit 2026-10-06 #25 / #26: the start time, and the caller's name and photo that
        // onCallCreated put back to the profile's, are written once. The app never updates them.
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('callerName', null) == resource.data.get('callerName', null)
        && request.resource.data.get('callerPhoto', null) == resource.data.get('callerPhoto', null)
        && request.resource.data.get('screenedAt', null) == resource.data.get('screenedAt', null)   // 1:1 audit r2 G8
        // 1:1 audit r3 F3, 2026-10-08: only the callee writes the answer. The caller could set
        // `acceptedAt` + a made-up `answeredTokenHash` and the server's "answered elsewhere" push
        // then silenced every one of the callee's phones with no missed call left behind.
        && (request.auth.uid == resource.data.callee
            || !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['acceptedAt', 'answeredTokenHash', 'answeredDevice']))
        // 1:1 audit r3 J1, 2026-10-08: once the call is answered, the callee's side cannot end it as
        // a ring (declined / missed / busy). Builds 840-843 end a ring blindly, so my other, older
        // phone still ringing (its Decline, its 60 s timer) dropped the call I was on. That write is
        // refused now and only its own ring stops. The answering phone ends with `hangup` (or
        // `failed`), which stays allowed, and the caller may end the call any way.
        && (request.auth.uid != resource.data.callee
            || resource.data.get('acceptedAt', null) == null
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'endReason'])
            || !(request.resource.data.get('endReason', '') in ['declined', 'missed', 'busy']));
      // NO delete. THIRD stray paste of the message-request decline rule, after the two removed from
      // /users and story views on 2026-08-04. A call document has `caller` and `callee`, not `users`
      // or `startedBy`, so it could only ever error. Nothing in the app deletes a call, so nothing
      // was broken by it — but a rule that reads fields from a different collection is a trap for
      // whoever reads it next. Also spotted by Gemini.
      // 1:1 audit r3 F7, 2026-10-08: only the two candidate lists, each written by its own side,
      // only the candidate fields, bounded, and nothing once the call has ended (the server's scrub
      // and sweep clear these two names only). Phones only ever add; no update or delete.
      match /{sub}/{candidate} {
        allow read: if signedIn()
          && (request.auth.uid == parties().caller || request.auth.uid == parties().callee);
        allow create: if signedIn()
          && ((sub == 'callerCandidates' && request.auth.uid == parties().caller)
              || (sub == 'calleeCandidates' && request.auth.uid == parties().callee))
          && parties().get('status', '') != 'ended'
          && request.resource.data.keys().hasOnly(['candidate', 'sdpMLineIndex', 'sdpMid', 'enc'])
          && (!('candidate' in request.resource.data)
              || (request.resource.data.candidate is string && request.resource.data.candidate.size() <= 2048))
          && (!('sdpMid' in request.resource.data) || request.resource.data.sdpMid == null
              || (request.resource.data.sdpMid is string && request.resource.data.sdpMid.size() <= 64))
          && (!('enc' in request.resource.data)
              || (request.resource.data.enc is string && request.resource.data.enc.size() <= 8192));
        allow update, delete: if false;
      }
    }

    // Stories: ephemeral 24h photo status. Audience is enforced by recipientUids
    // (rules-protected, not E2EE in v1). A scheduled function deletes them at 24h.
    match /stories/{storyId} {
      function storyData() {
        return get(/databases/$(database)/documents/stories/$(storyId)).data;
      }
      // ⚠️ `public == true` IS NOT A READ CLAUSE ANY MORE, and taking it out is a SECURITY FIX.
      //
      // It granted any signed-in user the WHOLE document, and the document carries `recipientUids` —
      // the uid of every person the author has an accepted chat with. So one read of one "Everyone"
      // story handed a stranger the author's entire contact graph. A rule cannot hide one field of a
      // document it grants, so the clause had to go rather than be narrowed.
      //
      // Public reach is not lost: it moved to `users/{uid}/publicStories/{storyId}`, a mirror that
      // carries the media and nothing about the audience. See that block, and `postStory`.
      // ⛔ THE AUDIENCE IS A LIST OF TOKENS NOW, AND THAT IS A SECURITY FIX RATHER THAN A TIDY-UP.
      //
      // A rule cannot grant a document while hiding one field of it, so for as long as
      // `recipientUids` held raw uids, EVERY RECIPIENT WHO READ A STORY READ THE AUTHOR'S WHOLE
      // CONTACT LIST WITH IT — up to a thousand people they had no other way to name. The same hole
      // was closed for strangers by moving public reach to `users/{uid}/publicStories`; this was the
      // half left behind, and the bigger one, because a friend is likelier to look.
      //
      // The array holds `sha256('fariin-audience-v1:' + uid)` per person, lowercase hex. A uid is 28
      // characters of base62, so the list cannot be inverted or enumerated. The app computes the same
      // string in `StoryAudienceToken.token` and `onStoryConsumed` recomputes it too — all three have to
      // change together or nothing is readable.
      function audienceToken(uid) {
        return hashing.sha256('fariin-audience-v1:' + uid).toHexString().lower();
      }
      // 2026-09-26 block rebuild: A DIRECT FETCH BY SOMEBODY THE AUTHOR BLOCKED IS REFUSED, even
      // while they are still in `recipientUids` (blocking revokes the audience, but that is an app
      // write that can fail or lag). On `get` ONLY: the check reads `resource.data.authorUid`, which
      // a tray QUERY cannot prove, so putting it on `list` would refuse every tray query. The tray
      // is covered by the audience revoke taking them out of `recipientUids`.
      allow get: if storyReadable()
        && (request.auth.uid == resource.data.authorUid
            || adminCan('moderate')
            || !isBlockedByUser(resource.data.authorUid));
      allow list: if storyReadable();
      function storyReadable() { return signedIn() && (
        request.auth.uid == resource.data.authorUid
        || audienceToken(request.auth.uid) in resource.data.recipientUids
        // ⚠️ THE RAW-UID FORM, FOR THE STORIES THAT WERE ALREADY UP WHEN THIS SHIPPED. They expire
        // within 24 hours and this clause goes with the last of them — see `othersLegacyReg` in the
        // app, which is the same migration seen from the other end. It is only ever a WIDENING for
        // documents written by an older build; nothing new is written in that shape.
        || request.auth.uid in resource.data.recipientUids
        // A moderator acting on a report. A reported story is often NOT public - somebody's friend
        // reported it - and without this the one person who has to look at it is the one person who
        // cannot. Reading is gated on the `moderate` permission, which nobody has by default.
        || adminCan('moderate')
      ); }
      /// HOW MANY STORIES THIS ACCOUNT HAS POSTED IN THE CURRENT WINDOW — see
      /// `users/{uid}/limits/{name}`, whose own rules are what make the number hard to fake.
      function storyBudget() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)/limits/stories).data;
      }
      /// The same, over a day rather than an hour — see the second clause of the create rule.
      /// HOW MANY OF THIS ACCOUNT'S STORIES ARE ALIVE RIGHT NOW.
      ///
      /// A rule cannot run a query, so it cannot count anything — it can only read one document. So
      /// the number is kept in one: `users/{uid}/limits/storiesActive`, incremented by
      /// `onStoryCreated` and decremented by `onStoryDeleted`, both with admin rights, and refused
      /// to every client by the rules on that path.
      ///
      /// ⚠️ A MISSING DOCUMENT IS ZERO, not "allow anything". That is not the fail-open the two
      /// budget counters carry: an account the server has never counted a story for genuinely has
      /// none alive, so zero is the correct answer rather than a shrug.
      function activeStories() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid)/limits/storiesActive)
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)/limits/storiesActive).data.get('count', 0)
          : 0;
      }
      function dailyStoryBudget() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)/limits/storiesDaily).data;
      }
      // GROUP STORY (owner 2026-10-23): `groupId` names a group I own, or one I am an admin of
      // while its owner leaves adminsPostStories on. Never public. App: GroupStoryRights.
      function groupStoryOK() {
        let g = request.resource.data.get('groupId', '');
        return g == '' || (request.resource.data.get('public', false) == false
          && groupPoster(get(/databases/$(database)/documents/conversations/$(g)).data));
      }
      function groupPoster(c) {
        return c.get('type', '') == 'group' && request.auth.uid in c.get('users', [])
          && (request.auth.uid == c.get('createdBy', '')
              || (request.auth.uid in c.get('admins', []) && c.get('adminsPostStories', true) != false));
      }
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.authorUid
        && groupStoryOK()
        // ⛔ WHO MAY POST A STORY AT ALL, DECIDED ON THE SERVER, WITH NO BUILD. Two switches, one
        // per kind of account, and they are INDEPENDENT (owner, 2026-08-21: "Disable Stories for all
        // users … only for verified users … only for normal users … Enable Stories for one user type
        // while keeping them disabled for another").
        //
        //   config/limits.stories_enabled_default    0 = ordinary accounts cannot post
        //   config/limits.stories_enabled_verified   0 = verified accounts cannot post
        //
        // ⚠️ TWO SWITCHES RATHER THAN ONE SETTING WITH THREE VALUES, and the difference is the
        // fourth case. This started as `stories_enabled` with 0/1/2 — nobody, everybody, verified
        // only — copied from the reference app's own `stories_posting` (enabled / premium /
        // disabled). Three values can express three of the four combinations he asked for and not
        // the fourth: there is no way to say "ordinary accounts yes, verified accounts no". A pair
        // of independent flags gives all four and needs no new mechanism, because every other limit
        // on this document is already a `_default` / `_verified` pair.
        //
        // ⚠️ THIS IS ITS OWN CLAUSE AND THAT IS THE ENTIRE POINT. Setting the daily ceiling to zero
        // looks like it should do this and does not: the two budget clauses below open with
        // `!exists(the counter)`, a deliberate fail-open — an app that has never written a counter
        // must not be an app that cannot post — so an account that has never posted a story, or
        // whose 24-hour window has rolled over, sails past the ceiling without it ever being read.
        // MEASURED, not reasoned: with the daily limit at 0, an account with a live counter is
        // refused and an account with no counter document is ALLOWED. A switch with a hole in it is
        // worse than no switch, because it reads as working. So this sits in front, joined with
        // `&&`, where nothing can short-circuit around it.
        //
        // ⚠️ ANYTHING THAT IS NOT A ZERO IS ON, and that is the whole safety of it. The reference
        // app's version is a string and ours is a number for the reason written up in `appLimit`: a
        // field typed in a console is text unless somebody says otherwise, and text falls back. So a
        // typo, a missing key, or a 3 that means nothing all land on "can post". The one thing that
        // cannot happen by accident is the feature going dark.
        //
        // The user document read costs nothing extra: `isBanned()` further down reads the same
        // document and rule evaluation caches it, so this is the same one read either way.
        && ( isVerifiedCaller()
               ? appLimit('stories_enabled_verified', 1) != 0
               : appLimit('stories_enabled_default', 1) != 0 )
        // ⛔ HOW MANY STORIES MAY BE ALIVE AT ONCE — a different question from how many were POSTED
        // today, and it has its own pair of settings (owner, 2026-08-21, after reading the reference
        // app's list: "It should control the maximum number of active stories a user can have at the
        // same time").
        //
        //   config/limits.story_expiring_limit_default    ordinary accounts
        //   config/limits.story_expiring_limit_verified   verified accounts
        //
        // Their key is `story_expiring_limit_default` / `_premium` and it sits beside their
        // sent-per-week and sent-per-month limits for exactly this reason: an account can post
        // fifty in a day and delete forty-nine, or post ten and keep all ten up for the full
        // twenty-four hours. Only one of those fills a viewer's tray.
        //
        // ⚠️ THE DEFAULTS MATCH THE DAILY CEILINGS ON PURPOSE, so this changes nothing for anybody
        // the day it ships. A story lives 24 hours, so an account's active count can never exceed
        // what it posted in the last day anyway — which makes 50 and 100 exactly as permissive as
        // today, and leaves the setting there to be turned DOWN when he wants it.
        //
        // ⚠️ THE COUNT IS A DOCUMENT, NOT A QUERY, and it is written a moment AFTER the story it is
        // counting — a rule cannot count and a trigger is not instant. So a burst of posts fired
        // inside that moment can each read the same number and land. It is a ceiling on how many
        // stories somebody keeps up, not a security boundary, and the sweep behind it is the daily
        // counter which does not have that gap.
        && ( isVerifiedCaller()
               ? activeStories() < appLimit('story_expiring_limit_verified', 100)
               : activeStories() < appLimit('story_expiring_limit_default', 50) )
        // ⛔ A CEILING ON HOW FAST STORIES CAN BE POSTED, AND IT FAILS OPEN ON PURPOSE.
        //
        // There was no limit of any kind: one loop in a client, ours or anybody's, could write
        // stories until the project's quota ran out, and every one of them fans out to a thousand
        // recipients.
        //
        // The counter lives at `users/{uid}/limits/stories` and its own write rule is where the
        // teeth are: a window can only be opened when the last one has expired, and inside a window
        // the count may only go up by one at a time. So the number cannot be reset or lowered by the
        // client that owns it.
        //
        // ⚠️ MISSING OR EXPIRED READS AS ALLOWED, and that is deliberate rather than sloppy. This
        // rule ships before the build that writes the counter, and an app that has never written one
        // must not be an app that cannot post — that is an outage rather than a limit. What it stops
        // is the case worth stopping: a client that IS counting, running away.
        && (
             !exists(/databases/$(database)/documents/users/$(request.auth.uid)/limits/stories)
             || storyBudget().get('windowStart', request.time) < request.time - duration.value(1, 'h')
             || storyBudget().get('count', 0) < appLimit('stories_per_hour_default', 40)
             // The same two tiers as the day below, and for the same reason. Both numbers are 40
             // today, so this clause changes nothing until somebody sets them apart in
             // `config/limits` — it exists so that a raise is an edit rather than a release.
             || (
                  isVerifiedCaller()
                  && storyBudget().get('count', 0) < appLimit('stories_per_hour_verified', 40)
                )
           )
        // ⛔ AND A CEILING ON THE WHOLE DAY (owner, 2026-08-20), because the hour above does not
        // bound one. Forty an hour is nine hundred and sixty a day: an account that simply keeps
        // posting under the hourly ceiling never trips it, and every story fans out to a thousand
        // recipients. Fifty a day was his number and it still is, but it is no longer written here:
        // both ceilings are read from `config/limits` now, with the numbers below as the fallback,
        // so raising them is a field in the console rather than a build.
        //
        // A SECOND COUNTER, not a longer window on the first. They answer different questions — how
        // fast, and how much — and a single window cannot hold both without one of them becoming
        // meaningless.
        //
        // Fails open on exactly the same terms as the hourly one, and for the same reason: a client
        // that has never written this counter must not be a client that cannot post. What it stops
        // is the case worth stopping, a client that IS counting and keeps going.
        && (
             !exists(/databases/$(database)/documents/users/$(request.auth.uid)/limits/storiesDaily)
             || dailyStoryBudget().get('windowStart', request.time) < request.time - duration.value(24, 'h')
             || dailyStoryBudget().get('count', 0) < appLimit('stories_per_day_default', 50)
             // ⛔ AND A VERIFIED ACCOUNT GETS A BIGGER DAY (owner, 2026-08-21): "verify usars
             // upload story dalily limit make it 100 ... normal user dont have verify make it 50".
             //
             // A badge is granted by us and by nobody else, and `verification` sits in
             // `serverOnlyUserFields()`, so this is the one thing about an account that a client
             // cannot claim for itself — which is what makes it safe to hang a raised limit on.
             //
             // ⚠️ THE ORDER OF THESE TWO CLAUSES IS THE COST CONTROL. `||` short-circuits, so the
             // user document is not read at all until the ordinary allowance is spent, which is
             // every post up to the fiftieth. Past that it is free anyway — `isBanned()` further
             // down reads the same document and rule evaluation caches it.
             || (
                  isVerifiedCaller()
                  && dailyStoryBudget().get('count', 0) < appLimit('stories_per_day_verified', 100)
                )
           )
        // PUBLIC STORIES ARE BACK, on the owner's explicit order of 2026-08-06, and the rule that
        // refused them is gone with the audience option that was removed alongside it.
        //
        // WHAT HE ASKED FOR, in his words: "Anyone on Fariin can view your story if they reach your
        // profile, but only existing interactions/friends should get your story displayed directly
        // in their Story List. It should not become a public story feed." That is exactly what this
        // flag has always meant — the only query that reads it is `publicStoryGroup(for:)`, which
        // asks for ONE named person's stories and is run from their profile. There is no browse and
        // no feed to add it to, so the flag cannot become one.
        //
        // WHAT IT COSTS, written down so the next reader does not think it was overlooked. An
        // audience with no recipient list has no key to seal a story with, so story encryption, when
        // it lands, will cover Friends and Custom lists and not this one. And this is the one
        // surface where an App Store reviewer can be shown a stranger's content, which is what Apple
        // pulled Telegram over on 2026-08-04 — so the report-and-ban path has to keep covering it.
        // Both were put to him before this rule was changed and he chose to go ahead.
        //
        // A banned account still cannot post anything anybody else can find.
        && !isBanned()
        && request.resource.data.recipientUids.size() <= 1000   // limit fan-out abuse
        // Kill "immortal stories": expiry must be within ~30h of now (client sets +24h; the
        // margin tolerates device-clock skew). Blocks a hostile client from setting expiresAt
        // years out so cleanupStories never collects it.
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(30, 'h')
        // ⛔ AND `createdAt` IS THE SERVER'S CLOCK, NOT THE PHONE'S — 2026-09-11 security pass.
        //
        // Every field beside it was already pinned: `authorUid` to the caller, `mediaPath` to this
        // story's own folder, `type` paired with that path, `expiresAt` bounded to ~30h. This one
        // was required to be PRESENT and then never looked at — and the update rule freezes it for
        // life, so whatever a client stamped was permanent and unrepairable.
        //
        // ⚠️ IT IS NOT COSMETIC. `createdAt` decides where a story sits in every recipient's tray
        // and what the "posted Xh ago" label says, for the story's whole life. Back-dated, it
        // arrives already buried; forward-dated, it sits at the top of everyone's row until it
        // expires. Neither needs anything more than a modified client.
        //
        // ⚠️ SAFE FOR BOTH POST PATHS, CHECKED RATHER THAN ASSUMED. The photo and video creates
        // both send `FieldValue.serverTimestamp()`. The one place that stamps a CLIENT date is
        // `writePublicMirror`, and that writes to `users/{uid}/publicStories`, a different
        // collection this rule does not govern — it is deliberately given the original story's time
        // so a re-mirrored story does not claim to be brand new. This does not reach it.
        //
        // ⛔ A WINDOW, NOT `== request.time`, AND THE REASON IS THAT THE STRICT FORM CANNOT BE
        // TESTED HERE. The suites drive the emulator over REST with literal ISO timestamps; a
        // server-timestamp sentinel is a DocumentTransform and there is no way to express one
        // through this harness. So strict equality would be a rule whose ALLOW path no test could
        // ever exercise — and if the equivalence were ever wrong, every story post in the app would
        // be refused with nothing having caught it.
        //
        // The window closes exactly the same hole. The attack is a story that arrives already
        // buried, or one that sits at the top of every recipient's row until it expires; both need
        // hours, not minutes. Five minutes each way also absorbs the device-clock skew the
        // `expiresAt` clause above already says it is tolerating, and `serverTimestamp()` lands
        // trivially inside it.
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt > request.time - duration.value(5, 'm')
        && request.resource.data.createdAt < request.time + duration.value(5, 'm')
        // Pin mediaPath to THIS story's own folder. Defense-in-depth: onStoryDeleted already ignores
        // the client field, but this stops a hostile client even writing a foreign path.
        // Type must match the path: photo stories point at photo.jpg, video stories at video.mp4
        // (a lying type would only break the author's own story, but keep the pair consistent).
        && ((request.resource.data.type == 'video'
             && request.resource.data.mediaPath == 'stories/' + storyId + '/video.mp4')
            || (request.resource.data.type != 'video'
             && request.resource.data.mediaPath == 'stories/' + storyId + '/photo.jpg'));
      // Author-only, and the identity + lifetime fields are IMMUTABLE. The old rule pinned
      // nothing, so an author could rewrite authorUid to impersonate a victim (every recipient
      // then renders the victim's name/photo on the attacker's image) or push expiresAt out to
      // never expire.
      //
      // ⚠️ THE PICTURE AND THE CAPTION FREEZE ONCE THEY ARE SET, and this is not tidiness.
      //
      // An edited old post is invisible to everyone who already saw it, so it can't be reported.
      //
      // Worse, the pin was on the wrong field. `mediaPath` was locked to this story's own folder,
      // but the app RENDERS `mediaUrl`, which nothing checked — so it could be pointed at any URL
      // on the internet after the fact, at content we do not host and cannot take down.
      //
      // The post flow writes an empty mediaUrl at create and fills it in exactly once, so "still
      // empty" is precisely the window where a change is legitimate. `get(…, '')` rather than a
      // bare field read because old story documents predate the field.
      //
      // replyCount is deliberately still free: it is a counter, it carries no content, and freezing
      // it would stop replies being counted on a story that has been posted.
      allow update: if signedIn()
        && request.auth.uid == resource.data.authorUid
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.mediaPath == resource.data.mediaPath
        && request.resource.data.get('groupId', '') == resource.data.get('groupId', '')
        // type is pinned with the path (they were validated as a pair at create).
        && request.resource.data.type == resource.data.type
        // A story cannot change what KIND of story it is after people have it. Without this an
        // author could post a one-time story, let it be consumed, and clear the flag - or the
        // reverse, turning an ordinary story people have already opened into a burned one.
        && request.resource.data.get('oneTime', false) == resource.data.get('oneTime', false)
        // WHO CAN SEE IT MAY CHANGE AFTER POSTING, and this is the clause that had to move for it.
        //
        // `recipientUids` and `audienceLabel` were both pinned here, so a posted story's audience was
        // frozen for its whole life and the only way to reach a different one was to delete it and
        // post it again. The owner asked for the reference app's behaviour instead (2026-08-18):
        // change who can see an ACTIVE story, keeping its id, its posting time, its media and the
        // people who have already watched it.
        //
        // ⚠️ THIS IS NOT A HOLE IN THE FREEZE BELOW, AND THE TWO MUST NOT BE CONFUSED. The picture
        // and the caption stay frozen exactly as they were: the whole reason that freeze exists is
        // that content people have already seen must not change under them, and nothing here touches
        // content. Widening an audience shows the SAME story to more people; narrowing it shows it to
        // fewer. Neither can rewrite what anybody already watched.
        //
        // Two guards stay, and each answers a real move:
        //   • The fan-out cap, the same 1000 the create rule enforces. Without it here, an audience
        //     could be capped at post time and then edited past the cap a moment later.
        //   • A ONE-TIME story's audience is FROZEN. Being taken out of `recipientUids` is precisely
        //     how a single view is spent (`onStoryConsumed` does the taking), so rewriting that list
        //     would put somebody back in and hand them a second look at a story they have already
        //     burned. `public` and `audienceLabel` are pinned with it, or the same story could be
        //     made public and read off the profile after its one view was gone.
        && request.resource.data.recipientUids.size() <= 1000
        // ⚠️ A ONE-TIME STORY'S AUDIENCE MAY SHRINK, AND ONLY SHRINK. Pinning it outright was too
        // strong and broke a real thing: `revokeAudience` takes a blocked person off every live
        // story, and a one-time story needs that as much as any other. `hasAll` is a subset test —
        // the OLD list must contain everything in the new one — so a name can be taken out and none
        // can be put back, which is the whole of what "one view is spent" needs. The label and the
        // public flag stay pinned with it, or the same story could be made readable off the profile
        // after its single view was gone.
        && (resource.data.get('oneTime', false) == false
            || (resource.data.recipientUids.hasAll(request.resource.data.recipientUids)
                && request.resource.data.get('audienceLabel', '') == resource.data.get('audienceLabel', '')
                && request.resource.data.get('public', false) == resource.data.get('public', false)))
        && (resource.data.get('mediaUrl', '') == ''
            || (request.resource.data.get('mediaUrl', '') == resource.data.get('mediaUrl', '')
                && request.resource.data.get('caption', '') == resource.data.get('caption', '')));
      // The author, or a moderator acting on a report. This is the ONE surface in Fariin where a
      // stranger's content is visible to anybody who finds it (an "Everyone" story is public), which
      // makes it the one place Apple could be shown somebody else's illegal post. Being able to take
      // it down in seconds is the whole point - Telegram was pulled from the App Store on
      // 2026-08-04 over a single user's post and restored the same day once they removed it.
      // ⛔ 2026-10-12: the moderator half moved to the adminApi function (storyRemove), which records
      // every takedown in the audit log. Here, only the author deletes their own story.
      allow delete: if signedIn() && request.auth.uid == resource.data.authorUid;

      // THE VIEW COUNT, KEPT BY THE SERVER, READ BY THE AUTHOR ALONE.
      //
      // The footer used to fetch every document in `views` — full receipts, names resolved — to
      // draw one number, for every one of your stories, every time the viewer opened. The reference
      // app never does that: its story object carries the counts down with the story and the LIST is
      // a separate request made only when you open it. `onStoryViewWritten` maintains this document;
      // the client only reads it.
      //
      // ⚠️ A SUBCOLLECTION DOCUMENT RATHER THAN A FIELD ON THE STORY, AND THAT IS THE PRIVACY HALF.
      // The story document is readable by every recipient, so a counter living on it would tell each
      // of them how many other people had watched — which no comparable app shows, and which the
      // `views` read rule below deliberately refuses today. Here it is the author's alone.
      //
      // NO CLIENT WRITE OF ANY KIND. A counter a viewer can write is a counter a viewer can invent,
      // and the trigger runs with admin credentials, which these rules do not apply to.
      match /meta/{docId} {
        allow read: if signedIn() && request.auth.uid == storyData().authorUid;
      }

      // A recipient records they viewed it; the author can read the viewer list.
      match /views/{viewerUid} {
        allow read: if signedIn() && (
          request.auth.uid == storyData().authorUid
          || request.auth.uid == viewerUid
        );
        // Only `viewedAt` + a short `reaction` string may be written — no injected fields, no
        // unbounded/junk reaction (the receipt-spoofing hole).
        // 2026-10-17: `firstAt` is the server's (onStoryViewWritten) time of the FIRST view, set
        // once. A client may never create it and may never change it; an older build's merge of
        // viewedAt/reaction leaves it as it is, so those builds still pass.
        function validReceipt() {
          return request.resource.data.keys().hasOnly(['viewedAt', 'reaction', 'firstAt'])
            && (!('reaction' in request.resource.data)
                || (request.resource.data.reaction is string && request.resource.data.reaction.size() <= 16));
        }
        // A REACTION IS ONLY A REACTION IF THE AUTHOR ALLOWED ONE.
        //
        // `allowsReplies` was read in exactly one place in the whole app — whether to draw the reply
        // bar — so the switch hid our own button and stopped nothing. Any client could still write a
        // reaction onto a story whose author had turned them off. Now the server says no. A receipt
        // with no reaction (a plain view) is always fine; that is not a reaction, it is a read mark.
        function reactionAllowed() {
          return !('reaction' in request.resource.data)
            || request.resource.data.reaction == ''
            || storyData().get('allowsReplies', true) == true;
        }
        // ⚠️ PUBLIC STORIES COUNT THEIR VIEWERS NOW. This required membership of `recipientUids`,
        // and somebody who reached an "Everyone" story from a profile is not in that list — so the
        // one audience whose entire purpose is reach was the one audience that could not measure it.
        // Their write was refused, silently, and the author's Seen-by never showed them.
        // ⛔ THE AUDIENCE IS A LIST OF TOKENS, AND THIS CLAUSE WAS STILL ASKING FOR A RAW UID.
        //
        // When the audience was anonymised (`recipientUids` holds
        // `sha256('fariin-audience-v1:' + uid)` per person) the story's own READ rule was moved to
        // `audienceToken(...)`. This one, in the same file a hundred lines below, was not. So for
        // every story that is not public — My Friends, a custom list, one-time — the viewer's
        // receipt write has been DENIED, and denied silently: the client writes it with `try?`.
        //
        // What that cost, and it is not small: "Seen by" empty on every friends-only story, the view
        // count stuck at zero, and the heart unable to land either (a reaction is a field on this
        // same receipt, so a refused create refuses the reaction with it). Only "Everyone" stories
        // kept working, through the `public` clause below — and stories posted before the audience
        // was tokenised kept working too, which is exactly the 24 hours that would hide it from a
        // test.
        //
        // Both forms are accepted: the raw one has to stay while stories written by an older build
        // are still alive, the same migration the story read rule carries.
        allow create: if signedIn()
          && request.auth.uid == viewerUid
          && (audienceToken(request.auth.uid) in storyData().recipientUids
              || request.auth.uid in storyData().recipientUids
              || storyData().get('public', false) == true)
          && !isBlockedByUser(storyData().authorUid)   // 2026-09-26: never in a blocker's Seen-by
          && !('firstAt' in request.resource.data)     // 2026-10-17: the server's to set
          && validReceipt() && reactionAllowed();
        allow update: if signedIn() && request.auth.uid == viewerUid
          && !isBlockedByUser(storyData().authorUid)   // 2026-09-26: no reaction after a block
          && request.resource.data.get('firstAt', null) == resource.data.get('firstAt', null)
          && validReceipt() && reactionAllowed();  // set/clear reaction
        // NO delete — a view receipt is not something a viewer takes back. (Second stray paste of the
        // message-request decline rule; it read conversation fields off a view receipt, so it could
        // only ever error. Removed 2026-08-04, no behaviour change.)
      }

      // A ONE-TIME STORY, BURNED. The recipient says "I have opened this"; `onStoryConsumed` then
      // takes them out of `recipientUids`, and THAT is the enforcement — the tray query stops
      // matching the story and the read rule above refuses a direct fetch, neither of which any
      // client can undo, because the story update rule pins `recipientUids` for everybody.
      //
      // WHY NOT JUST DENY THE READ ONCE A RECEIPT EXISTS, which is the obvious version: a `list`
      // query fails ENTIRELY if any document it returns is unreadable. A story the viewer had
      // consumed would still match `recipientUids array-contains me`, so an `exists()` clause on
      // the read rule would not hide that one story, it would break the whole story tray. Changing
      // what the query MATCHES is the only way to remove one document from a list.
      //
      // Separate from `views` because a view receipt is optional (the Story View Receipts setting)
      // and consumption cannot be, or turning that switch off would turn a one-time story into an
      // ordinary one. It is also why this is not a field on the receipt: that would put somebody
      // with receipts off into the author's Seen-by list.
      //
      // Only ever created, never updated or deleted: unburning is the whole thing this prevents.
      match /consumed/{viewerUid} {
        // Nobody lists this. The viewer may confirm their own, and a moderator may look while
        // acting on a report. The AUTHOR is not given it — they can already infer it from their
        // own recipient list, and there is no reason to hand them a second, tidier copy.
        allow read: if signedIn() && (request.auth.uid == viewerUid || adminCan('moderate'));
        // ⚠️ BOTH FORMS, FOR THE SAME REASON THE `views` RULE ABOVE TAKES BOTH — and this clause was
        // MISSED when the audience was tokenised. `recipientUids` holds sha256 tokens now, so a raw
        // uid test is false for every story written since, the create was denied, and the client
        // writes this doc with `try?` so the denial was silent. `onStoryConsumed` fires on the CREATE
        // of this document, so nothing ever removed the token: the burn stopped happening at all and
        // the only enforcement left was the device-local flag, which does not survive a reinstall and
        // does not reach a second device. A one-time story could be watched again by reinstalling.
        //
        // The raw form stays for as long as stories written by an older build are still alive, which
        // is the same migration the story read rule and the views rule carry.
        allow create: if signedIn()
          && request.auth.uid == viewerUid
          && storyData().get('oneTime', false) == true
          && (audienceToken(request.auth.uid) in storyData().recipientUids
              || request.auth.uid in storyData().recipientUids)
          && request.resource.data.keys().hasOnly(['at']);
      }
    }
  }
}


