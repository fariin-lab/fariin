rules_version = '2';

// Fariin Storage security rules. Signed-in users only; size capped; create-only.
//
// ⚠️ THIS FILE WAS NOT IN THE REPO UNTIL 2026-08-09, and that is exactly how a rule that blocks
// every video story survived unnoticed: the only copy lived in the Firebase console, so nothing
// about it was ever read in a diff, a review or a build. It is tracked now. Deploy with
//     firebase deploy --only storage --project kulan-2ef85
// and NEVER a bare `firebase deploy` (see the functions note in the backend memory).
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos: profiles/{uid}.jpg
    match /profiles/{file} {
      // ⛔ WHO CAN SEE MY PROFILE PHOTO IS DECIDED HERE — owner, 2026-09-25: "when I set my profile
      // photo as No One, it still shows in the chat list … make the proper way". Until today every
      // signed-in account could read every photo, and the setting was honoured by one screen only.
      //
      // Now the owner's own setting decides, read from their user record on every fetch:
      //   · the owner always;
      //   · nobody on the owner's Hide From list (`users/{owner}/photoHiddenFrom/{viewer}`), whatever
      //     the setting says;
      //   · "everyone" → any signed-in account;
      //   · "contacts" ("My Chats") → someone with a 1:1 chat with the owner that is accepted, or that
      //     the owner started. A stranger's unanswered request does not count;
      //   · "nobody" → nobody else.
      // Group photos (`group_<cid>.jpg`) are not a person's photo and keep the plain signed-in rule.
      //
      // ⚠️ THIS ONLY MEANS SOMETHING BECAUSE THE APP NO LONGER PUBLISHES DOWNLOAD LINKS. A Firebase
      // download URL carries a token that skips these rules entirely. Profile photos are now named
      // `fariin-photo://profiles/<file>?v=…` and fetched with the signed-in Storage SDK (see
      // `ProfilePhotoURLProtocol`), and the old tokens were revoked by the one-time migration.
      allow read: if request.auth != null
        && (file.matches('group_.*') || canSeePhoto(file.split('[-.]')[0]));
      // ⚠️ `file == uid + '.jpg'` ON THE WRITE, and it was missing. The DELETE rule below has always
      // had it; the write rule checked only that you were signed in, the file was under 8 MB, and it
      // was an image. Nothing tied the file to the person uploading it.
      //
      // So anybody with an account could write to profiles/<somebody-else's-uid>.jpg and replace
      // that person's photo with anything they liked. Their picture, on their profile, in every
      // chat list they appear in, changed by a stranger. Pure harassment, and the kind of thing an
      // app gets pulled from the App Store over.
      //
      // The identical check sitting one line below on delete is what makes this an oversight rather
      // than a decision: the rule was understood, written down, and applied to the wrong verb.
      //
      // ⚠️ AND THERE ARE TWO FILES PER PERSON, NOT ONE. A profile photo is cropped twice: the
      // circle every list shows (`<uid>.jpg`) and the tall poster the profile header bleeds to the
      // screen edges (`<uid>-poster.jpg`). The ownership check above was written when there was only
      // the circle, so the poster upload was refused outright and the whole save failed with
      // "User does not have permission to access .../profiles/<uid>-poster.jpg" — nobody could
      // change their picture at all (owner 2026-08-19). The fix keeps the ownership rule exactly as
      // strict; it just knows about the second name.
      allow write: if request.auth != null
        && (file == request.auth.uid + '.jpg' || file == request.auth.uid + '-poster.jpg'
            // 2026-09-24 fix-all: A GROUP'S PHOTO, `group_<cid>.jpg` (ChatService.uploadGroupAvatar).
            // Nothing matched it, so every group photo upload was refused and swallowed by the app's
            // `try?`. Allowed for the people the Firestore rule lets set `avatarUrl`: an admin, or
            // any member while "members can edit info" is on. Same firestore.get() the chat-media
            // membership check below uses; the group doc always exists before its photo is set.
            || groupPhotoEditor(file))
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // You may delete your OWN profile photos (both crops) — used on account deletion.
      allow delete: if request.auth != null
        && (file == request.auth.uid + '.jpg' || file == request.auth.uid + '-poster.jpg');
    }

    // Chat media: chat/{cid}/{messageId}.enc — END-TO-END ENCRYPTED, so it uploads
    // as application/octet-stream (NOT an image). Don't require an image content
    // type (that was rejecting every encrypted photo + voice note); just auth + size.
    match /chat/{cid}/{file} {
      allow read: if request.auth != null;

      // ⚠️ THIS RULE USED TO CHECK ONE THING: are you signed in. Nothing else. Not whether you are
      // in that chat, not whether the file already existed, not what kind of file it was.
      //
      // Two separate abuses fell out of that:
      //
      //   · OVERWRITING. Without `resource == null` anybody could write over anyone else's photos
      //     and voice notes. The bytes are end-to-end encrypted, so the owner would not see a
      //     replacement, they would see their own media simply stop working, with nothing anywhere
      //     explaining why. Destruction that looks like a bug.
      //   · A FREE FILE HOST. `{cid}` and `{file}` are wildcards, so a script could invent paths and
      //     push 25 MB at a time, forever, into storage that you pay for. It never has to install
      //     Fariin to do it — nothing yet proves a request came from the real app.
      //
      // `resource == null` is the create-only fix and it is the same shape the story and
      // announcement rules below already use. Those two were hardened at some point and this one was
      // never brought along.
      //
      // (Superseded 2026-09-24: membership IS checked on write now, see `chatMember` below. The
      // history is kept because the warning about firestore.get() still applies to groups.)
      // ⚠️ MEMBERSHIP WAS NOT CHECKED, and I was not guessing at it. The correct rule reads the
      // conversation out of Firestore and requires request.auth.uid to be in its `users`. The story
      // rule above carries a warning that firestore.get() "is unreliable in this project's Storage
      // rules and was denying every legitimate upload" — that was a story doc which does not exist
      // yet at upload time, which is a different situation from a conversation that already does.
      // Different enough that it should work, not different enough to ship on a hunch: getting it
      // wrong breaks every photo, video and voice note in the app. It needs the Storage emulator
      // first. Until then create-only stands, which stops the vandalism but not the free storage.
      // ⛔ 64 MB, UP FROM 25 (owner, 2026-08-25: long videos arrive as mush). 25 MB was not a
      // storage rule so much as a quality rule: the exporter was told to make EVERY clip fit inside
      // it, so a ten minute video was crushed to about 300 kbps. The client now targets a bitrate
      // instead of a flat size (see `VideoTranscoder.prepare`), and it needs somewhere to put a long
      // clip that is compressed sensibly rather than destroyed.
      //
      // ⚠️ AND IT RAISES WHAT AN ABUSER CAN PUSH PER REQUEST BY THE SAME TWO AND A HALF TIMES. The warning
      // directly above still stands: this path does not check conversation membership, so the only
      // things holding it are `resource == null` and this number. Whoever adds the membership check
      // makes this cheaper; until then, do not raise it again.
      //
      // MEMBERSHIP, 2026-09-24. Two halves, because the two kinds of chat differ in the one way that
      // matters here:
      //   · A 1:1 chat's id IS its members, "<uidA>_<uidB>". The check reads the path and nothing
      //     else, so the first photo to a brand-new contact cannot be refused: the client starts
      //     that upload BEFORE the conversation doc is written (ChatService's `ensureConv` runs
      //     alongside it), and a Firestore lookup at that moment would find no doc.
      //   · A group id has no '_' and its doc exists from the moment the group is made, before any
      //     message can be sent, so the lookup always has something to read.
      // ⚠️ The group half depends on firestore.get() working from Storage rules in this project (the
      // warning above). Emulator or one real group photo right after deploying, before trusting it.
      allow write: if request.auth != null
        && request.resource.size < 64 * 1024 * 1024
        && (resource == null || sameBytesRetry())   // 2026-09-24 fix-all: a lost-answer retry
        && chatMember(cid);

      // ⛔ DELETE FOR EVERYONE NEVER DELETED THE MEDIA (audit, 2026-09-24). There was no delete
      // clause here at all, so the client's cleanup after "delete for everyone" was refused every
      // time and swallowed by its `try?`: every deleted photo, video, voice note and file stayed in
      // the bucket for good. Expiry and one-time voice are cleaned server-side and never needed this.
      //
      // Only the AUTHOR, and only once the message is already a tombstone. Every object on this path
      // is named after its message: `<messageId>.enc`, `.mp4.enc`, `.thumb.enc`, `-<n>.enc`, `-lp.enc`
      // and so on, and a message id is a Firestore auto-id, which never contains '.' or '-'. So the
      // part before the first '.' or '-' is the message, and the rule reads it. The client deletes
      // Storage AFTER writing `deleted: true` (ChatService.deleteMessage), so the doc is there, still
      // carrying `authorId`, when this runs.
      //
      // ⚠️ firestore.get() — see the warning above about it in this project's Storage rules. Here the
      // doc always exists at call time (the story failure was a doc that did not exist yet), and a
      // refusal costs only what it costs today: the object stays. Nothing that works now can break.
      //
      // 2026-09-24 feature-audit: TWO CASES THIS REFUSED, both silent orphans.
      //   · Removing ONE item from an album edits the message, it does not tombstone it, so
      //     `deleted` stays false and the removed item's file could never go.
      //   · The hard-delete fallback left no doc to read. The client now sweeps Storage BEFORE the
      //     hard delete (ChatService.deleteMessage), while the doc still exists.
      // So the AUTHOR may delete a file of their own message whatever its state. No wider than
      // Firestore already is: the author may hard-delete that message outright at any time, and a
      // file is only ever matched to the message it is named after, in this chat.
      // A group admin holding "Delete messages" may delete the files of a message that is ALREADY
      // a tombstone (the Firestore rule lets them make it one), same right test as `adminCan`.
      allow delete: if request.auth != null
        && (chatMessage(cid, file).data.authorId == request.auth.uid
            || (chatMessage(cid, file).data.get('deleted', false) == true
                && !cid.matches('.*_.*')
                && adminDeletes(groupDoc(cid).data, chatMessage(cid, file).data.authorId)));
    }

    // 2026-09-24 feature-audit: the client's `adminCan(uid, .deleteMessages)`, mirrored in
    // firestore.rules `adminDeletesMessage`. A limited admin may not touch the owner's messages.
    function adminDeletes(g, author) {
      return g.get('type', '') == 'group'
        && (request.auth.uid == g.get('createdBy', '')
            || (request.auth.uid in g.get('admins', [])
                && author != g.get('createdBy', '')
                && (!(request.auth.uid in g.get('adminRights', {}))
                    || 'deleteMessages' in g.get('adminRights', {})[request.auth.uid])));
    }

    // 2026-09-24 fix-all: the caller may set this group's photo. `file` is `group_<cid>.jpg`, and a
    // group id is a Firestore auto-id (letters and digits only).
    function groupPhotoEditor(file) {
      return file.matches('group_[A-Za-z0-9]{1,64}[.]jpg')
        && (request.auth.uid in groupDoc(file.split('[_.]')[1]).data.get('admins', [])
            || (groupDoc(file.split('[_.]')[1]).data.get('membersCanEditInfo', false) == true
                && request.auth.uid in groupDoc(file.split('[_.]')[1]).data.get('users', [])));
    }

    function groupDoc(cid) {
      return firestore.get(/databases/(default)/documents/conversations/$(cid));
    }

    // Profile photo privacy — see the note on `match /profiles`. `owner` is the uid the file is
    // named after. A 1:1 chat's id is the two uids sorted and joined with "_", as the app builds it.
    function canSeePhoto(owner) {
      return request.auth.uid == owner
        || (!firestore.exists(/databases/(default)/documents/users/$(owner)/photoHiddenFrom/$(request.auth.uid))
            && photoAudienceAllows(owner,
                 firestore.get(/databases/(default)/documents/users/$(owner)).data.get('privacy', {}).get('photo', 'everyone')));
    }

    function photoAudienceAllows(owner, audience) {
      return audience == 'everyone'
        || (audience == 'contacts' && sharesAcceptedChat(owner));
    }

    function sharesAcceptedChat(owner) {
      let cid = owner < request.auth.uid ? owner + '_' + request.auth.uid : request.auth.uid + '_' + owner;
      let path = /databases/(default)/documents/conversations/$(cid);
      return firestore.exists(path)
        && (firestore.get(path).data.get('accepted', true) == true
            || firestore.get(path).data.get('startedBy', owner) == owner);
    }

    // 2026-09-24 fix-all: A RETRIED UPLOAD OF THE SAME BYTES. The media paths are create-only
    // (`resource == null`), so an upload that landed but whose answer was lost was refused when the
    // app sent it again. Writing identical bytes over an object is no vandalism (nothing changes),
    // so the same size and checksum pass.
    function sameBytesRetry() {
      return resource != null
        && request.resource.size == resource.size
        && request.resource.md5Hash == resource.md5Hash;
    }

    function chatMember(cid) {
      return (cid.matches('.*_.*') && request.auth.uid in cid.split('_'))
        || (!cid.matches('.*_.*')
            && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(cid)).data.users);
    }

    function chatMessage(cid, file) {
      return firestore.get(/databases/(default)/documents/conversations/$(cid)/messages/$(file.split('[.-]')[0]));
    }

    // Story media at stories/{storyId}/{file} — PLAIN (v1, not E2EE).
    //
    // A photo story writes ONE object:   photo.jpg  (image/jpeg)
    // A video story writes TWO:          video.mp4  (video/mp4) + thumb.jpg (image/jpeg)
    //
    // ⚠️ EVERY VIDEO STORY WAS BEING REFUSED HERE, AND HAD BEEN SINCE THIS RULE WAS HARDENED.
    // His 2026-08-09 report: "Couldn't post story — User does not have permission to access
    // gs://…/stories/<uuid>/…". Not a size problem, not intermittent, not his account: the write
    // rule ended in
    //     && request.resource.contentType.matches('image/.*')
    //     && file == 'photo.jpg';
    // so `video.mp4` failed BOTH clauses and `thumb.jpg` — an image, and half of every video post —
    // failed the filename. Only a photo story could ever get through.
    //
    // The tell is in this rule's own history: the size cap was raised to 25 MB with a comment
    // reasoning about "90 seconds at 540p is roughly 17 MB", so video was plainly meant to be
    // allowed. The two hardening clauses were added for good reasons (no arbitrary file host, no
    // arbitrary sub-paths) and silently contradicted it. A rule and its comment disagreed, and
    // because this file lived only in the console, nothing ever put the two side by side.
    //
    // The fix keeps every protection and states the three legal objects explicitly: each filename
    // is paired with the content type it must carry, so the path is still not a file host and
    // `video.mp4` cannot be used to smuggle something that is not a video.
    match /stories/{storyId}/{file} {
      // Read = auth only. (An author is NOT in their own recipientUids, so an audience check
      // here would deny the author's own getDownloadURL — that was the real cause of the old
      // "permission denied on every post", not firestore.get being broken.) Audience is enforced
      // in Firestore (recipientUids); the tokenized URL is only handed to recipients.
      allow read: if request.auth != null;
      // CREATE-ONLY write: `resource == null` means the object doesn't exist yet, so the author's
      // first upload to a fresh {storyId} path succeeds, but NOBODY can overwrite an existing story
      // object (the vandalism hole). No firestore.get() — that lookup is unreliable in this
      // project's Storage rules and was denying every legitimate upload.
      //
      // 25 MB: a story video may be 90 seconds, and 90 seconds at the 540p we export to is roughly
      // 17 MB. Matches the chat limit, which is the same kind of media.
      allow write: if request.auth != null
        && (resource == null || sameBytesRetry())   // 2026-09-24 fix-all: a lost-answer retry
        && request.resource.size < 25 * 1024 * 1024
        && (
             (file == 'photo.jpg' && request.resource.contentType.matches('image/.*'))
          || (file == 'thumb.jpg' && request.resource.contentType.matches('image/.*'))
          || (file == 'video.mp4' && request.resource.contentType.matches('video/.*'))
        );
      // Deletes happen server-side only: the onStoryDeleted Cloud Function (admin SDK, bypasses
      // rules) removes the media when the story doc is deleted. Blocking client deletes closes the
      // "any user can delete anyone's media" hole; the client's own delete call fails harmlessly.
      allow delete: if false;
    }

    // Official channel pictures at announcements/{announcementId}/image.jpg — PLAIN, like story
    // photos. A broadcast to everybody cannot be a secret, so sealing it would be a costume: every
    // phone would hold the key.
    match /announcements/{announcementId}/{file} {
      allow read: if request.auth != null;
      // Same shape as the story rule above, and for the same reason: a firestore.get() here is
      // unreliable in this project's Storage rules and denies legitimate uploads, so the real gate is
      // in Firestore. Anybody can put bytes at this path; only an admin can ever publish an
      // announcement that POINTS at them, and an unreferenced object is never fetched by anything.
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && (resource == null || sameBytesRetry())              // create-only: no overwriting a live announcement's picture
                                                               // (2026-09-24 fix-all: except a same-bytes retry)
        && request.resource.contentType.matches('image/.*')    // images only — not an arbitrary file host
        // 2026-09-24 decision D-admin-media: one new file per upload (image-<32 hex>.jpg) so a picture
        // edit never replaces what a live announcement shows. Still one flat, named file per upload.
        && file.matches('image(-[a-f0-9]{32})?[.]jpg');        // no arbitrary sub-paths
      allow delete: if false;
    }
  }
}
